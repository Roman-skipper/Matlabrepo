clear; close all; clc

%% Datei und FFT
M = readmatrix('auf1.csv','NumHeaderLines',1);
y = M(:,1);
y = y(isfinite(y));

fs = 100000;
N = length(y);
Y = fft(y-mean(y));

% Nur Frequenzen bis 20 Hz
k = 2:floor(20*N/fs)+1;
f = ((k-1)*fs/N)';
A = 2*abs(Y(k))/N;
A = A(:);
A = A/max(A);

phi = rad2deg(angle(Y(k)));
phi = phi(:);

%% Blockpeak, 4,6 Hz und Oberwellen suchen
fZiel = [1/60 4.6 9.2 13.8 18.4];
suchbreite = [0.006 0.5 0.5 0.5 0.5];
peak = zeros(size(fZiel));

for n = 1:length(fZiel)
    bereich = abs(f-fZiel(n)) < suchbreite(n);
    stellen = find(bereich);
    [~,p] = max(A(bereich));
    peak(n) = stellen(p);
end

%% Farben aus dem großen Code
blau   = [0.10 0.36 0.63];
orange = [0.86 0.40 0.15];
grau   = [0.55 0.58 0.62];

%% Gemeinsame Paper-Abbildung
fig = figure('Color','w','Position',[80 80 1100 720]);
tl = tiledlayout(2,1,'TileSpacing','compact','Padding','compact');

% Amplitudenspektrum
ax1 = nexttile;
semilogx(f,A,'Color',blau,'LineWidth',1.4);
hold on
plot(f(peak),A(peak),'o','Color',orange, ...
    'MarkerFaceColor',orange,'MarkerSize',7);

xline(1/60,':','Blockrhythmus','Color',grau);
xline(4.6,':','4,6 Hz','Color',grau);

xlim([0.008 20])
ylabel('Relative Amplitude')
title('Amplitudenspektrum')
grid on
box off

% Phase nur an den FFT-Peaks
ax2 = nexttile;
stem(f(peak),phi(peak),'filled', ...
    'Color',blau,'MarkerFaceColor',orange,'LineWidth',1.4);

set(ax2,'XScale','log')
yline(0,':','Color',grau);
xlim([0.008 20])
ylim([-180 180])
yticks(-180:90:180)
xticks(f(peak))
xticklabels(compose('%.4g',f(peak)))

xlabel('Frequenz [Hz]')
ylabel('Phase [°]')
title('Phase an den dominanten FFT-Peaks')
grid on
box off

%% Gemeinsames Design
title(tl,'FFT und Phasenspektrum der SEP-Aufnahme','FontSize',18)
subtitle(tl,'Aufnahme auf1.csv | Phase relativ zum ersten gespeicherten Sample')

set([ax1 ax2],'FontName','Arial','FontSize',11, ...
    'LineWidth',0.8,'GridAlpha',0.12, ...
    'TickDir','out','Color',[0.985 0.989 0.994]);

%% Als Paper-Bild speichern
exportgraphics(fig,'FFT_Phase_auf1.png','Resolution',300);
savefig(fig,'FFT_Phase_auf1.fig');
