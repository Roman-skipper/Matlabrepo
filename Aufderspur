clear;
clc;
close all;

%% =========================================================
% 1. EINSTELLUNGEN
% ==========================================================

% Die CSV-Dateien müssen im gleichen Ordner wie das Skript liegen
dateien = [
    "normal0.csv"
    "frequenz0.csv"
    "mittlung0.csv"
    "sweep0.csv"
    "pause0.csv"
];

namen = [
    "Referenz"
    "Frequenz 4,6 Hz"
    "141 Mittelungen"
    "Sweep 40 ms"
    "Pause 10 s"
];

% Eingestellte Sollwerte
sollFrequenz = [4.7; 4.6; 4.7; 4.7; 4.7];
sollImpulse  = [137; 137; 141; 137; 137];

% Ändern, falls der normale Sweep nicht 80 ms betrug
sollSweep_ms = [80; 80; 80; 40; 80];

sollPause_s = [30; 30; 30; 30; 10];

anzahlMessungen = 5;
anzahlBloecke = 9;

% Einstellungen für die Impulserkennung
schwelle = 5;
mindestAbstand = 0.15;
blockTrennung = 5;

%% =========================================================
% 2. SPEICHER FÜR DIE ERGEBNISSE
% ==========================================================

mittelImpulse = zeros(anzahlMessungen,1);
mittelFrequenz = zeros(anzahlMessungen,1);
fftFrequenz = zeros(anzahlMessungen,1);
mittelStimDauer = zeros(anzahlMessungen,1);
mittelZyklus = zeros(anzahlMessungen,1);

abwImpulse = zeros(anzahlMessungen,1);
abwFrequenz = zeros(anzahlMessungen,1);
abwStimDauer = zeros(anzahlMessungen,1);
abwZyklus = zeros(anzahlMessungen,1);
gesamtAbweichung = zeros(anzahlMessungen,1);

messStarts = cell(anzahlMessungen,1);
idealStarts = cell(anzahlMessungen,1);

%% =========================================================
% 3. ALLE FÜNF MESSUNGEN AUSWERTEN
% ==========================================================

for m = 1:anzahlMessungen

    fprintf('\n========================================\n');
    fprintf('Auswertung: %s\n',namen(m));
    fprintf('Datei: %s\n',dateien(m));
    fprintf('========================================\n');

    if ~isfile(dateien(m))
        error('Die Datei %s wurde nicht gefunden.',dateien(m));
    end

    %% -----------------------------------------------------
    % tInc in den Kopfzeilen suchen
    % ------------------------------------------------------

    fid = fopen(dateien(m),'r');

    if fid == -1
        error('Die Datei %s konnte nicht geöffnet werden.',dateien(m));
    end

    TInc = NaN;

    % Die ersten 150 Zeilen durchsuchen
    for zeile = 1:150

        textZeile = fgetl(fid);

        if ~ischar(textZeile)
            break;
        end

        % Erkennt tInc, TInc, T Inc und t inc
        if ~isempty(regexpi(textZeile,'t\s*inc','once'))

            gefundeneZahlen = regexp( ...
                textZeile, ...
                '[+-]?\d*\.?\d+(?:[Ee][+-]?\d+)?', ...
                'match');

            if ~isempty(gefundeneZahlen)
                TInc = str2double(gefundeneZahlen{end});
            end
        end
    end

    fclose(fid);

    %% -----------------------------------------------------
    % Zahlen aus der CSV laden
    % ------------------------------------------------------

    daten = readmatrix(dateien(m));

    % Prüfen, ob eine echte zweite Spalte vorhanden ist
    zweiteSpalteVorhanden = ...
        size(daten,2) >= 2 && ...
        sum(isfinite(daten(:,2))) > 100;

    if zweiteSpalteVorhanden

        % Normale Display-CSV:
        % Spalte 1 = Zeit
        % Spalte 2 = Spannung
        t = daten(:,1);
        u = daten(:,2);

        gueltig = isfinite(t) & isfinite(u);
        t = t(gueltig);
        u = u(gueltig);

        fprintf('Format: Display-CSV mit Zeitspalte\n');

    else

        % Memory-CSV:
        % Spalte 1 = Spannung
        u = daten(:,1);
        u = u(isfinite(u));

        if isnan(TInc)
            error('tInc wurde in %s nicht gefunden.',dateien(m));
        end

        % Zeitachse aus tInc erzeugen
        t = (0:length(u)-1)'*TInc;

        fprintf('Format: Memory-CSV\n');
        fprintf('tInc: %.10g s\n',TInc);
        fprintf('Messwerte: %d\n',length(u));
    end

    % Daten zeitlich sortieren
    [t,reihenfolge] = sort(t);
    u = u(reihenfolge);

    fprintf('Errechnete Aufnahmedauer: %.3f s\n',t(end)-t(1));

    %% -----------------------------------------------------
    % Impulse erkennen
    % ------------------------------------------------------

    % Übergang von unter 5 V auf über 5 V
    idx = find( ...
        u(1:end-1) <= schwelle & ...
        u(2:end) > schwelle) + 1;

    pulseRoh = t(idx);

    if isempty(pulseRoh)
        error('In %s wurden keine Impulse über 5 V erkannt.',dateien(m));
    end

    % Mögliche Doppelzählungen entfernen
    pulse = pulseRoh(1);

    for k = 2:length(pulseRoh)

        if pulseRoh(k)-pulse(end) >= mindestAbstand
            pulse(end+1,1) = pulseRoh(k);
        end
    end

    pulse = pulse(:);

    fprintf('Insgesamt erkannte Impulse: %d\n',length(pulse));

    %% -----------------------------------------------------
    % Impulse in Blöcke aufteilen
    % ------------------------------------------------------

    neuerBlock = [true; diff(pulse) > blockTrennung];
    blockNummer = cumsum(neuerBlock);
    blockGroesse = accumarray(blockNummer,1);

    % Block muss mindestens 60 % der erwarteten Impulse besitzen
    minimumImpulse = round(0.6*sollImpulse(m));

    echteBloecke = find(blockGroesse >= minimumImpulse);

    fprintf('Erkannte vollständige Blöcke: %d\n',length(echteBloecke));
    fprintf('Impulse in diesen Blöcken:\n');
    disp(blockGroesse(echteBloecke)');

    if length(echteBloecke) < anzahlBloecke
        error('%s enthält nur %d vollständige Blöcke.', ...
              dateien(m),length(echteBloecke));
    end

    % Nur die ersten neun vollständigen Blöcke
    echteBloecke = echteBloecke(1:anzahlBloecke);

    %% -----------------------------------------------------
    % Kennwerte für jeden Block berechnen
    % ------------------------------------------------------

    impulseProBlock = zeros(anzahlBloecke,1);
    frequenzProBlock = zeros(anzahlBloecke,1);
    stimDauerProBlock = zeros(anzahlBloecke,1);
    blockStart = zeros(anzahlBloecke,1);

    pulseDerBloecke = cell(anzahlBloecke,1);

    for b = 1:anzahlBloecke

        p = pulse(blockNummer == echteBloecke(b));
        pulseDerBloecke{b} = p;

        impulseProBlock(b) = length(p);
        blockStart(b) = p(1);

        impulsAbstaende = diff(p);

        % Frequenz aus dem typischen Impulsabstand
        frequenzProBlock(b) = 1/median(impulsAbstaende);

        % Dauer vom ersten bis zum letzten Impuls
        stimDauerProBlock(b) = p(end)-p(1);
    end

    % Ersten Block auf Zeit 0 setzen
    blockStart = blockStart-blockStart(1);

    % Zeit zwischen zwei Blockstarts
    zyklusProBlock = diff(blockStart);

    %% -----------------------------------------------------
    % Ideales Szenario dieser Messung
    % ------------------------------------------------------

    % Dauer vom ersten bis zum letzten Impuls
    idealeStimDauer = ...
        (sollImpulse(m)-1)/sollFrequenz(m);

    % Ideale Zeit von einem Blockstart zum nächsten
    idealerZyklus = ...
        idealeStimDauer + ...
        sollSweep_ms(m)/1000 + ...
        sollPause_s(m);

    idealStart = (0:anzahlBloecke-1)'*idealerZyklus;

    messStarts{m} = blockStart;
    idealStarts{m} = idealStart;

    %% -----------------------------------------------------
    % Mittelwerte
    % ------------------------------------------------------

    mittelImpulse(m) = mean(impulseProBlock);
    mittelFrequenz(m) = mean(frequenzProBlock);
    mittelStimDauer(m) = mean(stimDauerProBlock);
    mittelZyklus(m) = mean(zyklusProBlock);

    %% -----------------------------------------------------
    % Fourier-Transformation der Einzelimpulse
    % ------------------------------------------------------

    FsFFT = 100;
    fftFenster = 35;
    N = round(FsFFT*fftFenster);
    NFFT = 2^16;

    spektrumSumme = zeros(NFFT,1);

    for b = 1:anzahlBloecke

        p = pulseDerBloecke{b};

        % Erster Impuls wird auf t = 0 gesetzt
        pRelativ = p-p(1);

        impulsSignal = zeros(N,1);

        positionen = round(pRelativ*FsFFT)+1;
        positionen = positionen( ...
            positionen >= 1 & positionen <= N);

        impulsSignal(positionen) = 1;

        spektrum = abs(fft(impulsSignal,NFFT));
        spektrumSumme = spektrumSumme+spektrum;
    end

    mittleresSpektrum = spektrumSumme/anzahlBloecke;
    frequenzAchse = (0:NFFT-1)'*(FsFFT/NFFT);

    % Frequenz nur zwischen 4 und 5,2 Hz suchen
    suchBereich = ...
        frequenzAchse >= 4 & ...
        frequenzAchse <= 5.2;

    fSuche = frequenzAchse(suchBereich);
    ySuche = mittleresSpektrum(suchBereich);

    [~,peakPosition] = max(ySuche);
    fftFrequenz(m) = fSuche(peakPosition);

    %% -----------------------------------------------------
    % Relative Abweichungen
    % ------------------------------------------------------

    abwImpulse(m) = ...
        abs(mittelImpulse(m)-sollImpulse(m)) ...
        /sollImpulse(m)*100;

    abwFrequenz(m) = ...
        abs(mittelFrequenz(m)-sollFrequenz(m)) ...
        /sollFrequenz(m)*100;

    abwStimDauer(m) = ...
        abs(mittelStimDauer(m)-idealeStimDauer) ...
        /idealeStimDauer*100;

    abwZyklus(m) = ...
        abs(mittelZyklus(m)-idealerZyklus) ...
        /idealerZyklus*100;

    % Durchschnitt der vier Teilabweichungen
    gesamtAbweichung(m) = mean([
        abwImpulse(m)
        abwFrequenz(m)
        abwStimDauer(m)
        abwZyklus(m)
    ]);

end

%% =========================================================
% 4. ERGEBNISTABELLE
% ==========================================================

Ergebnisse = table( ...
    namen, ...
    sollImpulse, ...
    mittelImpulse, ...
    sollFrequenz, ...
    mittelFrequenz, ...
    fftFrequenz, ...
    mittelStimDauer, ...
    mittelZyklus, ...
    abwImpulse, ...
    abwFrequenz, ...
    abwStimDauer, ...
    abwZyklus, ...
    gesamtAbweichung, ...
    'VariableNames',{ ...
    'Messung', ...
    'Impulse_Soll', ...
    'Impulse_Gemessen', ...
    'Frequenz_Soll_Hz', ...
    'Frequenz_aus_Zeit_Hz', ...
    'Frequenz_FFT_Hz', ...
    'Stimulationsdauer_s', ...
    'Zyklusdauer_s', ...
    'Abweichung_Impulse_Prozent', ...
    'Abweichung_Frequenz_Prozent', ...
    'Abweichung_Stimdauer_Prozent', ...
    'Abweichung_Zyklus_Prozent', ...
    'Gesamtabweichung_Prozent'});

disp(Ergebnisse);

%% =========================================================
% 5. FÜNF GRAPHEN:
% JEDE MESSUNG GEGEN IHR EIGENES IDEAL
% ==========================================================

figure( ...
    'Name','Messung gegen jeweiliges Ideal', ...
    'Position',[100 50 1200 850]);

tiledlayout(3,2);

for m = 1:anzahlMessungen

    nexttile;

    % Positiv = gemessener Block beginnt zu spät
    % Negativ = gemessener Block beginnt zu früh
    differenz = messStarts{m}-idealStarts{m};

    plot( ...
        1:anzahlBloecke, ...
        differenz, ...
        'o-', ...
        'LineWidth',2, ...
        'MarkerFaceColor',[0.2 0.5 0.9]);

    hold on;

    yline(0,'k--','Idealer Start');

    hold off;

    xlabel('Block');
    ylabel('Messung - Ideal [s]');
    title(namen(m));

    xticks(1:anzahlBloecke);
    grid on;
end

%% =========================================================
% 6. ALLE RELATIVEN ABWEICHUNGEN VERGLEICHEN
% ==========================================================

teilAbweichungen = [
    abwImpulse ...
    abwFrequenz ...
    abwStimDauer ...
    abwZyklus
];

figure( ...
    'Name','Relative Abweichungen', ...
    'Position',[100 100 1200 650]);

bar(teilAbweichungen,'grouped');

hold on;

% Schwarzer Punkt = mittlere Gesamtabweichung
plot( ...
    1:anzahlMessungen, ...
    gesamtAbweichung, ...
    'ko', ...
    'MarkerFaceColor','k', ...
    'MarkerSize',9);

hold off;

xticks(1:anzahlMessungen);
xticklabels(namen);
xtickangle(20);

ylabel('Relative Abweichung vom eigenen Ideal [%]');
title('Welche Messung weicht am stärksten ab?');

legend( ...
    'Impulszahl', ...
    'Frequenz', ...
    'Stimulationsdauer', ...
    'Zyklusdauer', ...
    'Gesamtabweichung', ...
    'Location','best');

grid on;

%% =========================================================
% 7. GRÖSSTE ABWEICHUNG AUSGEBEN
% ==========================================================

[groessteAbweichung,position] = max(gesamtAbweichung);

fprintf('\n========================================\n');
fprintf('GRÖSSTE RELATIVE GESAMTABWEICHUNG\n');
fprintf('========================================\n');

fprintf('Messung: %s\n',namen(position));
fprintf('Gesamtabweichung: %.2f %%\n',groessteAbweichung);

fprintf('\nTeilabweichungen:\n');
fprintf('Impulszahl:        %.2f %%\n',abwImpulse(position));
fprintf('Frequenz:          %.2f %%\n',abwFrequenz(position));
fprintf('Stimulationsdauer: %.2f %%\n',abwStimDauer(position));
fprintf('Zyklusdauer:       %.2f %%\n',abwZyklus(position));

fprintf('\n========================================\n');
fprintf('FREQUENZEN AUS DER FFT\n');
fprintf('========================================\n');

for m = 1:anzahlMessungen
    fprintf('%s: %.4f Hz\n',namen(m),fftFrequenz(m));
end
