clear;
clc;
close all;

%% =========================================================
% 1. EINSTELLUNGEN
% ==========================================================

dateien = [
    "normal0.csv"
    "frequenz0.csv"
    "mittlung0.csv"
    "sweep0.csv"
    "pause0.csv"
];

namen = [
    "Referenz"
    "Frequenz 4,6 Hz"
    "141 Mittelungen"
    "Sweep 40 ms"
    "Pause 10 s"
];

% Eingestellte Werte
sollFrequenz = [4.7; 4.6; 4.7; 4.7; 4.7];
sollImpulse  = [137; 137; 141; 137; 137];

% Annahme: normaler Sweep = 80 ms
sollSweep_ms = [80; 80; 80; 40; 80];

sollPause_s = [30; 30; 30; 30; 10];

anzahlMessungen = 5;
anzahlBloecke = 9;

% Einstellungen für die Erkennung
schwelle = 5;
mindestAbstand = 0.15;
blockTrennung = 5;

%% =========================================================
% 2. ERGEBNISSE VORBEREITEN
% ==========================================================

mittelImpulse = zeros(anzahlMessungen,1);
mittelFrequenz = zeros(anzahlMessungen,1);
fftFrequenz = zeros(anzahlMessungen,1);
mittelStimDauer = zeros(anzahlMessungen,1);
mittelZyklus = zeros(anzahlMessungen,1);

abwImpulse = zeros(anzahlMessungen,1);
abwFrequenz = zeros(anzahlMessungen,1);
abwStimDauer = zeros(anzahlMessungen,1);
abwZyklus = zeros(anzahlMessungen,1);
gesamtAbweichung = zeros(anzahlMessungen,1);

messStarts = cell(anzahlMessungen,1);
idealStarts = cell(anzahlMessungen,1);
blockImpulse = cell(anzahlMessungen,1);

%% =========================================================
% 3. FÜNF DATEIEN NACHEINANDER AUSWERTEN
% ==========================================================

for m = 1:anzahlMessungen

    aktuellerName = char(namen(m));
    aktuelleDatei = char(dateien(m));

    fprintf('\n========================================\n');
    fprintf('Messung: %s\n',aktuellerName);
    fprintf('Datei: %s\n',aktuelleDatei);
    fprintf('========================================\n');

    %% Prüfen, ob die Datei existiert

    if ~isfile(aktuelleDatei)
        error('Die Datei %s wurde nicht gefunden.',aktuelleDatei);
    end

    %% -----------------------------------------------------
    % Erste Zeile der Rigol-Datei lesen
    % ------------------------------------------------------

    fid = fopen(aktuelleDatei,'r');

    if fid == -1
        error('Die Datei %s konnte nicht geöffnet werden.', ...
              aktuelleDatei);
    end

    kopfzeile = fgetl(fid);
    fclose(fid);

    if ~ischar(kopfzeile)
        error('Die Datei %s ist leer.',aktuelleDatei);
    end

    fprintf('Kopfzeile: %s\n',kopfzeile);

    %% -----------------------------------------------------
    % t0 aus der Kopfzeile lesen
    % Beispiel: t0 = -123s
    % ------------------------------------------------------

    t0Treffer = regexpi( ...
        kopfzeile, ...
        't0\s*=\s*([+-]?\d*\.?\d+(?:[eE][+-]?\d+)?)\s*s', ...
        'tokens', ...
        'once');

    if isempty(t0Treffer)
        error('t0 wurde in %s nicht gefunden.',aktuelleDatei);
    end

    t0 = str2double(t0Treffer{1});

    %% -----------------------------------------------------
    % tInc aus der Kopfzeile lesen
    % Beispiel: tInc = 1e-05s
    % ------------------------------------------------------

    tIncTreffer = regexpi( ...
        kopfzeile, ...
        't\s*inc\s*=\s*([+-]?\d*\.?\d+(?:[eE][+-]?\d+)?)\s*s', ...
        'tokens', ...
        'once');

    if isempty(tIncTreffer)
        error('tInc wurde in %s nicht gefunden.',aktuelleDatei);
    end

    tInc = str2double(tIncTreffer{1});

    if ~isfinite(t0)
        error('Der gelesene Wert für t0 ist ungültig.');
    end

    if ~isfinite(tInc) || tInc <= 0
        error('Der gelesene Wert für tInc ist ungültig.');
    end

    fprintf('Erkanntes t0: %.10g s\n',t0);
    fprintf('Erkanntes tInc: %.10g s\n',tInc);

    %% -----------------------------------------------------
    % Spannungswerte ab der zweiten Zeile laden
    % ------------------------------------------------------

    daten = readmatrix( ...
        aktuelleDatei, ...
        'NumHeaderLines',1);

    if isempty(daten)
        error('In %s wurden keine Messwerte gefunden.', ...
              aktuelleDatei);
    end

    % Nur die erste Spalte enthält die Spannung
    u = daten(:,1);

    % Ungültige Werte entfernen
    u = u(isfinite(u));

    if isempty(u)
        error('In %s wurden keine gültigen Spannungen gefunden.', ...
              aktuelleDatei);
    end

    %% Zeitachse aus t0 und tInc erzeugen

    t = t0 + (0:length(u)-1)'*tInc;

    fprintf('Anzahl Messwerte: %d\n',length(u));
    fprintf('Aufnahmedauer: %.3f s\n',t(end)-t(1));
    fprintf('Kleinste Spannung: %.3f V\n',min(u));
    fprintf('Größte Spannung: %.3f V\n',max(u));

    %% -----------------------------------------------------
    % Impulse erkennen
    % ------------------------------------------------------

    idx = find( ...
        u(1:end-1) <= schwelle & ...
        u(2:end) > schwelle) + 1;

    pulseRoh = t(idx);

    if isempty(pulseRoh)
        error([ ...
            'In %s wurden keine Impulse über %.1f V erkannt. ' ...
            'Die höchste Spannung beträgt %.3f V.'], ...
            aktuelleDatei,schwelle,max(u));
    end

    %% Mögliche Doppelzählungen entfernen

    pulse = pulseRoh(1);

    for k = 2:length(pulseRoh)

        if pulseRoh(k)-pulse(end) >= mindestAbstand
            pulse(end+1,1) = pulseRoh(k);
        end
    end

    pulse = pulse(:);

    fprintf('Insgesamt erkannte Impulse: %d\n',length(pulse));

    %% -----------------------------------------------------
    % Impulse in Blöcke einteilen
    % ------------------------------------------------------

    neuerBlock = [true; diff(pulse) > blockTrennung];

    blockNummer = cumsum(neuerBlock);

    blockGroesse = accumarray(blockNummer,1);

    % Ein echter Block muss mindestens 60 Prozent
    % der erwarteten Impulse besitzen
    minimumImpulse = round(0.60*sollImpulse(m));

    echteBloecke = find(blockGroesse >= minimumImpulse);

    fprintf('Erkannte vollständige Blöcke: %d\n', ...
            length(echteBloecke));

    fprintf('Impulse pro vollständigem Block:\n');
    disp(blockGroesse(echteBloecke)');

    if length(echteBloecke) < anzahlBloecke

        error([ ...
            '%s enthält nur %d vollständige Blöcke. ' ...
            'Für die Auswertung werden 9 benötigt.'], ...
            aktuelleDatei,length(echteBloecke));
    end

    % Die ersten neun vollständigen Blöcke verwenden
    echteBloecke = echteBloecke(1:anzahlBloecke);

    %% -----------------------------------------------------
    % Werte für jeden Block bestimmen
    % ------------------------------------------------------

    impulseProBlock = zeros(anzahlBloecke,1);
    frequenzProBlock = zeros(anzahlBloecke,1);
    stimDauerProBlock = zeros(anzahlBloecke,1);
    startProBlock = zeros(anzahlBloecke,1);

    pulseDerBloecke = cell(anzahlBloecke,1);

    for b = 1:anzahlBloecke

        p = pulse(blockNummer == echteBloecke(b));

        pulseDerBloecke{b} = p;

        impulseProBlock(b) = length(p);

        startProBlock(b) = p(1);

        impulsAbstaende = diff(p);

        if isempty(impulsAbstaende)
            error('Block %d enthält zu wenige Impulse.',b);
        end

        % Frequenz aus dem typischen Impulsabstand
        frequenzProBlock(b) = ...
            1/median(impulsAbstaende);

        % Zeit vom ersten bis zum letzten Impuls
        stimDauerProBlock(b) = ...
            p(end)-p(1);
    end

    blockImpulse{m} = impulseProBlock;

    % Ersten Block auf 0 Sekunden setzen
    startProBlock = ...
        startProBlock-startProBlock(1);

    % Zeit zwischen den Blockstarts
    zyklusProBlock = diff(startProBlock);

    %% -----------------------------------------------------
    % Ideales Szenario dieser Messung
    % ------------------------------------------------------

    idealeStimDauer = ...
        (sollImpulse(m)-1)/sollFrequenz(m);

    idealerZyklus = ...
        idealeStimDauer + ...
        sollSweep_ms(m)/1000 + ...
        sollPause_s(m);

    idealStart = ...
        (0:anzahlBloecke-1)'*idealerZyklus;

    messStarts{m} = startProBlock;
    idealStarts{m} = idealStart;

    %% -----------------------------------------------------
    % Mittelwerte
    % ------------------------------------------------------

    mittelImpulse(m) = mean(impulseProBlock);

    mittelFrequenz(m) = mean(frequenzProBlock);

    mittelStimDauer(m) = mean(stimDauerProBlock);

    mittelZyklus(m) = mean(zyklusProBlock);

    %% -----------------------------------------------------
    % Fourier-Transformation
    % ------------------------------------------------------

    FsFFT = 100;
    fftFenster = 35;
    N = round(FsFFT*fftFenster);
    NFFT = 2^16;

    spektrumSumme = zeros(NFFT,1);

    for b = 1:anzahlBloecke

        p = pulseDerBloecke{b};

        % Erster Impuls des Blocks liegt bei 0 Sekunden
        pRelativ = p-p(1);

        impulsSignal = zeros(N,1);

        positionen = round(pRelativ*FsFFT)+1;

        positionen = positionen( ...
            positionen >= 1 & ...
            positionen <= N);

        impulsSignal(positionen) = 1;

        spektrum = abs(fft(impulsSignal,NFFT));

        spektrumSumme = spektrumSumme+spektrum;
    end

    mittleresSpektrum = ...
        spektrumSumme/anzahlBloecke;

    frequenzAchse = ...
        (0:NFFT-1)'*(FsFFT/NFFT);

    suchBereich = ...
        frequenzAchse >= 4 & ...
        frequenzAchse <= 5.2;

    fSuche = frequenzAchse(suchBereich);
    ySuche = mittleresSpektrum(suchBereich);

    [~,peakPosition] = max(ySuche);

    fftFrequenz(m) = fSuche(peakPosition);

    %% -----------------------------------------------------
    % Relative Abweichungen
    % ------------------------------------------------------

    abwImpulse(m) = ...
        abs(mittelImpulse(m)-sollImpulse(m)) ...
        /sollImpulse(m)*100;

    abwFrequenz(m) = ...
        abs(mittelFrequenz(m)-sollFrequenz(m)) ...
        /sollFrequenz(m)*100;

    abwStimDauer(m) = ...
        abs(mittelStimDauer(m)-idealeStimDauer) ...
        /idealeStimDauer*100;

    abwZyklus(m) = ...
        abs(mittelZyklus(m)-idealerZyklus) ...
        /idealerZyklus*100;

    gesamtAbweichung(m) = mean([
        abwImpulse(m)
        abwFrequenz(m)
        abwStimDauer(m)
        abwZyklus(m)
    ]);

    %% Große Messdaten vor der nächsten Datei entfernen

    clear daten t u pulse pulseRoh idx

end

%% =========================================================
% 4. ERGEBNISTABELLE
% ==========================================================

Ergebnisse = table( ...
    namen, ...
    sollImpulse, ...
    mittelImpulse, ...
    sollFrequenz, ...
    mittelFrequenz, ...
    fftFrequenz, ...
    mittelStimDauer, ...
    mittelZyklus, ...
    abwImpulse, ...
    abwFrequenz, ...
    abwStimDauer, ...
    abwZyklus, ...
    gesamtAbweichung, ...
    'VariableNames',{ ...
    'Messung', ...
    'Impulse_Soll', ...
    'Impulse_Gemessen', ...
    'Frequenz_Soll_Hz', ...
    'Frequenz_aus_Zeit_Hz', ...
    'Frequenz_FFT_Hz', ...
    'Stimulationsdauer_s', ...
    'Zyklusdauer_s', ...
    'Abweichung_Impulse_Prozent', ...
    'Abweichung_Frequenz_Prozent', ...
    'Abweichung_Stimdauer_Prozent', ...
    'Abweichung_Zyklus_Prozent', ...
    'Gesamtabweichung_Prozent'});

disp(Ergebnisse);

%% =========================================================
% 5. IMPULSE PRO BLOCK
% ==========================================================

impulsMatrix = [
    blockImpulse{1} ...
    blockImpulse{2} ...
    blockImpulse{3} ...
    blockImpulse{4} ...
    blockImpulse{5}
];

figure( ...
    'Name','Impulse pro Block', ...
    'Position',[100 100 1100 650]);

plot( ...
    1:anzahlBloecke, ...
    impulsMatrix, ...
    'o-', ...
    'LineWidth',1.5);

xlabel('Block');
ylabel('Erkannte Impulse');
title('Tatsächliche Impulszahl pro Block');

legend(namen,'Location','best');

xticks(1:anzahlBloecke);
grid on;

%% =========================================================
% 6. FÜNF MESSUNGEN GEGEN IHR EIGENES IDEAL
% ==========================================================

figure( ...
    'Name','Abweichungen vom jeweiligen Ideal', ...
    'Position',[100 50 1200 850]);

tiledlayout(3,2);

for m = 1:anzahlMessungen

    nexttile;

    differenz = ...
        messStarts{m}-idealStarts{m};

    plot( ...
        1:anzahlBloecke, ...
        differenz, ...
        'o-', ...
        'LineWidth',2, ...
        'MarkerFaceColor',[0.2 0.5 0.9]);

    hold on;

    yline(0,'k--','Ideal');

    hold off;

    xlabel('Block');
    ylabel('Messung - Ideal [s]');
    title(namen(m));

    xticks(1:anzahlBloecke);
    grid on;
end

%% =========================================================
% 7. RELATIVE ABWEICHUNGEN ALLER MESSUNGEN
% ==========================================================

teilAbweichungen = [
    abwImpulse ...
    abwFrequenz ...
    abwStimDauer ...
    abwZyklus
];

figure( ...
    'Name','Relative Abweichungen', ...
    'Position',[100 100 1200 650]);

bar(teilAbweichungen,'grouped');

hold on;

plot( ...
    1:anzahlMessungen, ...
    gesamtAbweichung, ...
    'ko', ...
    'MarkerFaceColor','k', ...
    'MarkerSize',9);

hold off;

xticks(1:anzahlMessungen);
xticklabels(namen);
xtickangle(20);

ylabel('Relative Abweichung vom eigenen Ideal [%]');
title('Welche Messung weicht am stärksten ab?');

legend( ...
    'Impulszahl', ...
    'Frequenz', ...
    'Stimulationsdauer', ...
    'Zyklusdauer', ...
    'Gesamtabweichung', ...
    'Location','best');

grid on;

%% =========================================================
% 8. GRÖSSTE ABWEICHUNG AUSGEBEN
% ==========================================================

[groessteAbweichung,position] = ...
    max(gesamtAbweichung);

fprintf('\n========================================\n');
fprintf('GRÖSSTE RELATIVE GESAMTABWEICHUNG\n');
fprintf('========================================\n');

fprintf('Messung: %s\n',char(namen(position)));
fprintf('Gesamtabweichung: %.2f %%\n', ...
        groessteAbweichung);

fprintf('\nTeilabweichungen:\n');

fprintf('Impulszahl:        %.2f %%\n', ...
        abwImpulse(position));

fprintf('Frequenz:          %.2f %%\n', ...
        abwFrequenz(position));

fprintf('Stimulationsdauer: %.2f %%\n', ...
        abwStimDauer(position));

fprintf('Zyklusdauer:       %.2f %%\n', ...
        abwZyklus(position));

fprintf('\nFFT-Frequenzen:\n');

for m = 1:anzahlMessungen

    fprintf('%s: %.4f Hz\n', ...
        char(namen(m)), ...
        fftFrequenz(m));
end
