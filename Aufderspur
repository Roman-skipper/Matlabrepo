clear;
clc;
close all;

%% =========================================================
% 1. EINSTELLUNGEN
% Hier kannst du später einfach Werte verändern
% ==========================================================

dateien = [
    "normal0.csv"
    "frequenz0.csv"
    "mittlung0.csv"
    "sweep0.csv"
    "pause0.csv"
];

namen = [
    "Referenz"
    "Frequenz 4,6 Hz"
    "141 Mittelungen"
    "Sweep 40 ms"
    "Pause 10 s"
];

% Sollwerte der fünf Messungen
sollFrequenz = [4.7; 4.6; 4.7; 4.7; 4.7];
sollImpulse  = [137; 137; 141; 137; 137];

% Annahme: normaler Sweep = 80 ms
sollSweep_ms = [80; 80; 80; 40; 80];

sollPause_s  = [30; 30; 30; 30; 10];

anzahlMessungen = 5;
anzahlBloecke = 9;

% Einstellungen zur Impulserkennung
obereSchwelle = 5;
untereSchwelle = 3;
mindestAbstand = 0.15;
blockTrennung = 5;

%% =========================================================
% 2. SPEICHER FÜR DIE ERGEBNISSE
% ==========================================================

mittelImpulse = zeros(anzahlMessungen,1);
mittelFrequenz = zeros(anzahlMessungen,1);
fftFrequenz = zeros(anzahlMessungen,1);
mittelStimDauer = zeros(anzahlMessungen,1);
mittelZyklus = zeros(anzahlMessungen,1);

abwImpulse = zeros(anzahlMessungen,1);
abwFrequenz = zeros(anzahlMessungen,1);
abwStimDauer = zeros(anzahlMessungen,1);
abwZyklus = zeros(anzahlMessungen,1);
gesamtAbweichung = zeros(anzahlMessungen,1);

messStarts = cell(anzahlMessungen,1);
idealStarts = cell(anzahlMessungen,1);

%% =========================================================
% 3. ALLE FÜNF DATEIEN NACHEINANDER AUSWERTEN
% ==========================================================

for m = 1:anzahlMessungen

    fprintf('\n----------------------------------------\n');
    fprintf('Auswertung: %s\n',namen(m));
    fprintf('Datei: %s\n',dateien(m));
    fprintf('----------------------------------------\n');

    if ~isfile(dateien(m))
        error('Die Datei %s wurde nicht gefunden.',dateien(m));
    end

    daten = readmatrix(dateien(m));

    t = daten(:,1);
    u = daten(:,2);

    % Ungültige Werte entfernen
    gueltig = isfinite(t) & isfinite(u);
    t = t(gueltig);
    u = u(gueltig);

    % Zeitlich sortieren
    [t,reihenfolge] = sort(t);
    u = u(reihenfolge);

    %% Impulse mit Hysterese erkennen

    pulse = [];
    bereit = true;

    for k = 1:length(u)

        if bereit && u(k) >= obereSchwelle
            pulse(end+1,1) = t(k);
            bereit = false;
        end

        if ~bereit && u(k) <= untereSchwelle
            bereit = true;
        end
    end

    if isempty(pulse)
        error('In %s wurden keine Impulse erkannt.',dateien(m));
    end

    %% Zu dicht liegende Doppelzählungen entfernen

    pulseSauber = pulse(1);

    for k = 2:length(pulse)
        if pulse(k)-pulseSauber(end) >= mindestAbstand
            pulseSauber(end+1,1) = pulse(k);
        end
    end

    pulse = pulseSauber(:);

    %% Impulse in Blöcke aufteilen

    blockNummer = cumsum([true; diff(pulse) > blockTrennung]);
    blockGroesse = accumarray(blockNummer,1);

    % Ein echter Block muss mindestens 60 % der Sollimpulse besitzen
    minimumImpulse = round(0.6*sollImpulse(m));
    echteBloecke = find(blockGroesse >= minimumImpulse);

    fprintf('Erkannte vollständige Blöcke: %d\n',length(echteBloecke));
    fprintf('Impulse pro erkanntem Block:\n');
    disp(blockGroesse(echteBloecke)');

    if length(echteBloecke) < anzahlBloecke
        error('%s enthält weniger als 9 vollständige Blöcke.',dateien(m));
    end

    % Nur die ersten neun vollständigen Blöcke
    echteBloecke = echteBloecke(1:anzahlBloecke);

    %% Kennwerte der neun Blöcke bestimmen

    impulseProBlock = zeros(anzahlBloecke,1);
    frequenzProBlock = zeros(anzahlBloecke,1);
    stimDauerProBlock = zeros(anzahlBloecke,1);
    blockStart = zeros(anzahlBloecke,1);

    pulseDerBloecke = cell(anzahlBloecke,1);

    for b = 1:anzahlBloecke

        p = pulse(blockNummer == echteBloecke(b));
        pulseDerBloecke{b} = p;

        impulseProBlock(b) = length(p);
        blockStart(b) = p(1);

        abstaende = diff(p);

        frequenzProBlock(b) = 1/median(abstaende);

        % Zeit vom ersten bis zum letzten Impuls
        stimDauerProBlock(b) = p(end)-p(1);
    end

    % Erster Block wird auf 0 gesetzt
    blockStart = blockStart-blockStart(1);

    % Zeit zwischen zwei Blockstarts
    zyklusProBlock = diff(blockStart);

    %% Ideales Szenario für diese Messung berechnen

    idealeStimDauer = ...
        (sollImpulse(m)-1)/sollFrequenz(m);

    idealerZyklus = ...
        idealeStimDauer + ...
        sollSweep_ms(m)/1000 + ...
        sollPause_s(m);

    idealStart = (0:anzahlBloecke-1)'*idealerZyklus;

    messStarts{m} = blockStart;
    idealStarts{m} = idealStart;

    %% Mittelwerte

    mittelImpulse(m) = mean(impulseProBlock);
    mittelFrequenz(m) = mean(frequenzProBlock);
    mittelStimDauer(m) = mean(stimDauerProBlock);
    mittelZyklus(m) = mean(zyklusProBlock);

    %% FFT der Einzelimpulse

    Fs = 100;
    fftFenster = 35;
    N = round(Fs*fftFenster);
    NFFT = 2^16;

    spektrumSumme = zeros(NFFT,1);

    for b = 1:anzahlBloecke

        p = pulseDerBloecke{b};
        p = p-p(1);

        impulsSignal = zeros(N,1);

        positionen = round(p*Fs)+1;
        positionen = positionen( ...
            positionen >= 1 & positionen <= N);

        impulsSignal(positionen) = 1;

        spektrumSumme = ...
            spektrumSumme + abs(fft(impulsSignal,NFFT));
    end

    spektrumMittel = spektrumSumme/anzahlBloecke;
    frequenzAchse = (0:NFFT-1)'*(Fs/NFFT);

    suchBereich = ...
        frequenzAchse >= 4 & frequenzAchse <= 5.2;

    fSuche = frequenzAchse(suchBereich);
    ySuche = spektrumMittel(suchBereich);

    [~,peakPosition] = max(ySuche);
    fftFrequenz(m) = fSuche(peakPosition);

    %% Relative Abweichungen in Prozent

    abwImpulse(m) = ...
        abs(mittelImpulse(m)-sollImpulse(m)) ...
        /sollImpulse(m)*100;

    abwFrequenz(m) = ...
        abs(mittelFrequenz(m)-sollFrequenz(m)) ...
        /sollFrequenz(m)*100;

    abwStimDauer(m) = ...
        abs(mittelStimDauer(m)-idealeStimDauer) ...
        /idealeStimDauer*100;

    abwZyklus(m) = ...
        abs(mittelZyklus(m)-idealerZyklus) ...
        /idealerZyklus*100;

    % Durchschnitt der vier relativen Abweichungen
    gesamtAbweichung(m) = mean([
        abwImpulse(m)
        abwFrequenz(m)
        abwStimDauer(m)
        abwZyklus(m)
    ]);

end

%% =========================================================
% 4. ERGEBNISTABELLE
% ==========================================================

Ergebnisse = table( ...
    namen, ...
    sollImpulse, ...
    mittelImpulse, ...
    sollFrequenz, ...
    mittelFrequenz, ...
    fftFrequenz, ...
    mittelStimDauer, ...
    mittelZyklus, ...
    abwImpulse, ...
    abwFrequenz, ...
    abwStimDauer, ...
    abwZyklus, ...
    gesamtAbweichung, ...
    'VariableNames',{ ...
    'Messung', ...
    'Impulse_Soll', ...
    'Impulse_Gemessen', ...
    'Frequenz_Soll_Hz', ...
    'Frequenz_Zeit_Hz', ...
    'Frequenz_FFT_Hz', ...
    'Stimulationsdauer_s', ...
    'Zyklusdauer_s', ...
    'Abweichung_Impulse_Prozent', ...
    'Abweichung_Frequenz_Prozent', ...
    'Abweichung_Stimdauer_Prozent', ...
    'Abweichung_Zyklus_Prozent', ...
    'Gesamtabweichung_Prozent'});

disp(Ergebnisse);

%% =========================================================
% 5. FÜNF GRAPHEN:
% JEDE MESSUNG GEGEN IHR EIGENES IDEAL
% ==========================================================

figure( ...
    'Name','Messungen gegen jeweiliges Ideal', ...
    'Position',[100 50 1200 900]);

tiledlayout(3,2);

for m = 1:anzahlMessungen

    nexttile;

    % Differenz = Messung minus eigenes Ideal
    differenz = messStarts{m}-idealStarts{m};

    plot(1:anzahlBloecke,differenz, ...
        'o-','LineWidth',2,'MarkerFaceColor','b');

    hold on;
    yline(0,'k--','Idealer Start');
    hold off;

    xlabel('Block');
    ylabel('Messung - Ideal [s]');
    title(namen(m));
    xticks(1:anzahlBloecke);
    grid on;
end

%% =========================================================
% 6. VERGLEICH ALLER RELATIVEN ABWEICHUNGEN
% ==========================================================

figure( ...
    'Name','Relative Abweichungen aller Messungen', ...
    'Position',[100 100 1200 650]);

teilAbweichungen = [
    abwImpulse ...
    abwFrequenz ...
    abwStimDauer ...
    abwZyklus
];

b = bar(teilAbweichungen,'grouped');

hold on;

% Gesamtabweichung zusätzlich als schwarze Punkte
plot(1:anzahlMessungen,gesamtAbweichung, ...
    'ko','MarkerFaceColor','k','MarkerSize',9);

hold off;

xticks(1:anzahlMessungen);
xticklabels(namen);
xtickangle(20);

ylabel('Relative Abweichung vom eigenen Ideal [%]');
title('Welche Einstellung weicht am stärksten ab?');

legend( ...
    'Impulszahl', ...
    'Frequenz', ...
    'Stimulationsdauer', ...
    'Zyklusdauer', ...
    'Gesamtabweichung', ...
    'Location','best');

grid on;

%% =========================================================
% 7. GRÖSSTE GESAMTABWEICHUNG AUSGEBEN
% ==========================================================

[groessteAbweichung,position] = max(gesamtAbweichung);

fprintf('\n========================================\n');
fprintf('GRÖSSTE RELATIVE GESAMTABWEICHUNG\n');
fprintf('========================================\n');

fprintf('Messung: %s\n',namen(position));
fprintf('Gesamtabweichung: %.2f %%\n',groessteAbweichung);

fprintf('\nTeilabweichungen dieser Messung:\n');
fprintf('Impulszahl:         %.2f %%\n',abwImpulse(position));
fprintf('Frequenz:           %.2f %%\n',abwFrequenz(position));
fprintf('Stimulationsdauer:  %.2f %%\n',abwStimDauer(position));
fprintf('Zyklusdauer:        %.2f %%\n',abwZyklus(position));
