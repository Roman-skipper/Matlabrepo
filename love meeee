clear; close all; clc

%% Einstellungen
fs = 100000;           % Abtastrate des Oszilloskops
fStim = 4.6;           % Stimulationsfrequenz
sollStim = 30;         % 30 s Stimulation
sollPause = 30;        % 30 s Pause
sollZyklus = 60;       % Gesamter Zyklus
anzBloecke = 9;
anzMessungen = 4;

impulsperiode = 1/fStim;       % ungefähr 0,217 s
idealStart = 0:60:480;         % ideale Starts der 9 Blöcke

%% Speicher vorbereiten
namen = strings(anzMessungen,1);

impulseProBlock = zeros(anzMessungen,anzBloecke);
stimDauer = zeros(anzMessungen,anzBloecke);
pauseDauer = zeros(anzMessungen,anzBloecke-1);
zyklusDauer = zeros(anzMessungen,anzBloecke-1);

zeitFehler = zeros(anzMessungen,anzBloecke);
phaseFehler = zeros(anzMessungen,anzBloecke);

%% Vier Rohaufnahmen einlesen
for m = 1:anzMessungen

    [datei,pfad] = uigetfile('*.csv', ...
        sprintf('Aufnahme %d von 4 auswählen',m));

    if isequal(datei,0)
        error('Die Dateiauswahl wurde abgebrochen.')
    end

    namen(m) = erase(string(datei),'.csv');

    M = readmatrix(fullfile(pfad,datei), ...
        'NumHeaderLines',1);

    y = M(:,1);
    clear M

    y = y(isfinite(y));

    %% Automatische Erkennung der Signalrichtung
    basis = median(y);
    ausschlagOben = max(y)-basis;
    ausschlagUnten = basis-min(y);

    if ausschlagOben >= ausschlagUnten

        schwelle = basis + 0.5*ausschlagOben;

        idx = find( ...
            y(1:end-1) <= schwelle & ...
            y(2:end) > schwelle) + 1;

    else

        schwelle = basis - 0.5*ausschlagUnten;

        idx = find( ...
            y(1:end-1) >= schwelle & ...
            y(2:end) < schwelle) + 1;

    end

    %% Mehrfacherkennungen desselben Impulses entfernen
    mindestAbstand = round(0.1*fs);

    idx = idx([true; diff(idx) > mindestAbstand]);

    % Zeitpunkte der erkannten Impulse
    p = (idx-1)/fs;

    %% Stimulationsblöcke erkennen
    % Mehr als 2 s Abstand bedeutet: neuer Block
    blockAnfang = [1; find(diff(p)>2)+1];

    blockEnde = [blockAnfang(2:end)-1; length(p)];

    anzahlImpulse = blockEnde-blockAnfang+1;

    % Nur vollständige Blöcke mit plausibler Impulszahl
    guteBloecke = find( ...
        anzahlImpulse >= 100 & ...
        anzahlImpulse <= 180);

    if length(guteBloecke) < anzBloecke
        error('%s: Nur %d vollständige Blöcke erkannt.', ...
            datei,length(guteBloecke))
    end

    guteBloecke = guteBloecke(1:anzBloecke);

    %% Zeiten der neun Blöcke
    startZeit = p(blockAnfang(guteBloecke));
    endeZeit = p(blockEnde(guteBloecke));

    impulseProBlock(m,:) = anzahlImpulse(guteBloecke)';

    stimDauer(m,:) = (endeZeit-startZeit)';

    pauseDauer(m,:) = ...
        (startZeit(2:end)-endeZeit(1:end-1))';

    zyklusDauer(m,:) = diff(startZeit)';

    %% Vergleich mit idealem 30/30-Ablauf
    % Erster Block wird auf t = 0 gesetzt
    startRelativ = (startZeit-startZeit(1))';

    zeitFehler(m,:) = startRelativ-idealStart;

    % Umrechnung des Zeitfehlers in Phase:
    % 60 s entsprechen 360 Grad
    phaseFehler(m,:) = ...
        360*zeitFehler(m,:)/sollZyklus;

    clear y idx p
end

%% Ergebnisse pro Aufnahme
stimMittel = mean(stimDauer,2);
stimMedian = median(stimDauer,2);
stimSD = std(stimDauer,0,2);

pauseMittel = mean(pauseDauer,2);
pauseMedian = median(pauseDauer,2);
pauseSD = std(pauseDauer,0,2);

zyklusMittel = mean(zyklusDauer,2);
zyklusMedian = median(zyklusDauer,2);
zyklusSD = std(zyklusDauer,0,2);

mittlererZeitFehler = mean(abs(zeitFehler),2);
mittlererPhaseFehler = mean(abs(phaseFehler),2);

fehlerBlock9 = zeitFehler(:,end);
phaseBlock9 = phaseFehler(:,end);

% Geschätzte Dauer von neun vollständigen Zyklen
gesamtDauer = idealStart(end) + zyklusMittel;
gesamtAbweichung = gesamtDauer-540;

%% Große Ergebnistabelle
Ergebnisse = table( ...
    namen, ...
    mean(impulseProBlock,2), ...
    stimMittel,stimMedian,stimSD,stimMittel-sollStim, ...
    pauseMittel,pauseMedian,pauseSD,pauseMittel-sollPause, ...
    zyklusMittel,zyklusMedian,zyklusSD,zyklusMittel-sollZyklus, ...
    mittlererZeitFehler,mittlererPhaseFehler, ...
    fehlerBlock9,phaseBlock9, ...
    gesamtDauer,gesamtAbweichung, ...
    'VariableNames',{ ...
    'Messung', ...
    'Impulse_Mittelwert', ...
    'Stim_Mittelwert_s', ...
    'Stim_Median_s', ...
    'Stim_SD_s', ...
    'Stim_Abweichung_zu_30s', ...
    'Pause_Mittelwert_s', ...
    'Pause_Median_s', ...
    'Pause_SD_s', ...
    'Pause_Abweichung_zu_30s', ...
    'Zyklus_Mittelwert_s', ...
    'Zyklus_Median_s', ...
    'Zyklus_SD_s', ...
    'Zyklus_Abweichung_zu_60s', ...
    'Mittlere_abs_Zeitabweichung_s', ...
    'Mittlere_abs_Phasenabweichung_Grad', ...
    'Zeitfehler_Block9_s', ...
    'Phasenfehler_Block9_Grad', ...
    'Gesamtdauer_geschaetzt_s', ...
    'Abweichung_zu_540s'});

disp(Ergebnisse)

writetable(Ergebnisse, ...
    'Phasenvergleich_Einzelergebnisse.csv');

%% Zusammenfassung aller vier Aufnahmen
werte = [ ...
    stimMittel, ...
    pauseMittel, ...
    zyklusMittel, ...
    fehlerBlock9, ...
    phaseBlock9, ...
    gesamtAbweichung];

Kennwert = [ ...
    "Stimulationsdauer"; ...
    "Pausendauer"; ...
    "Zyklusdauer"; ...
    "Zeitfehler an Block 9"; ...
    "Phasenfehler an Block 9"; ...
    "Abweichung von 540 s"];

Einheit = ["s";"s";"s";"s";"Grad";"s"];

Zusammenfassung = table( ...
    Kennwert,Einheit, ...
    mean(werte,1)', ...
    median(werte,1)', ...
    std(werte,0,1)', ...
    min(werte,[],1)', ...
    max(werte,[],1)', ...
    'VariableNames',{ ...
    'Kennwert','Einheit','Mittelwert','Median', ...
    'Standardabweichung','Minimum','Maximum'});

disp(Zusammenfassung)

writetable(Zusammenfassung, ...
    'Phasenvergleich_Zusammenfassung.csv');

%% Toleranz: eine Impulsperiode pro Zyklus
blockNummer = 1:anzBloecke;

% Worst Case: In jedem Zyklus kommt dieselbe Abweichung hinzu
toleranzZeit = (blockNummer-1)*impulsperiode;

toleranzPhase = ...
    360*toleranzZeit/sollZyklus;

%% Farben
farben = lines(anzMessungen);
grau = [0.55 0.58 0.62];

%% Abbildung
fig = figure( ...
    'Color','w', ...
    'Position',[80 80 1100 720]);

tl = tiledlayout(2,1, ...
    'TileSpacing','compact', ...
    'Padding','compact');

%% Phasenabweichung
ax1 = nexttile;

hTol = fill( ...
    [blockNummer fliplr(blockNummer)], ...
    [toleranzPhase fliplr(-toleranzPhase)], ...
    [0.85 0.87 0.90], ...
    'EdgeColor','none', ...
    'FaceAlpha',0.45);

hold on

hIdeal = yline(0,'--', ...
    'Ideal 30/30', ...
    'Color',grau, ...
    'LineWidth',1.3);

hMessung = gobjects(anzMessungen,1);

for m = 1:anzMessungen

    hMessung(m) = plot( ...
        blockNummer,phaseFehler(m,:), ...
        '-o', ...
        'Color',farben(m,:), ...
        'MarkerFaceColor',farben(m,:), ...
        'LineWidth',1.6, ...
        'MarkerSize',6);

end

ylabel('Phasenabweichung [°]')
title('Abweichung vom idealen 60-s-Blockrhythmus')
xticks(1:9)
grid on
box off

legende = [cellstr(namen); ...
    {'Ideal 30/30'}; ...
    {'Toleranz: ±1 Impulsperiode je Zyklus'}];

legend([hMessung;hIdeal;hTol],legende, ...
    'Location','bestoutside');

%% Zeitabweichung
ax2 = nexttile;

fill( ...
    [blockNummer fliplr(blockNummer)], ...
    [toleranzZeit fliplr(-toleranzZeit)], ...
    [0.85 0.87 0.90], ...
    'EdgeColor','none', ...
    'FaceAlpha',0.45);

hold on
yline(0,'--','Color',grau,'LineWidth',1.3);

for m = 1:anzMessungen

    plot( ...
        blockNummer,zeitFehler(m,:), ...
        '-o', ...
        'Color',farben(m,:), ...
        'MarkerFaceColor',farben(m,:), ...
        'LineWidth',1.6, ...
        'MarkerSize',6);

end

xlabel('Stimulationsblock')
ylabel('Zeitabweichung [s]')
title('Zeitfehler gegenüber dem idealen 30/30-Ablauf')
xticks(1:9)
grid on
box off

%% Gemeinsames Design
title(tl, ...
    'Phasen- und Zeitvergleich von vier SEP-Aufnahmen', ...
    'FontSize',18)

subtitle(tl, ...
    'Ideal: 30 s Stimulation, 30 s Pause und 9 Wiederholungen')

set([ax1 ax2], ...
    'FontName','Arial', ...
    'FontSize',11, ...
    'LineWidth',0.8, ...
    'GridAlpha',0.15, ...
    'TickDir','out', ...
    'Color',[0.985 0.989 0.994]);

%% Für das Paper speichern
exportgraphics(fig, ...
    'Phasenvergleich_4_Aufnahmen.png', ...
    'Resolution',300);

savefig(fig, ...
    'Phasenvergleich_4_Aufnahmen.fig');
