clear; close all; clc

[dateien,ordner] = uigetfile('*.csv', ...
    'auf1 bis auf4 auswählen','MultiSelect','on');

if isequal(dateien,0), error('Keine Dateien gewählt.'); end
if ischar(dateien), dateien = {dateien}; end

fs = 100000;
fZiel = [1/60 3/60 5/60 7/60 9/60];
N = 480*fs;                         % 8 Blöcke plus letzte Pause
t = (0:N-1)'/fs;

ideal = double(mod(t,60)<30);
Yideal = fft(ideal-mean(ideal));
phi = NaN(length(dateien),length(fZiel));

for j = 1:length(dateien)

    M = readmatrix(fullfile(ordner,dateien{j}), ...
        'NumHeaderLines',1);

    u = M(:,1);
    u = u(isfinite(u));

    % Ersten vollständigen Block finden
    high = u > 5;
    imp = find(~high(1:end-1) & high(2:end)) + 1;
    imp = imp([true; diff(imp)/fs > 0.1]);

    p = (imp-1)/fs;
    a = [1; find(diff(p)>2)+1];
    e = [a(2:end)-1; length(p)];
    a = a(e-a+1 >= 100);

    if isempty(a)
        error('In %s wurde kein vollständiger Block gefunden.',dateien{j});
    end

    % Regel 1: Aufnahme beginnt beim ersten Blockstart
    start = imp(a(1));

    % Regel 2: nur 8 Blöcke einschließlich letzter Pause
    ende = start + N - 1;

    if ende > length(u)
        error('%s enthält nach Blockstart keine vollständigen 480 s.', ...
            dateien{j});
    end

    u = u(start:ende);

    Y = fft(u-mean(u));

    for k = 1:length(fZiel)

        idx = round(fZiel(k)*N/fs) + 1;

        phi(j,k) = rad2deg(angle(exp(1i*( ...
            angle(Y(idx))-angle(Yideal(idx))))));
    end
end

figure('Color','w');
hold on

farben = lines(length(dateien));

for j = 1:length(dateien)

    plot(fZiel,phi(j,:),'o', ...
        'LineStyle','none', ...
        'MarkerFaceColor',farben(j,:), ...
        'MarkerEdgeColor',farben(j,:), ...
        'MarkerSize',7);
end

yline(0,'--','Ideal 30/30');
ylim([-180 180]);
yticks(-180:45:180);
xticks(fZiel);
grid on
box off

xlabel('Frequenz [Hz]');
ylabel('Phasenabweichung zum Ideal [°]');
title('Phasenvergleich der vier SEP-Aufnahmen');

legend([dateien {'Ideal 30/30'}], ...
    'Location','eastoutside');

Ergebnis = table( ...
    fZiel', ...
    mean(abs(phi),1)', ...
    median(abs(phi),1)', ...
    std(abs(phi),0,1)', ...
    'VariableNames',{'Frequenz_Hz', ...
    'Mittelwert_abs_Grad', ...
    'Median_abs_Grad', ...
    'Standardabweichung_Grad'});

disp(Ergebnis)
