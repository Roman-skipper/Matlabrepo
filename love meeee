clear; close all; clc

files = {'auf1.csv','auf2.csv','auf3.csv','auf4.csv'};
fs = 100000;
f = [1 3 5 7 9]/60;                 % Blockfrequenz und Oberwellen

for i = 1:4
    M = readmatrix(files{i},'NumHeaderLines',1);
    y = M(:,1); y = y(isfinite(y)); y = y-median(y);

    if abs(min(y)) > abs(max(y)), y = -y; end
    start = find(y > 0.5*max(y),1);
    y = y(start:end);

    N = length(y); t = (0:N-1)'/fs;
    ideal = double(mod(t,60)<30);

    Y = fft(y-mean(y)); I = fft(ideal-mean(ideal));
    k = round(f*N/fs)+1;

    % Phase der Rohdaten relativ zur idealen 30/30-Phase
    abw(i,:) = rad2deg(angle(exp(1i*(angle(Y(k))-angle(I(k))))));
end

A = abs(abw);
toleranz = 360*f/4.6;                % eine Impulsperiode

T = table(f',abw(1,:)',abw(2,:)',abw(3,:)',abw(4,:)', ...
    mean(A,1)',median(A,1)',std(A,0,1)',min(A,[],1)',max(A,[],1)', ...
    mean(A,1)'./(360*f'),toleranz',sum(A>toleranz,1)', ...
    'VariableNames',{'Frequenz_Hz','Aufnahme1_Grad','Aufnahme2_Grad', ...
    'Aufnahme3_Grad','Aufnahme4_Grad','Mittelwert_abs_Grad', ...
    'Median_abs_Grad','Standardabweichung_Grad','Minimum_Grad', ...
    'Maximum_Grad','Mittlerer_Zeitversatz_s','Toleranz_Grad', ...
    'Anzahl_ausserhalb_Toleranz'});

disp(T)
writetable(T,'Phasenauswertung.csv');

%% Paper-Diagramm
farben = [0.10 0.36 0.63; 0.86 0.40 0.15; ...
          0.20 0.55 0.35; 0.48 0.30 0.65];

figure('Color','w','Position',[100 100 1000 560]); hold on
h = gobjects(4,1);

for i = 1:4
    h(i) = scatter(f,abw(i,:),65,farben(i,:),'filled');
end

h0 = yline(0,'--','Ideal 30/30','Color',[0.25 0.25 0.25], ...
    'LineWidth',1.4);

xlabel('Frequenz [Hz]')
ylabel('Phasenabweichung zum Ideal [°]')
title('Phasenvergleich der vier SEP-Rohaufnahmen')
subtitle('Ideal 30/30 = 0° | Messpunkte nicht verbunden')
xticks(f); xticklabels(compose('%.4f',f))
ylim([-180 180]); yticks(-180:45:180)
grid on; box off

legend([h;h0],[string(files)';"Ideal 30/30"], ...
    'Location','eastoutside');

set(gca,'FontName','Arial','FontSize',11,'LineWidth',0.8, ...
    'GridAlpha',0.14,'TickDir','out','Color',[0.985 0.989 0.994]);

exportgraphics(gcf,'Phasenvergleich_Paper.png','Resolution',300);
