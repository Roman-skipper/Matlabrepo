%% PAPER-GRAFIK: NUR DIE WICHTIGE BLOCKFREQUENZ 1/60 Hz

phi = Phase(1,:)';                 % Phase bei 0,01667 Hz
mittelAbs = mean(abs(phi));
medianAbs = median(abs(phi));
sdAbs = std(abs(phi));

grenze = max(abs(phi))*1.4;
if grenze < 1
    grenze = 1;
end

farben = lines(4);

fig = figure('Color','w','Position',[100 100 850 520]);
hold on

for m = 1:4
    scatter(m,phi(m),90,farben(m,:),'filled');

    if phi(m) >= 0
        abstand = 0.08*grenze;
    else
        abstand = -0.10*grenze;
    end

    text(m,phi(m)+abstand,sprintf('%.2f°',phi(m)), ...
        'HorizontalAlignment','center','FontSize',11);
end

yline(0,'k--','Ideal 30/30','LineWidth',1.3);

xlim([0.5 4.5])
ylim([-grenze grenze])
xticks(1:4)
xticklabels(erase(dateien,'.csv'))

ylabel('Phasenabweichung zum Ideal [°]')
xlabel('SEP-Aufnahme')
title('Phase bei der Blockfrequenz 1/60 Hz')
subtitle(sprintf(['Ausrichtung am ersten Blockstart | 8 Zyklen | ' ...
    'mittlere absolute Abweichung %.2f°'],mittelAbs))

grid on
box off
set(gca,'FontName','Arial','FontSize',11,'GridAlpha',0.15)

exportgraphics(fig,'Phase_Grundfrequenz.png','Resolution',300);

%% TABELLEN SPEICHERN

Einzelwerte = table(dateien',phi,abs(phi), ...
    'VariableNames',{'Datei','Phase_Grad','Absolute_Abweichung_Grad'});

Statistik = table(mittelAbs,medianAbs,sdAbs,min(phi),max(phi), ...
    'VariableNames',{'Mittelwert_abs_Grad','Median_abs_Grad', ...
    'Standardabweichung_abs_Grad','Minimum_Grad','Maximum_Grad'});

writetable(Einzelwerte,'Phase_Einzelwerte.csv');
writetable(Statistik,'Phase_Statistik.csv');

disp(Einzelwerte)
disp(Statistik)
