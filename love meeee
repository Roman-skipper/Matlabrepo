clear; close all; clc

dateien = {'auf1.csv','auf2.csv','auf3.csv','auf4.csv'};
fs = 100000;
fZiel = [1/60 3/60 5/60 7/60 9/60];
phi = NaN(4,length(fZiel));

% Ideales 30/30-Signal für exakt 8 Zyklen
N = 480*fs;
t = (0:N-1)'/fs;
ideal = double(mod(t,60)<30);
Yideal = fft(ideal-mean(ideal));

for j = 1:4

    M = readmatrix(dateien{j},'NumHeaderLines',1);
    u = M(:,1);
    u = u(isfinite(u));

    % Ersten vollständigen Block erkennen
    high = u > 5;
    imp = find(~high(1:end-1) & high(2:end)) + 1;
    imp = imp([true; diff(imp)/fs > 0.1]);

    p = (imp-1)/fs;
    a = [1; find(diff(p)>2)+1];
    e = [a(2:end)-1; length(p)];
    a = a(e-a+1 >= 100);

    % Aufnahme am ersten Blockstart beginnen lassen
    start = imp(a(1));
    ende = start + N - 1;

    if ende > length(u)
        error('%s enthält nach Blockstart keine vollständigen 480 s.', ...
            dateien{j});
    end

    % Nur Block 1 bis Block 8 einschließlich letzter Pause
    u = u(start:ende);

    % FFT
    Y = fft(u-mean(u));
    f = (0:N-1)*fs/N;

    % Phase relativ zum idealen 30/30-Signal
    for k = 1:length(fZiel)
        [~,idx] = min(abs(f-fZiel(k)));

        phi(j,k) = rad2deg(angle(exp(1i*( ...
            angle(Y(idx))-angle(Yideal(idx))))));
    end
end

% Phasendiagramm
figure('Color','w');
hold on

farben = lines(4);

for j = 1:4
    plot(fZiel,phi(j,:),'o', ...
        'LineStyle','none', ...
        'MarkerFaceColor',farben(j,:), ...
        'MarkerEdgeColor',farben(j,:), ...
        'MarkerSize',7);
end

yline(0,'--','Ideal 30/30');
ylim([-180 180]);
yticks(-180:45:180);
xticks(fZiel);
grid on
box off

xlabel('Frequenz [Hz]');
ylabel('Phasenabweichung zum Ideal [°]');
title('Phasenvergleich der vier SEP-Aufnahmen');

legend('auf1.csv','auf2.csv','auf3.csv','auf4.csv', ...
    'Ideal 30/30','Location','eastoutside');

% Ergebnistabelle
Ergebnis = table( ...
    fZiel', ...
    mean(abs(phi),1)', ...
    median(abs(phi),1)', ...
    std(abs(phi),0,1)', ...
    'VariableNames',{'Frequenz_Hz', ...
    'Mittelwert_abs_Grad', ...
    'Median_abs_Grad', ...
    'Standardabweichung_Grad'});

disp(Ergebnis)
