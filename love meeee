clear; close all; clc

files = {'auf1.csv','auf2.csv','auf3.csv','auf4.csv'};
fs = 100000;
f = [1 3 5 7 9]/60;                 % Blockfrequenz + Oberwellen

for i = 1:4
    M = readmatrix(files{i},'NumHeaderLines',1);
    y = M(:,1); y = y(isfinite(y)); y = y-median(y);

    if abs(min(y)) > abs(max(y)), y = -y; end
    start = find(y > 0.5*max(y),1);  % erster Impuls = Zeitnull
    y = y(start:end);

    N = length(y); t = (0:N-1)'/fs;
    ideal = double(mod(t,60)<30);     % ideales 30/30-Signal

    Y = fft(y-mean(y)); I = fft(ideal-mean(ideal));
    k = round(f*N/fs)+1;

    phaseRoh(i,:) = rad2deg(angle(Y(k)));
    phaseIdeal(i,:) = rad2deg(angle(I(k)));
    abweichung(i,:) = rad2deg(angle(exp(1i*(angle(Y(k))-angle(I(k))))));
end

idealMittel = rad2deg(angle(mean(exp(1i*deg2rad(phaseIdeal)),1)));
toleranz = 360*f/4.6;                % eine Impulsperiode als Toleranz

T = table(string(files)',abweichung(:,1),-abweichung(:,1)/(360*f(1)), ...
    mean(abs(abweichung),2),median(abs(abweichung),2),std(abweichung,0,2), ...
    max(abs(abweichung),[],2),sum(abs(abweichung)>toleranz,2), ...
    'VariableNames',{'Aufnahme','Abweichung_1_60_Grad','Zeitversatz_s', ...
    'Mittelwert_Grad','Median_Grad','Standardabweichung_Grad', ...
    'Maximum_Grad','Ausserhalb_Toleranz'});
disp(T); writetable(T,'Phasenauswertung.csv');

figure('Color','w'); tiledlayout(2,1)
nexttile; plot(f,idealMittel,'k--o','LineWidth',2); hold on
plot(f,phaseRoh','-o','LineWidth',1.4); ylim([-180 180]); grid on
ylabel('Phase [°]'); title('Rohdatenphase und ideales 30/30')
legend(["Ideal 30/30",string(files)],'Location','bestoutside')

nexttile; plot(f,abweichung','-o','LineWidth',1.4); hold on
plot(f,toleranz,'k:'); plot(f,-toleranz,'k:'); yline(0,'--');
grid on; xlabel('Frequenz [Hz]'); ylabel('Abweichung [°]')
title('Phasenabweichung vom idealen 30/30-Signal')

exportgraphics(gcf,'Phasenvergleich.png','Resolution',300);
