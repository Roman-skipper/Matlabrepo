clear; close all; clc

files = {'auf1.csv','auf2.csv','auf3.csv','auf4.csv'};
fs = 100000;
f = [1 3 5 7 9]/60;

for i = 1:4
    M = readmatrix(files{i},'NumHeaderLines',1);
    y = M(:,1); y = y(isfinite(y)); y = y-median(y);

    if abs(min(y)) > abs(max(y)), y = -y; end
    start = find(y > 0.5*max(y),1);
    y = y(start:end);

    N = length(y); t = (0:N-1)'/fs;
    ideal = double(mod(t,60)<30);

    Y = fft(y-mean(y)); I = fft(ideal-mean(ideal));
    k = round(f*N/fs)+1;

    phaseRoh(i,:) = rad2deg(angle(Y(k)));
    phaseIdeal(i,:) = rad2deg(angle(I(k)));
    abw(i,:) = rad2deg(angle(exp(1i*(angle(Y(k))-angle(I(k))))));
end

idealPhase = rad2deg(angle(mean(exp(1i*deg2rad(phaseIdeal)),1)));
toleranz = 360*f/4.6;
absAbw = abs(abw);

T = table(f',abw(1,:)',abw(2,:)',abw(3,:)',abw(4,:)', ...
    mean(absAbw,1)',median(absAbw,1)',std(absAbw,0,1)', ...
    min(absAbw,[],1)',max(absAbw,[],1)', ...
    mean(absAbw,1)'./(360*f'),toleranz', ...
    'VariableNames',{'Frequenz_Hz','Aufnahme1_Grad','Aufnahme2_Grad', ...
    'Aufnahme3_Grad','Aufnahme4_Grad','Mittelwert_abs_Grad', ...
    'Median_abs_Grad','Standardabweichung_Grad','Minimum_Grad', ...
    'Maximum_Grad','Mittlerer_Zeitversatz_s','Toleranz_Grad'});

disp(T)
writetable(T,'Phasenauswertung_4_Aufnahmen.csv');

%% Paper-Abbildung
farben = [0.10 0.36 0.63; 0.86 0.40 0.15; ...
          0.20 0.55 0.35; 0.48 0.30 0.65];

fig = figure('Color','w','Position',[80 80 1050 720]);
tl = tiledlayout(2,1,'TileSpacing','compact','Padding','compact');

ax1 = nexttile;
hIdeal = scatter(f,idealPhase,80,'kd','filled'); hold on
h = gobjects(4,1);
for i = 1:4
    h(i) = scatter(f,phaseRoh(i,:),55,farben(i,:),'filled');
end
yline(0,':','Color',[0.55 0.58 0.62]);
ylim([-180 180]); ylabel('Phase [°]'); grid on
title('FFT-Phase der Rohaufnahmen und des idealen 30/30-Signals')
legend([hIdeal;h],["Ideal 30/30",string(files)], ...
    'Location','eastoutside');

ax2 = nexttile;
fill([f fliplr(f)],[toleranz fliplr(-toleranz)], ...
    [0.85 0.87 0.90],'EdgeColor','none','FaceAlpha',0.6);
hold on
for i = 1:4
    scatter(f,abw(i,:),55,farben(i,:),'filled');
end
yline(0,'--','Ideal','Color',[0.55 0.58 0.62]);
xlabel('Frequenz [Hz]'); ylabel('Abweichung [°]'); grid on
title('Phasenabweichung gegenüber dem idealen 30/30-Signal')

set([ax1 ax2],'FontName','Arial','FontSize',11,'LineWidth',0.8, ...
    'GridAlpha',0.14,'TickDir','out','Color',[0.985 0.989 0.994]);
xticks(ax1,f); xticks(ax2,f)
title(tl,'Phasenvergleich von vier SEP-Rohaufnahmen','FontSize',17)
subtitle(tl,'Messpunkte ohne Verbindungslinien | Grau: Toleranz einer Impulsperiode')

exportgraphics(fig,'Phasenvergleich_Paper.png','Resolution',300);
