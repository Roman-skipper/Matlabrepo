clear; close all; clc

%% Einstellungen
tInc = 1e-5;
schwelle = -10;
Fs = 100;

t = (0:1/Fs:540-1/Fs)';
ideal = double(mod(t,60) < 30);

Xi = fft(ideal-mean(ideal));

% Grundfrequenz und zwei Oberwellen des 30/30-Signals
fTest = [1/60 3/60 5/60];
k = round(fTest*length(t)/Fs)+1;

%% Vier Dateien auswählen
[dateien,ordner] = uigetfile('*.csv', ...
    'Vier Aufnahmen auswählen','MultiSelect','on');

if ischar(dateien)
    dateien = {dateien};
end

if length(dateien) ~= 4
    error('Bitte genau vier Aufnahmen auswählen.')
end

phaseDiff = zeros(4,3);

%% Aufnahmen auswerten
for m = 1:4

    M = readmatrix(fullfile(ordner,dateien{m}), ...
        'NumHeaderLines',1);

    u = M(:,1);
    u = u(isfinite(u));

    % Impulsanfänge erkennen
    idx = find(u(1:end-1) > schwelle & ...
               u(2:end) <= schwelle)+1;

    p = (idx-1)*tInc;
    p = p([true; diff(p)>0.1]);

    % Blöcke erkennen
    a = [1; find(diff(p)>2)+1];
    e = [a(2:end)-1; length(p)];

    groesse = e-a+1;
    gut = find(groesse>100);

    if length(gut) < 9
        error('%s: weniger als 9 Blöcke erkannt.',dateien{m})
    end

    a = a(gut(1:9));
    e = e(gut(1:9));

    % Ersten Block auf t = 0 setzen
    start = p(a)-p(a(1));

    abstand = diff(p);
    periode = median(abstand(abstand<1));
    ende = p(e)-p(a(1))+periode;

    % Gemessene Blöcke als Rechtecke
    messung = zeros(size(t));

    for b = 1:9
        messung(t>=start(b) & t<ende(b)) = 1;
    end

    %% Phasendifferenz zum Ideal
    Xm = fft(messung-mean(messung));

    phaseDiff(m,:) = rad2deg( ...
        angle(Xm(k).*conj(Xi(k))));
end

%% Darstellung
figure('Color','w','Position',[100 100 950 520])

bar(phaseDiff')
hold on
yline(0,'--k','Ideal')

xticks(1:3)
xticklabels({'1/60 Hz','3/60 Hz','5/60 Hz'})
ylim([-180 180])
ylabel('Phasendifferenz zum Ideal [°]')
xlabel('Frequenz des 30/30-Musters')
title('Phasenvergleich der vier Aufnahmen mit dem Ideal')
legend(dateien,'Interpreter','none','Location','best')
grid on
box off

%% Hauptphase in eine Zeitverschiebung umrechnen
verzoegerung = -phaseDiff(:,1)/(360*(1/60));

Ergebnis = table(string(dateien(:)),phaseDiff(:,1),verzoegerung, ...
    'VariableNames',{'Aufnahme','Phase_bei_1_60_Grad', ...
                     'Zeitverschiebung_s'});

disp(Ergebnis)
