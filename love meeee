clear; close all; clc

dateien = ["auf1.csv","auf2.csv","auf3.csv","auf4.csv"];
tInc = 1e-5;                    % Abtastintervall der Rigol-Dateien
Fs = 4;                         % Abtastrate des Blocksignals
t = (0:1/Fs:480-1/Fs)';         % 8 vollständige 60-s-Zyklen
ideal = double(mod(t,60)<30);    % ideales 30/30-Signal

fZiel = [1/60 3/60 5/60 7/60 9/60];
idx = round(fZiel*length(t)/Fs)+1;
Yideal = fft(ideal-mean(ideal));

Phase = zeros(length(fZiel),4);
Signale = zeros(length(t),4);

for m = 1:4
    M = readmatrix(dateien(m),'NumHeaderLines',1);
    u = M(:,1);
    u = u(isfinite(u));

    schwelle = (min(u)+max(u))/2;
    puls = u < schwelle;                         % negative Stimulationsimpulse
    start = find(~puls(1:end-1) & puls(2:end))+1;
    start = start([true; diff(start)*tInc>0.1]);
    pulszeit = (start-1)*tInc;

    bs = [1; find(diff(pulszeit)>2)+1];
    be = [bs(2:end)-1; length(pulszeit)];
    gueltig = (be-bs+1)>=100;
    bs = bs(gueltig);
    be = be(gueltig);

    if length(bs)<8
        error('%s: Weniger als 8 vollständige Blöcke erkannt.',dateien(m))
    end

    blockstart = pulszeit(bs(1:8));
    blockstart = blockstart-blockstart(1);        % erster Block = Zeitpunkt 0

    signal = zeros(size(t));

    for b = 1:8
        p = pulszeit(bs(b):be(b));
        dauer = p(end)-p(1)+median(diff(p));
        signal(t>=blockstart(b) & t<blockstart(b)+dauer) = 1;
    end

    Signale(:,m) = signal;
    Y = fft(signal-mean(signal));

    Phase(:,m) = rad2deg(angle(exp(1i* ...
        (angle(Y(idx))-angle(Yideal(idx))))));
end

%% Kontrolle: Starten wirklich alle bei 0?
figure
stairs(t,ideal,'k--','LineWidth',2); hold on
stairs(t,Signale,'LineWidth',1)
xlim([0 120]); ylim([-0.1 1.1]); grid on
xlabel('Zeit [s]'); ylabel('Blocksignal')
legend(["Ideal",dateien],'Location','best')
title('Kontrolle der gemeinsamen Startzeit')

%% Phasenvergleich
figure
plot(fZiel,Phase,'o','MarkerSize',7,'LineWidth',1.5)
hold on
yline(0,'k--','Ideal 30/30')
ylim([-180 180]); grid on
xlabel('Frequenz [Hz]')
ylabel('Phasenabweichung zum Ideal [°]')
title('Phasenvergleich der vier SEP-Aufnahmen')
legend(dateien,'Location','eastoutside')

%% Ergebnistabelle
Ergebnis = table(fZiel',mean(abs(Phase),2),median(abs(Phase),2), ...
    std(abs(Phase),0,2),'VariableNames', ...
    {'Frequenz_Hz','Mittelwert_abs_Grad', ...
    'Median_abs_Grad','Standardabweichung_Grad'});

disp(Ergebnis)
