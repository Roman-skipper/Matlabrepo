clear; close all; clc

%% 9-Minuten-Ablauf
t = 0:0.05:540;
starts = 30:60:510;
ablauf = zeros(size(t));

for i = 1:length(starts)
    ablauf(t >= starts(i) & t < starts(i)+30) = 1;
end

figure('Color','w','Position',[100 100 1000 650]);

subplot(2,1,1)
stairs(t,ablauf,'LineWidth',2,'Color',[0.10 0.36 0.63]);

xlim([0 540])
ylim([-0.2 1.2])
yticks([0 1])
yticklabels({'Ruhe','Stimulation'})
xticks(0:60:540)
xticklabels(0:9)
xlabel('Zeit [min]')
title('Schematischer Ablauf über neun Minuten')
grid on

%% Vergleich: früheres Ende und fast gleicher nächster Start
t2 = 0:0.05:90;

ideal = (t2 < 30) | (t2 >= 60);
simulation = (t2 < 28) | (t2 >= 60.2);

subplot(2,1,2)

stairs(t2,ideal+1.5,'LineWidth',2,'Color',[0.10 0.36 0.63]);
hold on
stairs(t2,simulation,'LineWidth',2,'Color',[0.86 0.40 0.15]);

xline(28,':','Simulation endet');
xline(30,'--','Ideal endet');
xline(60,'--','Ideal startet');
xline(60.2,':','Simulation startet');

xlim([20 70])
ylim([-0.2 2.8])
yticks([0.5 2])
yticklabels({'Simulation','Ideal'})
xlabel('Zeit [s]')
title('Längere Pause und fast zeitgleicher nächster Start')
legend('Ideal','Simulation','Location','southoutside')
grid on

exportgraphics(gcf,'SEP_Blockablauf_schematisch.png','Resolution',300);
