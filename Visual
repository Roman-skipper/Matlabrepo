clear; close all; clc

%% Einstellungen
t = 0:0.05:540;        % gesamte Messzeit: 9 Minuten
starts = 30:60:510;    % erster Block nach 30 s Ruhe

stimSoll = 30;          % ideale Stimulation
stimMessung = 29.842;   % verkürzte Stimulation

soll = zeros(size(t));
messung = zeros(size(t));

%% Neun Stimulationsblöcke erzeugen
for i = 1:length(starts)
    soll(t >= starts(i) & t < starts(i)+stimSoll) = 1;
    messung(t >= starts(i) & t < starts(i)+stimMessung) = 1;
end

%% Gesamte neun Minuten
figure('Color','w');

subplot(2,1,1)
stairs(t,soll+1.5,'LineWidth',2,'Color',[0.10 0.36 0.63]);
hold on
stairs(t,messung,'LineWidth',2,'Color',[0.86 0.40 0.15]);

xlim([0 540])
ylim([-0.2 2.8])
yticks([0.5 2])
yticklabels({'Messung','Ideal'})
xticks(0:60:540)
xticklabels(0:9)
xlabel('Zeit [min]')
title('Neun Minuten mit 30 s Ruhe zu Beginn')
grid on
legend('Ideal: 30,000 s','Messung: 29,842 s', ...
       'Location','southoutside','Orientation','horizontal')

%% Vergrößerung des ersten Übergangs
subplot(2,1,2)
stairs(t,soll+1.5,'LineWidth',2,'Color',[0.10 0.36 0.63]);
hold on
stairs(t,messung,'LineWidth',2,'Color',[0.86 0.40 0.15]);

xline(59.842,':','Messung endet','Color',[0.86 0.40 0.15]);
xline(60,'--','Ideal endet','Color',[0.10 0.36 0.63]);
xline(90,'--','Gemeinsamer nächster Start');

xlim([55 95])
ylim([-0.2 2.8])
yticks([0.5 2])
yticklabels({'Messung','Ideal'})
xlabel('Zeit [s]')
title('Früheres Ende der Stimulation und längere Pause')
grid on

%% Bild speichern
exportgraphics(gcf,'SEP_Blockvergleich.png','Resolution',300);
