clear; clc; close all;

%% 1. CSV einlesen
[datei, ordner] = uigetfile('*.csv', 'Wähle deine Rigol-CSV aus');

if isequal(datei,0)
    error('Keine Datei ausgewählt.');
end

daten = readmatrix(fullfile(ordner,datei));

t = daten(:,1);
u = daten(:,2);

gut = isfinite(t) & isfinite(u);
t = t(gut);
u = u(gut);

[t,sortierung] = sort(t);
u = u(sortierung);

%% 2. Impulse erkennen
schwelle = 5;
mindestAbstand = 0.18;

idx = find(u(1:end-1) <= schwelle & ...
           u(2:end) > schwelle) + 1;

pulse = t(idx);

% Doppelzählungen entfernen
pulseSauber = pulse(1);

for k = 2:length(pulse)
    if pulse(k)-pulseSauber(end) >= mindestAbstand
        pulseSauber(end+1,1) = pulse(k);
    end
end

pulse = pulseSauber(:);

%% 3. Stimulationsblöcke erkennen
% Mehr als 5 Sekunden Abstand bedeutet neuer Block
blockNummer = cumsum([true; diff(pulse) > 5]);
blockGroesse = accumarray(blockNummer,1);

% Die 9 größten Impulsgruppen auswählen
[~, reihenfolge] = sort(blockGroesse,'descend');

if length(reihenfolge) < 9
    error('In der Datei wurden insgesamt weniger als 9 Gruppen erkannt.');
end

volleBloecke = reihenfolge(1:9);

% Anschließend wieder zeitlich sortieren
volleBloecke = sort(volleBloecke);

disp('Anzahl der erkannten Impulse in den 9 ausgewählten Blöcken:');
disp(blockGroesse(volleBloecke)');

% Nur die ersten 9 vollständigen Blöcke verwenden
volleBloecke = volleBloecke(1:9);

messStart = zeros(9,1);
messDauer = zeros(9,1);
messAnzahl = zeros(9,1);

for k = 1:9
    p = pulse(blockNummer == volleBloecke(k));

    messStart(k) = p(1);
    messDauer(k) = p(end)-p(1);
    messAnzahl(k) = length(p);
end

% Erster Block beginnt bei 0 Sekunden
messStart = messStart-messStart(1);

%% 4. Zwei saubere künstliche Varianten

% Variante A:
% 4,7 Hz, 137 Mittelungen und danach 30 s Ruhe
f = 4.7;
anzahl137 = 137;

stimDauer137 = anzahl137/f;       % 29,1489 s
zyklus137 = stimDauer137+30;      % 59,1489 s

start137 = (0:8)'*zyklus137;
dauer137 = ones(9,1)*stimDauer137;

% Variante B:
% Exakt 30 s Stimulation und 30 s Ruhe
zyklusPerfekt = 60;

startPerfekt = (0:8)'*zyklusPerfekt;
dauerPerfekt = ones(9,1)*30;

%% 5. Abweichung der Blockstarts
abweichung137 = messStart-start137;
abweichungPerfekt = messStart-startPerfekt;

Tabelle = table( ...
    (1:9)', ...
    messAnzahl, ...
    messStart, ...
    messDauer, ...
    start137, ...
    abweichung137, ...
    startPerfekt, ...
    abweichungPerfekt, ...
    'VariableNames',{ ...
    'Block', ...
    'Gemessene_Impulse', ...
    'Messstart_s', ...
    'Messdauer_s', ...
    'Start_137_s', ...
    'Abweichung_zu_137_s', ...
    'Start_30_30_s', ...
    'Abweichung_zu_30_30_s'});

disp(Tabelle);

%% 6. Vergleich der neun Blockstarts
figure('Name','Vergleich der Blockstarts');

plot(1:9,messStart,'ko-','LineWidth',2);
hold on;
plot(1:9,start137,'bo--','LineWidth',1.5);
plot(1:9,startPerfekt,'ro--','LineWidth',1.5);
hold off;

xlabel('Block');
ylabel('Startzeit [s]');
title('Startzeiten der 9 Blöcke');
legend('Messung','137 bei 4,7 Hz','Perfektes 30/30', ...
       'Location','northwest');
grid on;

%% 7. Zeitabweichung pro Block
figure('Name','Zeitabweichung');

plot(1:9,abweichung137,'bo-','LineWidth',2);
hold on;
plot(1:9,abweichungPerfekt,'ro-','LineWidth',2);
yline(0,'k--');
hold off;

xlabel('Block');
ylabel('Abweichung [s]');
title('Entsteht über die 9 Blöcke eine Verzögerung?');
legend('gegenüber 137 bei 4,7 Hz', ...
       'gegenüber perfektem 30/30', ...
       'Location','best');
grid on;

%% 8. Blockdauer vergleichen
figure('Name','Dauer der Stimulation');

bar([messDauer dauer137 dauerPerfekt]);

xlabel('Block');
ylabel('Stimulationsdauer [s]');
title('Dauer der neun Stimulationsphasen');
legend('Messung','137 bei 4,7 Hz','Perfekte 30 s', ...
       'Location','best');
grid on;

%% 9. Blocksignale für die FFT erstellen
Fs = 10;                 % 10 Werte pro Sekunde
gesamtZeit = 540;        % 9 vollständige 60-s-Zyklen
zeit = (0:1/Fs:gesamtZeit-1/Fs)';

signalMessung = zeros(size(zeit));
signal137 = zeros(size(zeit));
signalPerfekt = zeros(size(zeit));

for k = 1:9

    % Gemessene Blöcke
    signalMessung(zeit >= messStart(k) & ...
                  zeit < messStart(k)+messDauer(k)) = 1;

    % 137-Mittelungen-Variante
    signal137(zeit >= start137(k) & ...
              zeit < start137(k)+stimDauer137) = 1;

    % Exakte 30/30-Variante
    signalPerfekt(zeit >= startPerfekt(k) & ...
                  zeit < startPerfekt(k)+30) = 1;
end

%% 10. Verlauf der drei Blocksignale
figure('Name','Künstliche und gemessene Blocksignale');

subplot(3,1,1);
stairs(zeit,signalMessung,'k','LineWidth',1.5);
ylabel('Messung');
ylim([-0.2 1.2]);
grid on;

subplot(3,1,2);
stairs(zeit,signal137,'b','LineWidth',1.5);
ylabel('137 / 4,7 Hz');
ylim([-0.2 1.2]);
grid on;

subplot(3,1,3);
stairs(zeit,signalPerfekt,'r','LineWidth',1.5);
ylabel('30/30');
xlabel('Zeit [s]');
ylim([-0.2 1.2]);
grid on;

%% 11. FFT der Stimulationsblöcke
N = length(zeit);
frequenz = (0:N-1)'*(Fs/N);

fftMessung = abs(fft(signalMessung-mean(signalMessung)));
fft137 = abs(fft(signal137-mean(signal137)));
fftPerfekt = abs(fft(signalPerfekt-mean(signalPerfekt)));

% Normieren
fftMessung = fftMessung/max(fftMessung);
fft137 = fft137/max(fft137);
fftPerfekt = fftPerfekt/max(fftPerfekt);

figure('Name','FFT der 9 Blöcke');

plot(frequenz,fftMessung,'k','LineWidth',2);
hold on;
plot(frequenz,fft137,'b--','LineWidth',1.5);
plot(frequenz,fftPerfekt,'r--','LineWidth',1.5);

% Erwartete Wiederholungsfrequenzen
xline(1/60,'r:','1/60 Hz');
xline(1/zyklus137,'b:','1/59,15 Hz');

hold off;

xlim([0.005 0.04]);
xlabel('Frequenz [Hz]');
ylabel('Normierte FFT-Stärke');
title('FFT der Blockwiederholung');
legend('Messung','137 bei 4,7 Hz','Perfektes 30/30', ...
       'Location','best');
grid on;
