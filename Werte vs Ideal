clear; clc; close all;

%% 1. CSV-Datei auswählen
[datei,ordner] = uigetfile('*.csv','Rigol-CSV auswählen');

if isequal(datei,0)
    error('Keine Datei ausgewählt.');
end

daten = readmatrix(fullfile(ordner,datei));

t = daten(:,1);
u = daten(:,2);

% Ungültige Zeilen entfernen
gut = isfinite(t) & isfinite(u);
t = t(gut);
u = u(gut);

% Zeitlich sortieren
[t,reihenfolge] = sort(t);
u = u(reihenfolge);

%% 2. Einzelne Impulse erkennen
schwelle = 5;
mindestAbstand = 0.18;

idx = find(u(1:end-1) <= schwelle & ...
           u(2:end) > schwelle) + 1;

pulse = t(idx);

if isempty(pulse)
    error('Keine Impulse über 5 V erkannt.');
end

% Doppelzählungen entfernen
pulseSauber = pulse(1);

for k = 2:length(pulse)
    if pulse(k)-pulseSauber(end) >= mindestAbstand
        pulseSauber(end+1,1) = pulse(k);
    end
end

pulse = pulseSauber(:);

%% 3. Impulse in Blöcke aufteilen
% Eine Pause über 5 Sekunden bedeutet: neuer Block
blockNummer = cumsum([true; diff(pulse) > 5]);
blockGroesse = accumarray(blockNummer,1);

% Gruppen mit mindestens 100 Impulsen sind echte Blöcke
echteBloecke = find(blockGroesse >= 100);

fprintf('Erkannte vollständige Blöcke: %d\n',length(echteBloecke));
disp('Impulse in allen erkannten Blöcken:');
disp(blockGroesse(echteBloecke)');

if length(echteBloecke) < 9
    error(['Es wurden nur %d vollständige Blöcke erkannt. ' ...
           'Möglicherweise wurde die falsche CSV ausgewählt.'], ...
           length(echteBloecke));
end

% Nur die ersten 9 vollständigen Blöcke
echteBloecke = echteBloecke(1:9);

%% 4. Messwerte der ersten 9 Blöcke bestimmen
messStart = zeros(9,1);
messDauer = zeros(9,1);
messImpulse = zeros(9,1);

for k = 1:9
    p = pulse(blockNummer == echteBloecke(k));

    messStart(k) = p(1);
    messImpulse(k) = length(p);

    % Blockdauer inklusive der letzten Impulsperiode
    mittlererPulsabstand = median(diff(p));
    messDauer(k) = p(end)-p(1)+mittlererPulsabstand;
end

% Erster Block wird auf 0 Sekunden gesetzt
messStart = messStart-messStart(1);

% Zeit zwischen zwei Blockstarts
messZyklus = diff(messStart);

%% 5. Künstliche Variante 1: 137 Impulse bei 4,7 Hz
f = 4.7;
N = 137;

stimDauer137 = N/f;            % 29,1489 Sekunden
ruhe137 = 30;
zyklus137 = stimDauer137+ruhe137;  % 59,1489 Sekunden

start137 = (0:8)'*zyklus137;
dauer137 = ones(9,1)*stimDauer137;

%% 6. Künstliche Variante 2: perfektes 30/30
stimDauerPerfekt = 30;
ruhePerfekt = 30;
zyklusPerfekt = 60;

startPerfekt = (0:8)'*zyklusPerfekt;
dauerPerfekt = ones(9,1)*stimDauerPerfekt;

%% 7. Zeitunterschiede berechnen
% Positiv: Messung beginnt später
% Negativ: Messung beginnt früher
messungMinus137 = messStart-start137;
messungMinusPerfekt = messStart-startPerfekt;

% Unterschied der beiden künstlichen Varianten
ideal137MinusPerfekt = start137-startPerfekt;

%% 8. Ergebnistabelle
Ergebnisse = table( ...
    (1:9)', ...
    messImpulse, ...
    messStart, ...
    start137, ...
    startPerfekt, ...
    messungMinus137, ...
    messungMinusPerfekt, ...
    ideal137MinusPerfekt, ...
    messDauer, ...
    dauer137, ...
    dauerPerfekt, ...
    'VariableNames',{ ...
    'Block', ...
    'Gemessene_Impulse', ...
    'Messung_Start_s', ...
    'Start_137_s', ...
    'Start_30_30_s', ...
    'Messung_minus_137_s', ...
    'Messung_minus_30_30_s', ...
    'Ideal137_minus_30_30_s', ...
    'Messdauer_s', ...
    'Dauer_137_s', ...
    'Dauer_30_30_s'});

disp(Ergebnisse);

%% 9. Deutlicher grafischer Vergleich
figure('Name','Zeitvergleich der 9 Blöcke', ...
       'Position',[100 100 1200 800]);

tiledlayout(2,2);

% A: Startzeiten
nexttile;

plot(1:9,messStart,'ko-','LineWidth',2,'MarkerFaceColor','k');
hold on;
plot(1:9,start137,'bo--','LineWidth',2);
plot(1:9,startPerfekt,'ro--','LineWidth',2);
hold off;

xlabel('Block');
ylabel('Startzeit [s]');
title('Wann beginnt jeder Block?');
legend('Messung','137 / 4,7 Hz','Perfektes 30/30', ...
       'Location','northwest');
grid on;
xticks(1:9);

% B: Abweichung der Messung
nexttile;

plot(1:9,messungMinus137,'bo-','LineWidth',2, ...
     'MarkerFaceColor','b');
hold on;
plot(1:9,messungMinusPerfekt,'ro-','LineWidth',2, ...
     'MarkerFaceColor','r');
yline(0,'k--');
hold off;

xlabel('Block');
ylabel('Zeitabweichung [s]');
title('Abweichung der Messung');
legend('Messung minus 137er-Variante', ...
       'Messung minus perfektes 30/30', ...
       'Location','best');
grid on;
xticks(1:9);

% C: Unterschied der beiden künstlichen Varianten
nexttile;

bar(1:9,ideal137MinusPerfekt,'FaceColor',[0.3 0.5 0.9]);
yline(0,'k--');

xlabel('Block');
ylabel('Zeitunterschied [s]');
title('137er-Variante gegenüber perfektem 30/30');
grid on;
xticks(1:9);

% D: Länge jedes Zyklus
nexttile;

bar(1:8,[messZyklus ...
         ones(8,1)*zyklus137 ...
         ones(8,1)*zyklusPerfekt]);

xlabel('Übergang zwischen den Blöcken');
ylabel('Zeit bis zum nächsten Block [s]');
title('Dauer eines vollständigen Zyklus');
legend('Messung','137 / 4,7 Hz','Perfektes 30/30', ...
       'Location','best');
grid on;
xticks(1:8);

%% 10. Wichtigste Zahlen ausgeben
fprintf('\n--- Vergleich der Blockrhythmen ---\n');
fprintf('137 / 4,7 Hz + 30 s Ruhe: %.4f s pro Zyklus\n', ...
        zyklus137);
fprintf('Perfektes 30/30:          %.4f s pro Zyklus\n', ...
        zyklusPerfekt);
fprintf('Unterschied pro Zyklus:   %.4f s\n', ...
        zyklusPerfekt-zyklus137);

fprintf('\nMittlerer gemessener Zyklus: %.4f s\n', ...
        mean(messZyklus));

fprintf('Abweichung nach Block 9:\n');
fprintf('Messung gegenüber 137er-Variante: %.4f s\n', ...
        messungMinus137(9));
fprintf('Messung gegenüber perfektem 30/30: %.4f s\n', ...
        messungMinusPerfekt(9));
fprintf('137er-Variante gegenüber 30/30: %.4f s\n', ...
        ideal137MinusPerfekt(9));

fprintf('\nTheoretische Blockfrequenzen:\n');
fprintf('137er-Variante: %.5f Hz = 1/%.4f s\n', ...
        1/zyklus137,zyklus137);
fprintf('Perfektes 30/30: %.5f Hz = 1/60 s\n', ...
        1/60);
