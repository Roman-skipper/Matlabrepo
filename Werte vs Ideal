clear; clc; close all;

% CSV-Datei anklicken
[datei, ordner] = uigetfile('*.csv', 'Wähle deine Rigol-CSV aus');
if isequal(datei,0)
    error('Keine Datei ausgewählt.');
end

% Daten direkt aus der CSV lesen
daten = readmatrix(fullfile(ordner,datei));

% Erste Spalte = Zeit, zweite Spalte = Spannung
t = daten(:,1);
u = daten(:,2);

% Ungültige Zeilen entfernen
gut = isfinite(t) & isfinite(u);
t = t(gut);
u = u(gut);

% Signal anzeigen
figure;
plot(t,u);
xlabel('Zeit [s]');
ylabel('Spannung [V]');
title('Rigol-Messung');
grid on;
