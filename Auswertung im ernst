figure

subplot(2,1,1)
plot(1:9,Verzoegerung,'o-')
yline(0,'k--')
xlabel('Wiederholung')
ylabel('Verzögerung [s]')
title('Zeitverschiebung gegenüber dem 60-s-Raster')
grid on

subplot(2,1,2)
plot(1:9,Frequenz,'o-')
yline(4.7,'r--','Soll: 4,7 Hz')
xlabel('Wiederholung')
ylabel('Frequenz [Hz]')
title('Gemessene Frequenz pro Block')
grid on





%% Einstellungen
t = RigolDS0{:,1};
u = RigolDS0{:,2};

schwelle = 5;
sollImpulse = 137;
sollFrequenz = 4.7;
sollZyklus = 60;
startBlock = 1;    % Auswahl der ersten von 9 Wiederholungen

%% Impulsanfänge erkennen
idx = find(u(1:end-1) <= schwelle & u(2:end) > schwelle) + 1;
p = t(idx);

% Treffer unter 0,18 s Abstand zusammenfassen
p = p([true; diff(p) > 0.18]);

%% Stimulationsblöcke trennen
block = cumsum([1; diff(p) > 5]);
ids = unique(block);

anzahlAlle = arrayfun(@(k) sum(block == k),ids);

% Kleine Störgruppen entfernen
ids = ids(anzahlAlle >= 50);

% Neun aufeinanderfolgende vollständige Blöcke auswählen
ids = ids(startBlock:startBlock+8);

%% Werte je Block berechnen
for k = 1:9
    q = p(block == ids(k));

    Anzahl(k,1) = length(q);
    Start(k,1) = q(1);
    Ende(k,1) = q(end);
    Dauer(k,1) = q(end)-q(1);
    Frequenz(k,1) = 1/mean(diff(q));
end

Startabstand = [NaN; diff(Start)];
Pause = [Start(2:end)-Ende(1:end-1); NaN];

% Erwartete Startzeiten bei exakt 60 Sekunden
Sollstart = Start(1)+(0:8)'*sollZyklus;
Verzoegerung = Start-Sollstart;

Ergebnis = table((1:9)',Anzahl,Start,Ende,Dauer,...
    Frequenz,Startabstand,Pause,Verzoegerung,...
    'VariableNames',{'Block','Impulse','Start_s','Ende_s',...
    'Dauer_s','Frequenz_Hz','Startabstand_s','Pause_s',...
    'Verzoegerung_s'});

disp(Ergebnis)

Fs = 100;
A = 0;

for k = 1:9
    q = p(block == ids(k));
    q = q-q(1);

    z = zeros(1,round(31*Fs));
    stellen = round(q*Fs)+1;
    stellen = stellen(stellen <= length(z));
    z(stellen) = 1;

    A = A + abs(fft(z-mean(z)));
end

A = A/9;
f = (0:length(A)-1)*Fs/length(A);

bereich = f >= 4 & f <= 5.2;
frequenzen = f(bereich);
amplituden = A(bereich);
[~,maximum] = max(amplituden);
fftFrequenz = frequenzen(maximum);

figure
plot(f,A)
xlim([0 15])
xline(4.7,'r--','Soll: 4,7 Hz')
xlabel('Frequenz [Hz]')
ylabel('FFT-Stärke')
title("FFT – stärkste Frequenz: " + fftFrequenz + " Hz")
grid on


%% FFT der 60-s-Blöcke
FsBlock = 10;                       % 10 Messpunkte pro Sekunde
zeitGesamt = 9*sollZyklus;
tb = 0:1/FsBlock:zeitGesamt-1/FsBlock;

huellkurve = zeros(size(tb));

% Stimulationszeiten als 1, Pausenzeiten als 0 darstellen
for k = 1:9
    startRelativ = Start(k)-Start(1);
    endeRelativ = Ende(k)-Start(1);

    huellkurve(tb >= startRelativ & tb <= endeRelativ) = 1;
end

% FFT berechnen
Y = abs(fft(huellkurve-mean(huellkurve)));
f = (0:length(Y)-1)*FsBlock/length(Y);

% Stärkste Frequenz im erwarteten Blockbereich suchen
bereich = f >= 0.01 & f <= 0.025;
frequenzen = f(bereich);
staerken = Y(bereich);

[~,stelle] = max(staerken);
gemesseneBlockfrequenz = frequenzen(stelle);
gemesseneBlockdauer = 1/gemesseneBlockfrequenz;

% Ergebnis anzeigen
figure
plot(f,Y)
xlim([0 0.1])
xline(1/60,'r--','Soll: 0,0167 Hz')
xlabel('Frequenz [Hz]')
ylabel('FFT-Stärke')
title('FFT der Stimulationsblöcke')
grid on

fprintf('Blockfrequenz: %.5f Hz\n',gemesseneBlockfrequenz)
fprintf('Entspricht einer Wiederholung alle %.2f Sekunden\n', ...
    gemesseneBlockdauer)
