%% SEP-FOURIERANALYSE FUER MEHRERE RIGOL-AUFNAHMEN
% MATLAB R2024a
% Mehrere Roh-CSV-Dateien auswaehlen -> einzeln analysieren -> mitteln.
%
% Ergebnis:
% 1. mittlerer zeitlicher 30S/30R-Verlauf,
% 2. gemitteltes FFT-Spektrum mit Streuung,
% 3. FFT-Kennwerte jeder Aufnahme,
% 4. Phasen-/Zeitverschiebung jeder Aufnahme.

clear; clc; close all;

%% 1. EINSTELLUNGEN
schwelle_V = 5;
minPulsabstand_s = 0.10;
blockTrennung_s = 2;
minPulseJeBlock = 100;

FsFFT = 4;             % Fuer langsamen 60-s-Blockrhythmus
FsPulse = 50;          % Fuer schnellen Impulsrhythmus um 4,6-4,7 Hz
zyklusSoll_s = 60;
stimSoll_s = 30;
anzahlBloecke = 9;
gesamtzeit_s = 540;
fSoll_Hz = 1/60;

%% 2. ORDNER MIT ALLEN RIGOL-DATEIEN AUSWAEHLEN
% Keine Mehrfachauswahl notwendig:
% Einfach den Ordner auswaehlen, in dem alle Roh-CSV-Dateien liegen.
ordner = uigetdir(pwd,...
    'Ordner mit allen Rigol-CSV-Aufnahmen auswaehlen');

if isequal(ordner,0)
    error('Kein Ordner ausgewaehlt.');
end

inhalt = dir(fullfile(ordner,'*.csv'));

if isempty(inhalt)
    error('Im ausgewaehlten Ordner wurden keine CSV-Dateien gefunden.');
end

% Nur echte Rigol-Rohdateien verwenden.
% Ergebnistabellen ohne tInc werden bereits hier aussortiert.
dateien = {};

for k = 1:numel(inhalt)
    pruefpfad = fullfile(ordner,inhalt(k).name);
    fidPruefung = fopen(pruefpfad,'r');

    if fidPruefung < 0
        continue
    end

    ersteZeile = fgetl(fidPruefung);
    fclose(fidPruefung);

    if ischar(ersteZeile) && ...
            contains(ersteZeile,'CH1') && ...
            contains(ersteZeile,'tInc')
        dateien{end+1} = inhalt(k).name; %#ok<SAGROW>
    end
end

if isempty(dateien)
    error(['Keine Rigol-Rohdatei erkannt. Die erste Zeile muss '...
           'CH1 und tInc enthalten.']);
end

dateien = sort(dateien);
nDateien = numel(dateien);

fprintf('\nOrdner: %s\n',ordner);
fprintf('%d Rigol-Aufnahme(n) automatisch gefunden:\n',nDateien);
for k = 1:nDateien
    fprintf('  %d. %s\n',k,dateien{k});
end

%% 3. SPEICHER VORBEREITEN
tFFT = (0:1/FsFFT:gesamtzeit_s-1/FsFFT)';
N = numel(tFFT);
f = FsFFT*(0:floor(N/2))/N;

tPulse = (0:1/FsPulse:gesamtzeit_s-1/FsPulse)';
NPulse = numel(tPulse);
fPulse = FsPulse*(0:floor(NPulse/2))/NPulse;

Signale = NaN(N,nDateien);
Spektren = NaN(numel(f),nDateien);
PulsSpektren = NaN(numel(fPulse),nDateien);

BloeckeGefunden = zeros(nDateien,1);
FrequenzImpulse_Hz = NaN(nDateien,1);
ZyklusMittel_s = NaN(nDateien,1);
Blockpeak_Hz = NaN(nDateien,1);
ZyklusFFT_s = NaN(nDateien,1);
Phase_Grad = NaN(nDateien,1);
Zeitverschiebung_s = NaN(nDateien,1);
Gueltig = false(nDateien,1);

ImpulseJeBlock = NaN(nDateien,anzahlBloecke);
StimdauerJeBlock = NaN(nDateien,anzahlBloecke);
PauseJeBlock = NaN(nDateien,anzahlBloecke-1);
ZyklusJeBlock = NaN(nDateien,anzahlBloecke-1);
StartfehlerJeBlock = NaN(nDateien,anzahlBloecke);

%% 4. IDEALES 30S/30R-SIGNAL
ideal = zeros(N,1);
for b = 1:anzahlBloecke
    startIdeal = (b-1)*zyklusSoll_s;
    ideal(tFFT>=startIdeal & tFFT<startIdeal+stimSoll_s) = 1;
end

xIdeal = ideal-mean(ideal);
YIdeal = fft(xIdeal);
AIdeal = abs(YIdeal/N);
AIdeal = AIdeal(1:floor(N/2)+1);
AIdeal(2:end-1) = 2*AIdeal(2:end-1);

[~,idxSoll] = min(abs(f-fSoll_Hz));
phaseIdeal = angle(YIdeal(idxSoll));

%% 5. JEDE ROHAUFNAHME EINZELN AUSWERTEN
for m = 1:nDateien
    fprintf('\n========================================\n');
    fprintf('Aufnahme %d/%d: %s\n',m,nDateien,dateien{m});
    fprintf('========================================\n');

    fid = fopen(fullfile(ordner,dateien{m}),'r');
    if fid<0
        warning('Datei konnte nicht geoeffnet werden.');
        continue
    end

    kopf = fgetl(fid);
    t0Text = regexp(kopf,'t0\s*=\s*([-+0-9.eE]+)\s*s',...
        'tokens','once');
    tIncText = regexp(kopf,'tInc\s*=\s*([-+0-9.eE]+)\s*s',...
        'tokens','once');

    if isempty(tIncText)
        fclose(fid);
        warning('tInc wurde nicht gefunden.');
        continue
    end

    tInc = str2double(tIncText{1});
    if isempty(t0Text)
        t0 = 0;
    else
        t0 = str2double(t0Text{1});
    end

    % Nur erste CSV-Spalte lesen.
    C = textscan(fid,'%f%*[^\n]',...
        'Delimiter',',','ReturnOnError',false);
    fclose(fid);

    u = C{1};
    u = u(isfinite(u));

    if isempty(u)
        warning('Keine Messwerte gefunden.');
        continue
    end

    %% Steigende Flanken erkennen
    high = u>schwelle_V;
    startIdx = find(~high(1:end-1) & high(2:end))+1;

    if isempty(startIdx)
        warning('Keine Pulse ueber %.1f V erkannt.',schwelle_V);
        clear u high C
        continue
    end

    % Sehr dicht folgende Starts als Stoerung entfernen.
    behalten = [true;diff(startIdx)*tInc>=minPulsabstand_s];
    startIdx = startIdx(behalten);
    pulszeit = t0+(startIdx-1)*tInc;

    %% Stimulationsbloecke erkennen
    blockStartPos = [1;find(diff(pulszeit)>blockTrennung_s)+1];
    blockEndPos = [blockStartPos(2:end)-1;numel(pulszeit)];
    blockGroesse = blockEndPos-blockStartPos+1;

    gueltigeBloecke = blockGroesse>=minPulseJeBlock;
    blockStartPos = blockStartPos(gueltigeBloecke);
    blockEndPos = blockEndPos(gueltigeBloecke);

    BloeckeGefunden(m) = numel(blockStartPos);

    if numel(blockStartPos)<anzahlBloecke
        warning('Nur %d statt 9 Bloecke erkannt.',...
            numel(blockStartPos));
        clear u high C startIdx pulszeit
        continue
    end

    % Es werden bewusst die ersten neun vollstaendigen Bloecke verwendet.
    blockStartPos = blockStartPos(1:anzahlBloecke);
    blockEndPos = blockEndPos(1:anzahlBloecke);

    blockStart = NaN(1,anzahlBloecke);
    blockDauer = NaN(1,anzahlBloecke);
    impulsFreqBlock = NaN(1,anzahlBloecke);

    for b = 1:anzahlBloecke
        p = pulszeit(blockStartPos(b):blockEndPos(b));
        dt = diff(p);
        dt = dt(dt>=minPulsabstand_s & dt<blockTrennung_s);

        blockStart(b) = p(1);
        ImpulseJeBlock(m,b) = numel(p);

        if ~isempty(dt)
            periode = median(dt);
            impulsFreqBlock(b) = 1/periode;
            blockDauer(b) = p(end)-p(1)+periode;
        end
    end

    if any(~isfinite(blockDauer))
        warning('Mindestens eine Blockdauer konnte nicht bestimmt werden.');
        clear u high C startIdx pulszeit
        continue
    end

    FrequenzImpulse_Hz(m) = mean(impulsFreqBlock,'omitnan');
    ZyklusMittel_s(m) = mean(diff(blockStart),'omitnan');
    StimdauerJeBlock(m,:) = blockDauer;
    ZyklusJeBlock(m,:) = diff(blockStart);
    PauseJeBlock(m,:) = diff(blockStart)-blockDauer(1:end-1);
    StartfehlerJeBlock(m,:) = ...
        blockStart-(blockStart(1)+(0:anzahlBloecke-1)*zyklusSoll_s);

    %% Auf den Beginn des ersten Blocks ausrichten
    blockStartRelativ = blockStart-blockStart(1);

    signal = zeros(N,1);
    for b = 1:anzahlBloecke
        anfang = blockStartRelativ(b);
        ende = anfang+blockDauer(b);
        signal(tFFT>=anfang & tFFT<ende) = 1;
    end

    Signale(:,m) = signal;

    %% Impulszug fuer das schnelle Spektrum um 4,6-4,7 Hz
    % Die Pulse werden als kurze Ereignisse dargestellt. Fuer die
    % Wiederholungsfrequenz ist ihre genaue Pulsbreite nicht erforderlich.
    pulsRelativ = pulszeit-blockStart(1);
    pulsRelativ = pulsRelativ(pulsRelativ>=0 & ...
        pulsRelativ<gesamtzeit_s);

    pulsSignal = zeros(NPulse,1);
    pulsPosition = round(pulsRelativ*FsPulse)+1;
    pulsPosition = pulsPosition(pulsPosition>=1 & ...
        pulsPosition<=NPulse);
    pulsSignal(unique(pulsPosition)) = 1;

    xPuls = pulsSignal-mean(pulsSignal);
    YPuls = fft(xPuls);
    APuls = abs(YPuls/NPulse);
    APuls = APuls(1:floor(NPulse/2)+1);
    APuls(2:end-1) = 2*APuls(2:end-1);
    PulsSpektren(:,m) = APuls;

    %% FFT der einzelnen Aufnahme
    x = signal-mean(signal);
    Y = fft(x);

    A = abs(Y/N);
    A = A(1:floor(N/2)+1);
    A(2:end-1) = 2*A(2:end-1);
    Spektren(:,m) = A;

    % Hauptpeak nur im Bereich der langsamen Blockfrequenz suchen.
    suchbereich = f>=0.010 & f<=0.025;
    idxBereich = find(suchbereich);
    [~,lokal] = max(A(suchbereich));
    idxPeak = idxBereich(lokal);

    Blockpeak_Hz(m) = f(idxPeak);
    ZyklusFFT_s(m) = 1/f(idxPeak);

    deltaPhase = angle(exp(1i*(angle(Y(idxSoll))-phaseIdeal)));
    Phase_Grad(m) = rad2deg(deltaPhase);
    Zeitverschiebung_s(m) = deltaPhase/(2*pi*f(idxSoll));

    Gueltig(m) = true;

    fprintf('Bloecke erkannt: %d\n',BloeckeGefunden(m));
    fprintf('Impulsfrequenz: %.4f Hz\n',FrequenzImpulse_Hz(m));
    fprintf('Mittlere Zyklusdauer: %.4f s\n',ZyklusMittel_s(m));
    fprintf('FFT-Blockpeak: %.6f Hz\n',Blockpeak_Hz(m));
    fprintf('Zyklus aus FFT: %.3f s\n',ZyklusFFT_s(m));
    fprintf('Phasenverschiebung: %.3f Grad = %.3f s\n',...
        Phase_Grad(m),Zeitverschiebung_s(m));

    clear u high C startIdx pulszeit
end

%% 6. NUR GUELTIGE AUFNAHMEN BEHALTEN
if ~any(Gueltig)
    error(['Keine Aufnahme konnte vollstaendig ausgewertet werden. '...
           'Pruefe Schwelle und Blockerkennung.']);
end

Datei = string(dateien(:));

Datei = Datei(Gueltig);
Signale = Signale(:,Gueltig);
Spektren = Spektren(:,Gueltig);
PulsSpektren = PulsSpektren(:,Gueltig);
BloeckeGefunden = BloeckeGefunden(Gueltig);
FrequenzImpulse_Hz = FrequenzImpulse_Hz(Gueltig);
ZyklusMittel_s = ZyklusMittel_s(Gueltig);
Blockpeak_Hz = Blockpeak_Hz(Gueltig);
ZyklusFFT_s = ZyklusFFT_s(Gueltig);
Phase_Grad = Phase_Grad(Gueltig);
Zeitverschiebung_s = Zeitverschiebung_s(Gueltig);
ImpulseJeBlock = ImpulseJeBlock(Gueltig,:);
StimdauerJeBlock = StimdauerJeBlock(Gueltig,:);
PauseJeBlock = PauseJeBlock(Gueltig,:);
ZyklusJeBlock = ZyklusJeBlock(Gueltig,:);
StartfehlerJeBlock = StartfehlerJeBlock(Gueltig,:);

nGueltig = sum(Gueltig);

mittelSignal = mean(Signale,2);
mittelSpektrum = mean(Spektren,2);
sdSpektrum = std(Spektren,0,2);
mittelPulsSpektrum = mean(PulsSpektren,2);

%% 7. GEMITTELTEN HAUPTPEAK BESTIMMEN
suchbereich = f>=0.010 & f<=0.025;
idxBereich = find(suchbereich);
[~,lokal] = max(mittelSpektrum(suchbereich));
idxMittelPeak = idxBereich(lokal);

mittelPeak_Hz = f(idxMittelPeak);
mittelZyklusFFT_s = 1/mittelPeak_Hz;

% Stimulationsfrequenz im erwarteten Bereich suchen
suchPuls = fPulse>=4.0 & fPulse<=5.2;
idxPulsBereich = find(suchPuls);
[~,lokalPuls] = max(mittelPulsSpektrum(suchPuls));
idxPulsPeak = idxPulsBereich(lokalPuls);
pulsPeak_Hz = fPulse(idxPulsPeak);

fprintf('\n========================================\n');
fprintf('GESAMTERGEBNIS AUS %d AUFNAHMEN\n',nGueltig);
fprintf('========================================\n');
fprintf('Soll-Blockfrequenz: %.6f Hz\n',fSoll_Hz);
fprintf('Gemittelter FFT-Peak: %.6f Hz\n',mittelPeak_Hz);
fprintf('Zyklus aus gemittelter FFT: %.3f s\n',...
    mittelZyklusFFT_s);
fprintf('FFT-Peak der Stimulationsimpulse: %.4f Hz\n',...
    pulsPeak_Hz);
fprintf('Mittlere direkte Zyklusdauer: %.3f s\n',...
    mean(ZyklusMittel_s));
fprintf('Mittlere Impulsfrequenz: %.4f Hz\n',...
    mean(FrequenzImpulse_Hz));
fprintf('Mittlere Zeitverschiebung: %.3f +/- %.3f s\n',...
    mean(Zeitverschiebung_s),std(Zeitverschiebung_s));

%% 8. ERGEBNISTABELLEN
ProAufnahme = table(Datei,BloeckeGefunden,FrequenzImpulse_Hz,...
    ZyklusMittel_s,Blockpeak_Hz,ZyklusFFT_s,...
    Phase_Grad,Zeitverschiebung_s);

Gesamt = table(nGueltig,fSoll_Hz,mittelPeak_Hz,...
    mittelZyklusFFT_s,pulsPeak_Hz,mean(ZyklusMittel_s),...
    std(ZyklusMittel_s),mean(FrequenzImpulse_Hz),...
    mean(Zeitverschiebung_s),std(Zeitverschiebung_s),...
    'VariableNames',{'N_Aufnahmen','Soll_Blockfrequenz_Hz',...
    'FFT_Peak_gemittelt_Hz','Zyklus_aus_FFT_s',...
    'FFT_Impulspeak_Hz',...
    'Zyklus_direkt_Mittel_s','Zyklus_direkt_SD_s',...
    'Impulsfrequenz_Mittel_Hz',...
    'Zeitverschiebung_Mittel_s','Zeitverschiebung_SD_s'});

disp('=== PRO AUFNAHME ===');
disp(ProAufnahme);
disp('=== GEMITTELTES ERGEBNIS ===');
disp(Gesamt);

%% 9. ABBILDUNG 1: SCHLICHTES FFT-IMPULSSPEKTRUM
fig1 = figure('Color','w','Position',[150 150 850 500]);
plot(fPulse,mittelPulsSpektrum,...
    'Color',[0.10 0.35 0.75],'LineWidth',1.8);
hold on
xline(4.7,'r--','Soll 4,7 Hz','LineWidth',1.3);
plot(pulsPeak_Hz,mittelPulsSpektrum(idxPulsPeak),...
    'ro','MarkerFaceColor','r','MarkerSize',7);
xlim([4.0 5.2]);
xlabel('Frequenz [Hz]');
ylabel('Amplitude');
title(sprintf('FFT-Impulsspektrum: Hauptpeak %.4f Hz',pulsPeak_Hz));
legend('Gemitteltes Spektrum','Sollfrequenz','Hauptpeak',...
    'Location','best');
grid on
box on

%% 10. ABBILDUNG 2: ZEITFEHLER UEBER NEUN WIEDERHOLUNGEN
fig2 = figure('Color','w','Position',[150 150 850 500]);
block = 1:anzahlBloecke;
fehlerMittel = mean(StartfehlerJeBlock,1,'omitnan');
fehlerSD = std(StartfehlerJeBlock,0,1,'omitnan');
errorbar(block,fehlerMittel,fehlerSD,'o-',...
    'Color',[0.10 0.45 0.70],...
    'MarkerFaceColor',[0.10 0.45 0.70],...
    'LineWidth',1.6,'CapSize',8);
hold on
yline(0,'k--','Idealer Zeitpunkt');
xlabel('Stimulationsblock');
ylabel('Zeitfehler [s]');
title('Zeitfehler über neun Wiederholungen');
xticks(1:9);
grid on
box on

%% 11. ABBILDUNG 3: EINFLUSS DER ERKANNTEN IMPULSZAHL
fig3 = figure('Color','w','Position',[100 120 1100 420]);
layout3 = tiledlayout(1,3,'TileSpacing','compact','Padding','compact');

impulseAlle = ImpulseJeBlock(:);
stimAlle = StimdauerJeBlock(:);

nexttile
maske = isfinite(impulseAlle) & isfinite(stimAlle);
boxchart(categorical(impulseAlle(maske)),stimAlle(maske),...
    'BoxFaceColor',[0.20 0.55 0.80]);
yline(30,'r--','Soll 30 s');
xlabel('Erkannte Impulse');
ylabel('Stimulationsdauer [s]');
title('Stimulation');
grid on

impulseUebergang = ImpulseJeBlock(:,1:end-1);

nexttile
maske = isfinite(impulseUebergang) & isfinite(PauseJeBlock);
boxchart(categorical(impulseUebergang(maske)),PauseJeBlock(maske),...
    'BoxFaceColor',[0.20 0.65 0.45]);
yline(30,'r--','Soll 30 s');
xlabel('Impulse im vorherigen Block');
ylabel('Pausendauer [s]');
title('Pause');
grid on

nexttile
maske = isfinite(impulseUebergang) & isfinite(ZyklusJeBlock);
boxchart(categorical(impulseUebergang(maske)),ZyklusJeBlock(maske),...
    'BoxFaceColor',[0.65 0.40 0.75]);
yline(60,'r--','Soll 60 s');
xlabel('Impulse im vorherigen Block');
ylabel('Zyklusdauer [s]');
title('Gesamtzyklus');
grid on

title(layout3,'Einfluss der erkannten Impulszahl');

%% 12. ABBILDUNG 4: GESAMTERGEBNIS ALLER MESSUNGEN
fig4 = figure('Color','w','Position',[100 80 1000 700]);
layout4 = tiledlayout(2,2,'TileSpacing','compact','Padding','compact');

nexttile
boxchart(FrequenzImpulse_Hz,'BoxFaceColor',[0.15 0.45 0.75]);
yline(4.7,'r--','Soll 4,7 Hz');
ylabel('Frequenz [Hz]');
title('Impulsfrequenz');
grid on

nexttile
boxchart(StimdauerJeBlock(:),'BoxFaceColor',[0.20 0.55 0.80]);
yline(30,'r--','Soll 30 s');
ylabel('Dauer [s]');
title('Stimulation');
grid on

nexttile
boxchart(PauseJeBlock(:),'BoxFaceColor',[0.20 0.65 0.45]);
yline(30,'r--','Soll 30 s');
ylabel('Dauer [s]');
title('Pause');
grid on

nexttile
boxchart(ZyklusJeBlock(:),'BoxFaceColor',[0.65 0.40 0.75]);
yline(60,'r--','Soll 60 s');
ylabel('Dauer [s]');
title('Zyklus');
grid on

title(layout4,sprintf('Gesamtergebnis aller %d Messungen',nGueltig));

%% 10. SPEICHERN
ausgabe = fullfile(ordner,'Fourier_Mehrere_Aufnahmen');
if ~exist(ausgabe,'dir')
    mkdir(ausgabe);
end

exportgraphics(fig1,fullfile(ausgabe,...
    'Abb1_FFT_Impulsspektrum.png'),'Resolution',300);
exportgraphics(fig2,fullfile(ausgabe,...
    'Abb2_Zeitfehler.png'),'Resolution',300);
exportgraphics(fig3,fullfile(ausgabe,...
    'Abb3_Einfluss_Impulszahl.png'),'Resolution',300);
exportgraphics(fig4,fullfile(ausgabe,...
    'Abb4_Gesamtergebnis.png'),'Resolution',300);
writetable(ProAufnahme,...
    fullfile(ausgabe,'FFT_Pro_Aufnahme.csv'));
writetable(Gesamt,...
    fullfile(ausgabe,'FFT_Gesamtergebnis.csv'));
save(fullfile(ausgabe,'FFT_Arbeitsbereich.mat'));

fprintf('\nFERTIG. Ergebnisse gespeichert in:\n%s\n',ausgabe);


