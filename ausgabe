fprintf('Gemessen: %.2f Impulse\n',gemesseneAenderungImpulse);
fprintf('Abweichung: %.2f %%\n',fehlerMittelungEffekt);

fprintf('\nSweepänderung:\n');
fprintf('Erwartet: %.4f s Zyklusänderung\n', ...
        erwarteteAenderungSweep);
fprintf('Gemessen: %.4f s Zyklusänderung\n', ...
        gemesseneAenderungSweep);
