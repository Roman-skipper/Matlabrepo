fprintf('Gemessen: %.4f s\n',gemesseneAenderungPause);
fprintf('Abweichung: %.2f %%\n',fehlerPauseEffekt);

fprintf('\n========================================\n');
fprintf('FFT-FREQUENZEN\n');
fprintf('========================================\n');

for m = 1:anzahlMessungen

    fprintf('%s: %.4f Hz\n', ...
        char(namen(m)), ...
        fftFrequenz(m));
end

%% Größte unerwartete Parameterwirkung

[groessterFehler,position] = max(parameterFehler);

fprintf('\n========================================\n');
fprintf('GRÖSSTE UNERWARTETE PARAMETERWIRKUNG\n');
fprintf('========================================\n');

fprintf('Parameter: %s\n',char(parameterNamen(position)));
fprintf('Relative Abweichung: %.2f %%\n',groessterFehler);

%% Normal und Sweep direkt vergleichen

startNormal = messStarts{1};
startSweep = messStarts{4};

% Beide Aufnahmen beginnen bei 0
startDifferenz = startSweep-startNormal;

zyklusNormal = diff(startNormal);
zyklusSweep = diff(startSweep);
zyklusDifferenz = zyklusSweep-zyklusNormal;

VergleichNormalSweep = table( ...
    (1:9)', ...
    startNormal, ...
    startSweep, ...
    startDifferenz, ...
    'VariableNames',{ ...
    'Block', ...
    'Start_Normal_s', ...
    'Start_Sweep_s', ...
    'Differenz_Sweep_minus_Normal_s'});

disp(VergleichNormalSweep);

figure('Name','Normal gegen Sweep');

subplot(2,1,1);

