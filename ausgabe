fprintf('Mittlere Zyklusdauer Sweep:  %.6f s\n',mean(zyklusSweep));
fprintf('Mittlerer Zyklusunterschied: %.3f ms\n', ...
        mean(zyklusDifferenz)*1000);
fprintf('Unterschied bei Block 9:     %.3f ms\n', ...
        startDifferenz(9)*1000);
