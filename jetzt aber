%% SEP: gemeinsame FFT und uebersichtliche Statistikgrafiken
% MATLAB R2024a. Komplettes Skript ohne eigene Hilfsfunktionen/Toolboxes.
% ZIP zuerst entpacken. Nur Referenz-Rohdateien mit gleichen Sollwerten waehlen.
% Alle Abschnitte gemeinsam mit Run ausfuehren.
% Erwartetes Format: CH1(V),t0 = ...s, tInc = ...s,
% danach Spannung,leere Spalte,leere Spalte.
% FFT der ImpulsANFAENGE, kein Spannungsspektrum. Beide Rhythmen werden
% im selben Ereignisspektrum dargestellt (keine zusammengesetzten Kurven).
% Stimulation hier = erster bis letzter Impulsanfang + mediane Periode.
% Pause hier = Zyklus - diese periodenbasierte Stimulation.
% Diese beiden Groessen sind abgeleitet, keine gemessenen Programmendmarker.

clear; clc; close all;

%% 1. Einstellungen
schwelle = 5;
polaritaet = 1;           % +1 positive, -1 negative Impulse
minAbstand = 0.10;       % Sekunden; gegen letzten akzeptierten Beginn
blockLuecke = 2;
minImpulse = 100;        % Auswahlregel, kein Beweis fuer Vollstaendigkeit
nBloecke = 9;
fSoll = 4.7;
zyklusSoll = 60;
FsFFT = 100;             % Nur Raster fuer Ereignisspektrum, nicht Rohdaten
portion = 1000000;       % Speichersparender CSV-Import
fGemeinsam = (0.005:0.00015:6)';

blau = [0.10 0.36 0.63];
orange = [0.86 0.40 0.15];
gruen = [0.16 0.55 0.44];
grau = [0.55 0.58 0.62];
hell = [0.79 0.84 0.89];

%% 2. Eine bis vier normale Aufnahmen auswaehlen
[dateien,ordner] = uigetfile('*.csv', ...
    'Normale Rigol-Rohaufnahmen markieren (Strg/Cmd)', 'MultiSelect','on');
if isequal(dateien,0), return; end
if ischar(dateien), dateien = {dateien}; end
dateien = dateien(:);
nM = numel(dateien);
if nM ~= 4
    warning('%d statt vier Aufnahmen ausgewaehlt. Anzahl wird korrekt ausgewiesen.',nM);
end
if any(contains(lower(string(dateien)),["frequenz","mittlung","pause","sweep"]))
    error('Bitte nur die normalen Referenzaufnahmen auswaehlen, keine Parametervarianten.');
end

Impulse = nan(nM,nBloecke);
Frequenz = nan(nM,nBloecke);
Stim = nan(nM,nBloecke);
Pause = nan(nM,nBloecke-1);
Zyklus = nan(nM,nBloecke-1);
Startfehler = nan(nM,nBloecke);
Spektren = nan(numel(fGemeinsam),nM);
Gueltig = false(nM,1);
Status = repmat("Nicht ausgewertet",nM,1);
BloeckeGefunden = zeros(nM,1);
Samples = nan(nM,1);
tInc = nan(nM,1);
VerworfeneFlanken = nan(nM,1);
RandHoch = false(nM,1);
KleineGruppen = zeros(nM,1);

%% 3. Rohdateien portionsweise lesen und Impulse erkennen
for m = 1:nM
    fprintf('\n=== %s (%d/%d) ===\n',dateien{m},m,nM);
    fid = -1;
    try
        fid = fopen(fullfile(ordner,dateien{m}),'r');
        if fid < 0, error('Datei konnte nicht geoeffnet werden.'); end
        kopf = fgetl(fid);
        if ~ischar(kopf), error('Datei ist leer.'); end
        treffer = regexpi(kopf,'t\s*inc\s*=\s*([-+0-9.eE]+)\s*s', ...
            'tokens','once');
        if isempty(treffer), error('Rigol-Kopfzeile mit tInc fehlt.'); end
        dt = str2double(treffer{1});
        if ~isfinite(dt) || dt <= 0, error('Ungueltiges tInc.'); end
        tInc(m) = dt;
        if ~ismember(polaritaet,[-1 1]), error('Polaritaet muss +1 oder -1 sein.'); end

        offset = 0; vorherHoch = false; erstesStueck = true;
        startHoch = false; idx = zeros(0,1);
        while ~feof(fid)
            C = textscan(fid,'%f%f%f',portion,'Delimiter',',', ...
                'EndOfLine','\n','EmptyValue',NaN,'ReturnOnError',false);
            u = C{1}; clear C
            if isempty(u)
                if ~feof(fid), error('CSV-Import vorzeitig unterbrochen.'); end
                break
            end
            if any(~isfinite(u))
                error('Ungueltige Samples: Datenluecken zuerst pruefen.');
            end
            high = polaritaet*u > schwelle;
            if erstesStueck
                startHoch = high(1);
                vorherHoch = high(1); % angeschnittenen Beginn nicht erfinden
                erstesStueck = false;
            end
            lokal = find(high & ~[vorherHoch; high(1:end-1)]);
            idx = [idx; offset+lokal]; %#ok<AGROW>
            vorherHoch = high(end);
            offset = offset+numel(u);
            clear u high lokal
        end
        fclose(fid); fid = -1;
        Samples(m) = offset;
        RandHoch(m) = startHoch || vorherHoch;
        if RandHoch(m)
            warning('%s: Moeglicherweise angeschnittener Randimpuls.',dateien{m});
        end
        if isempty(idx), error('Keine Impulse. Schwelle/Polaritaet pruefen.'); end

        keep = false(size(idx)); keep(1) = true; letzter = idx(1);
        for k = 2:numel(idx)
            if (idx(k)-letzter)*dt >= minAbstand
                keep(k) = true; letzter = idx(k);
            end
        end
        VerworfeneFlanken(m) = sum(~keep);
        p = (idx(keep)-1)*dt; % t0 entfaellt bei allen Zeitdifferenzen
        clear idx keep

        bs = [1;find(diff(p)>blockLuecke)+1];
        be = [bs(2:end)-1;numel(p)];
        groesse = be-bs+1;
        fprintf('Impulse aller Blockkandidaten: '); fprintf('%d ',groesse); fprintf('\n');
        ids = find(groesse>=minImpulse);
        BloeckeGefunden(m) = numel(ids);
        KleineGruppen(m) = sum(groesse<minImpulse);
        if KleineGruppen(m)>0
            warning('Kleine Gruppen nicht verwendet: auf Stoerungen/Teilbloecke pruefen.');
        end
        if numel(ids)<nBloecke, error('Nur %d geeignete Bloecke.',numel(ids)); end
        if numel(ids)>nBloecke
            warning('Mehr als neun Kandidaten: Auswahl der ersten neun pruefen.');
        end
        ids = ids(1:nBloecke);
        starts = zeros(1,nBloecke); allePulse = zeros(0,1);
        for b = 1:nBloecke
            q = p(bs(ids(b)):be(ids(b)));
            periode = median(diff(q));
            starts(b) = q(1);
            Impulse(m,b) = numel(q);
            Frequenz(m,b) = 1/periode;
            Stim(m,b) = q(end)-q(1)+periode;
            allePulse = [allePulse;q]; %#ok<AGROW>
        end
        Zyklus(m,:) = diff(starts);
        Pause(m,:) = Zyklus(m,:)-Stim(m,1:end-1);
        Startfehler(m,:) = starts-starts(1)-(0:nBloecke-1)*zyklusSoll;

        %% Eine gemeinsame Ereignisfolge fuer beide Rhythmen
        pulseRel = allePulse-starts(1);
        T = pulseRel(end); % Keine erfundene letzte Pause, kein fixes 540-s-Fenster
        n = ceil(T*FsFFT)+1;
        pos = round(pulseRel*FsFFT)+1;
        x = accumarray(pos,ones(size(pos)),[n 1],@sum,0);
        w = 0.5-0.5*cos(2*pi*(0:n-1)'/(n-1)); % Hann ohne Toolbox
        x = (x-sum(w.*x)/sum(w)).*w;
        nFFT = 2^nextpow2(8*n); % nur feinere Kurve, keine neue Aufloesung
        Y = fft(x,nFFT);
        f = (0:floor(nFFT/2))'*FsFFT/nFFT;
        leistung = abs(Y(1:numel(f))).^2;
        P = interp1(f,leistung,fGemeinsam,'linear',0);
        if any(~isfinite(P)) || max(P)<=0, error('Ungueltiges Spektrum.'); end
        Spektren(:,m) = P/max(P); % eine Normierung ueber beide Frequenzbereiche
        Gueltig(m) = true; Status(m) = "OK";
        fprintf('Frequenz %.6f Hz | Zyklus %.6f s\n', ...
            mean(Frequenz(m,:)),mean(Zyklus(m,:)));
        clear p allePulse pulseRel x w Y leistung P
    catch ME
        if fid>=0, fclose(fid); end
        Status(m) = string(ME.message);
        warning('%s: %s',dateien{m},ME.message);
    end
end

Qualitaet = table(string(dateien),Gueltig,Status,Samples,tInc, ...
    BloeckeGefunden,KleineGruppen,VerworfeneFlanken,RandHoch, ...
    'VariableNames',{'Datei','Gueltig','Status','Samples','tInc_s', ...
    'GeeigneteBlockkandidaten','KleineGruppen','VerworfeneFlanken','RandHoch'});
disp(Qualitaet);
if ~any(Gueltig), error('Keine gueltige Aufnahme. Siehe Meldungen.'); end

% Ausschliesslich vollstaendig erfolgreich ausgewertete Aufnahmen verwenden.
Datei = string(dateien(Gueltig));
Impulse = Impulse(Gueltig,:); Frequenz = Frequenz(Gueltig,:);
Stim = Stim(Gueltig,:); Pause = Pause(Gueltig,:);
Zyklus = Zyklus(Gueltig,:); Startfehler = Startfehler(Gueltig,:);
Spektren = Spektren(:,Gueltig); nG = sum(Gueltig);

%% 4. Tabellen und numerische Konsistenz
residuum = abs(Stim(:,1:end-1)+Pause-Zyklus);
assert(all(residuum(:)<1e-8),'Dauersumme inkonsistent.');
assert(all(abs(sum(Zyklus-zyklusSoll,2)-Startfehler(:,end))<1e-8), ...
    'Startfehler inkonsistent.');

ProAufnahme = table(Datei,mean(Frequenz,2),mean(Impulse,2), ...
    mean(Stim,2),median(Stim,2),mean(Pause,2),median(Pause,2), ...
    mean(Zyklus,2),median(Zyklus,2),Startfehler(:,end), ...
    nBloecke*median(Zyklus,2), ...
    'VariableNames',{'Datei','Frequenz_Mittel_Hz','Impulse_Mittel', ...
    'Stim_Mittel_s','Stim_Median_s','Pause_Mittel_s','Pause_Median_s', ...
    'Zyklus_Mittel_s','Zyklus_Median_s','Startfehler_Block9_s', ...
    'Gesamtdauer_HOCHGERECHNET_s'});

dateiSpalte = repelem(Datei,nBloecke);
blockSpalte = repmat((1:nBloecke)',nG,1);
pa = [Pause,nan(nG,1)]; zy = [Zyklus,nan(nG,1)];
Blockdaten = table(dateiSpalte,blockSpalte,reshape(Impulse',[],1), ...
    reshape(Frequenz',[],1),reshape(Stim',[],1),reshape(pa',[],1), ...
    reshape(zy',[],1),reshape(Startfehler',[],1), ...
    'VariableNames',{'Datei','Block','Impulse','Frequenz_Hz', ...
    'Stim_periodenbasiert_s','Pause_rechnerisch_s','Zyklus_s','Startfehler_s'});

parameter = ["Frequenz";"Stimulation_periodenbasiert";"Pause_rechnerisch";"Zyklus"];
einheit = ["Hz";"s";"s";"s"];
werte = {Frequenz,Stim,Pause,Zyklus};
Statistik = table;
for k = 1:4
    W = werte{k}; x = W(:);
    for ebene = 1:2
        if ebene==1
            v = x; art = "Bloecke_gepoolt";
        else
            v = mean(W,2); art = "Aufnahmemittelwerte";
        end
        sd = NaN; if numel(v)>1, sd=std(v); end
        zeile = table(parameter(k),einheit(k),art,numel(v),mean(v), ...
            median(v),sd,min(v),max(v),'VariableNames', ...
            {'Parameter','Einheit','Ebene','N','Mittelwert','Median','SD','Minimum','Maximum'});
        Statistik = [Statistik;zeile]; %#ok<AGROW>
    end
end

%% 5. Grafik 1: EINE FFT mit beiden Rhythmen
mittelP = mean(Spektren,2); medianP = median(Spektren,2);
skalierung = max(mittelP);
mittelP = mittelP/skalierung; medianP = medianP/skalierung;
bereichBlock = find(fGemeinsam>=0.010 & fGemeinsam<=0.025);
bereichStim = find(fGemeinsam>=4.0 & fGemeinsam<=5.2);
[~,k] = max(mittelP(bereichBlock)); iBlock = bereichBlock(k);
[~,k] = max(mittelP(bereichStim)); iStim = bereichStim(k);

fig1 = figure('Color','w','Position',[80 100 1100 510]);
h1 = semilogx(fGemeinsam,mittelP,'Color',blau,'LineWidth',1.7); hold on
h2 = semilogx(fGemeinsam,medianP,'--','Color',orange,'LineWidth',1.2);
xline(1/zyklusSoll,':','Color',grau,'HandleVisibility','off');
xline(fSoll,':','Color',grau,'HandleVisibility','off');
plot(fGemeinsam([iBlock iStim]),mittelP([iBlock iStim]),'o', ...
    'Color',blau,'MarkerFaceColor',blau,'HandleVisibility','off');
text(fGemeinsam(iBlock)*1.12,mittelP(iBlock)+0.07, ...
    sprintf('Blockrhythmus\n%.5f Hz',fGemeinsam(iBlock)), ...
    'Color',blau,'FontSize',11,'VerticalAlignment','bottom');
text(fGemeinsam(iStim)/1.12,mittelP(iStim)+0.06, ...
    sprintf('Peak im Impulsbereich\n%.4f Hz',fGemeinsam(iStim)), ...
    'Color',blau,'FontSize',11,'HorizontalAlignment','right','VerticalAlignment','bottom');
xlim([0.008 6]); ylim([0 max([mittelP;medianP])*1.30]);
xticks([0.01 1/60 0.05 0.1 0.5 1 4.7]);
xticklabels({'0,01','0,0167','0,05','0,1','0,5','1','4,7'});
xlabel('Frequenz [Hz] - logarithmische Achse');
ylabel('Relative spektrale Leistung');
title('Ein Spektrum: Blockrhythmus und Stimulationsimpulse');
subtitle(sprintf('%d Aufnahmen | pro Aufnahme normierte Leistung | punktierte Linien: Sollwerte',nG));
legend([h1 h2],{'Mittelwert','Median'},'Location','northwest','Box','off');
grid on; box off

%% 6. Grafik 2: Startfehler, einzelne Aufnahmen + Mittel + Median
fig2 = figure('Color','w','Position',[100 100 1000 530]); hold on
b = 1:nBloecke;
M = mean(Startfehler,1)*1000;
MD = median(Startfehler,1)*1000;
for j = 1:nG
    plot(b,Startfehler(j,:)*1000,'-','Color',hell, ...
        'LineWidth',1,'HandleVisibility','off');
end
if nG>1
    S = std(Startfehler,0,1)*1000;
    hBand = fill([b fliplr(b)],[M-S fliplr(M+S)],blau, ...
        'FaceAlpha',0.10,'EdgeColor','none');
end
hM = plot(b,M,'o-','Color',blau,'MarkerFaceColor',blau,'LineWidth',1.8);
hD = plot(b,MD,'s--','Color',orange,'MarkerFaceColor','w','LineWidth',1.5);
yline(0,':','Color',grau,'HandleVisibility','off');
if nG>1
    legend([hM hD hBand],{'Mittelwert','Median','Mittelwert +/- 1 SD'}, ...
        'Location','best','Box','off');
else
    legend([hM hD],{'Mittelwert','Median'},'Location','best','Box','off');
end
xlabel('Stimulationsblock'); ylabel('Startfehler gegen 60-s-Raster [ms]');
title('Wie veraendert sich der Zeitfehler?');
subtitle(sprintf('%d Aufnahmen | helle Linien: einzelne Aufnahmen | erster Block auf null gesetzt',nG));
xticks(b); xlim([1 nBloecke]); grid on; box off

%% 7. Grafik 3: Erkannte Impulszahlen, Einzelwerte + Box + Mittelwert
fig3 = figure('Color','w','Position',[80 100 1180 480]);
tl = tiledlayout(1,3,'TileSpacing','compact','Padding','compact');
gruppen = unique(Impulse(:));
u = Impulse(:,1:end-1);
gruppenDaten = {Impulse(:),u(:),u(:)};
yDaten = {Stim(:),Pause(:),Zyklus(:)};
namen = {'Stimulation (periodenbasiert)','Pause (rechnerisch)','Zyklus (Start zu Start)'};
farben = {blau,gruen,[0.49 0.38 0.65]};
soll = [30 30 60];
Impulsvergleich = table;
for k = 1:3
    nexttile; hold on
    g = gruppenDaten{k}; y = yDaten{k};
    [~,gx] = ismember(g,gruppen);
    boxchart(gx,y,'BoxFaceColor',farben{k},'BoxFaceAlpha',0.16, ...
        'MarkerStyle','none','HandleVisibility','off');
    labels = cell(numel(gruppen),1);
    for j = 1:numel(gruppen)
        v = y(g==gruppen(j));
        labels{j} = sprintf('%d\nn = %d',gruppen(j),numel(v));
        if isempty(v), continue; end
        jitter = 0.10*sin((1:numel(v))'*2.39996);
        scatter(j+jitter,v,17,farben{k},'filled', ...
            'MarkerFaceAlpha',0.45,'HandleVisibility','off');
        plot(j,mean(v),'d','Color',orange,'MarkerFaceColor',orange, ...
            'MarkerSize',7,'HandleVisibility','off');
        plot([j-0.17 j+0.17],[median(v) median(v)],'-', ...
            'Color',farben{k},'LineWidth',2.4,'HandleVisibility','off');
        sd=NaN; if numel(v)>1, sd=std(v); end
        neu = table(string(namen{k}),gruppen(j),numel(v),mean(v), ...
            median(v),sd,min(v),max(v),'VariableNames', ...
            {'Groesse','Impulse','N','Mittelwert_s','Median_s','SD_s','Minimum_s','Maximum_s'});
        Impulsvergleich = [Impulsvergleich;neu]; %#ok<AGROW>
    end
    yline(soll(k),':','Referenz','Color',grau,'HandleVisibility','off');
    xticks(1:numel(gruppen)); xticklabels(labels);
    xlim([0.5 numel(gruppen)+0.5]);
    xlabel('Erkannte Impulse im Block'); ylabel('Dauer [s]');
    title(namen{k}); grid on; box off
end
title(tl,'Zusammenhang mit der erkannten Impulszahl');
subtitle(tl,'Punkte: Bloecke | Raute: Mittelwert | Querstrich: Median | Box: mittlere 50 %');

%% 8. Grafik 4: Wiederholbarkeit anhand der Aufnahmemittelwerte
fig4 = figure('Color','w','Position',[100 60 1050 740]);
tl4 = tiledlayout(2,2,'TileSpacing','compact','Padding','compact');
aufnahmeWerte = {mean(Frequenz,2),mean(Stim,2),mean(Pause,2),mean(Zyklus,2)};
titel4 = {'Stimulationsfrequenz','Stimulation (periodenbasiert)', ...
    'Pause (rechnerisch)','Zyklus (Start zu Start)'};
einheiten4 = {'Hz','s','s','s'}; soll4 = [fSoll 30 30 zyklusSoll];
for k = 1:4
    nexttile; hold on
    v = aufnahmeWerte{k};
    hA = plot(1:nG,v,'o','Color',blau,'MarkerFaceColor',blau,'MarkerSize',7);
    hM = yline(mean(v),'-','Color',orange,'LineWidth',1.5);
    hD = yline(median(v),'--','Color',gruen,'LineWidth',1.5);
    hS = yline(soll4(k),':','Color',grau,'LineWidth',1.2);
    sd = NaN; if nG>1, sd=std(v); end
    title(titel4{k});
    subtitle(sprintf('Mittel %.5f | Median %.5f | SD %.5f %s', ...
        mean(v),median(v),sd,einheiten4{k}));
    ylabel(einheiten4{k}); xlabel('Aufnahme (Reihenfolge siehe CSV)');
    xticks(1:nG); xlim([0.5 nG+0.5]);
    if k==1
        legend([hA hM hD hS],{'Aufnahmemittelwert','Mittelwert','Median','Referenz'}, ...
            'Location','best','Box','off');
    end
    grid on; box off
end
title(tl4,sprintf('Vergleich der %d Aufnahmen',nG));
subtitle(tl4,'Jeder Punkt = eine Aufnahme | SD beschreibt die Streuung zwischen Aufnahmemittelwerten');

%% 9. Einheitlicher Stil und Export
figuren = [fig1 fig2 fig3 fig4];
for j = 1:numel(figuren)
    ax = findall(figuren(j),'Type','axes');
    set(ax,'FontName','Arial','FontSize',10,'LineWidth',0.8, ...
        'GridAlpha',0.10,'XMinorGrid','off','YMinorGrid','off', ...
        'TickDir','out');
end

stempel = char(datetime('now','Format','yyyyMMdd_HHmmss_SSS'));
ziel = fullfile(ordner,['SEP_Auswertung_' stempel]); mkdir(ziel);
bildnamen = {'01_FFT_gemeinsam','02_Zeitfehler','03_Impulszahlvergleich','04_Aufnahmevergleich'};
for j = 1:numel(figuren)
    exportgraphics(figuren(j),fullfile(ziel,[bildnamen{j} '.png']),'Resolution',300);
    savefig(figuren(j),fullfile(ziel,[bildnamen{j} '.fig']));
end
writetable(Qualitaet,fullfile(ziel,'01_Qualitaet.csv'));
writetable(ProAufnahme,fullfile(ziel,'02_Pro_Aufnahme.csv'));
