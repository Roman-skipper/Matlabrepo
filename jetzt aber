%% SEP: schlichte FFT ohne eigene Hilfsfunktionen
% MATLAB R2024a
% Rohdateien auswählen, NICHT die Ergebnistabellen.
% ZIP-Dateien vorher entpacken.

clear; clc; close all;

%% Einstellungen
schwelle = 5;          % Passt zur geprüften auf1.csv
polaritaet = 1;        % 1 = positive, -1 = negative Impulse
minAbstand = 0.10;     % Mindestabstand akzeptierter Impulse [s]
blockLuecke = 2;       % Blocktrennung [s]
minImpulse = 100;      % Kleine Gruppen gesondert melden
nBloecke = 9;

portion = 1000000;     % Samples pro Lesevorgang
Fs = 100;             % Nur für FFT der Ereigniszeitpunkte

fStim = linspace(3.8,5.4,5000)';
fBlock = linspace(0.005,0.05,5000)';

%% Dateien auswählen
[dateien,ordner] = uigetfile( ...
    '*.csv','Rigol-Rohaufnahmen auswählen', ...
    'MultiSelect','on');

if isequal(dateien,0)
    return
end

if ischar(dateien)
    dateien = {dateien};
end

dateien = dateien(:);
nM = numel(dateien);

spektrumStim = nan(numel(fStim),nM);
spektrumBlock = nan(numel(fBlock),nM);

frequenzZeit = nan(nM,1);
zyklusZeit = nan(nM,1);
impulszahl = nan(nM,1);
gueltig = false(nM,1);
status = repmat("Nicht ausgewertet",nM,1);

%% Jede Aufnahme einzeln lesen
for m = 1:nM

    fprintf('\nLese %s ...\n',dateien{m});
    fid = -1;

    try
        fid = fopen(fullfile(ordner,dateien{m}),'r');

        if fid < 0
            error('Datei konnte nicht geöffnet werden.');
        end

        kopf = fgetl(fid);

        if ~ischar(kopf)
            error('Datei ist leer.');
        end

        treffer = regexpi(kopf, ...
            't\s*inc\s*=\s*([-+0-9.eE]+)\s*s', ...
            'tokens','once');

        if isempty(treffer)
            error('Rigol-Kopfzeile mit tInc fehlt.');
        end

        dt = str2double(treffer{1});

        if ~isfinite(dt) || dt <= 0
            error('Ungültiges Abtastintervall.');
        end

        % t0 ist für Zeitdifferenzen und Ereignis-FFT nicht nötig.
        % Originale Samplepositionen bleiben erhalten.
        offset = 0;
        vorherHoch = false;
        ersterAbschnitt = true;
        startHoch = false;
        impulsIndizes = zeros(0,1);

        while ~feof(fid)

            % Format der geprüften Datei:
            % Spannungswert,leere Spalte,leere Spalte
            C = textscan(fid,'%f%f%f',portion, ...
                'Delimiter',',', ...
                'EndOfLine','\n', ...
                'EmptyValue',NaN, ...
                'ReturnOnError',false);

            u = C{1};
            clear C

            if isempty(u)
                if ~feof(fid)
                    error('CSV konnte nicht vollständig gelesen werden.');
                end
                break
            end

            if any(~isfinite(u))
                error(['Ungültige Spannungssamples gefunden. ' ...
                       'Datei zuerst auf Datenlücken prüfen.']);
            end

            hoch = polaritaet*u > schwelle;

            if ersterAbschnitt
                startHoch = hoch(1);

                % Ein am Dateianfang bereits hoher Puls hat
                % keinen beobachteten Beginn.
                vorherHoch = hoch(1);
                ersterAbschnitt = false;
            end

            % Übergang an der Grenze zweier Portionen mitprüfen.
            vorher = [vorherHoch; hoch(1:end-1)];
            lokal = find(hoch & ~vorher);

            impulsIndizes = [impulsIndizes; ...
                             offset + lokal]; %#ok<AGROW>

            vorherHoch = hoch(end);
            offset = offset + numel(u);

            clear u hoch vorher lokal
        end

        fclose(fid);
        fid = -1;

        if startHoch || vorherHoch
            warning('%s: Möglicherweise angeschnittener Randimpuls.', ...
                    dateien{m});
        end

        fprintf('Gelesen: %d Samples\n',offset);

        if isempty(impulsIndizes)
            error('Keine Impulse erkannt. Schwelle/Polarität prüfen.');
        end

        %% Doppelzählungen unterdrücken
        behalten = false(size(impulsIndizes));
        behalten(1) = true;
        letzter = impulsIndizes(1);

        for k = 2:numel(impulsIndizes)
            if (impulsIndizes(k)-letzter)*dt >= minAbstand
                behalten(k) = true;
                letzter = impulsIndizes(k);
            end
        end

        fprintf('Verworfene nahe Flanken: %d\n',sum(~behalten));

        p = (impulsIndizes(behalten)-1)*dt;
        clear impulsIndizes behalten

        %% Blöcke erkennen
        anfang = [1; find(diff(p)>blockLuecke)+1];
        ende = [anfang(2:end)-1; numel(p)];
        anzahl = ende-anfang+1;

        fprintf('Impulse aller Blockkandidaten:\n');
        disp(anzahl');

        ids = find(anzahl >= minImpulse);

        if any(anzahl < minImpulse)
            warning(['Kleine Gruppen ausgeschlossen. ' ...
                     'Bitte auf Teilblöcke oder Störungen prüfen.']);
        end

        if numel(ids) < nBloecke
            error('Nur %d geeignete Blöcke statt %d.', ...
                  numel(ids),nBloecke);
        end

        if numel(ids) > nBloecke
            warning('Mehr als neun Blöcke: Die ersten neun werden benutzt.');
        end

        ids = ids(1:nBloecke);

        starts = zeros(nBloecke,1);
        pulse = zeros(0,1);
        abstaende = zeros(0,1);

        for b = 1:nBloecke
            q = p(anfang(ids(b)):ende(ids(b)));

            starts(b) = q(1);
            pulse = [pulse; q]; %#ok<AGROW>
            abstaende = [abstaende; diff(q)]; %#ok<AGROW>
        end

        frequenzZeit(m) = 1/median(abstaende);
        zyklusZeit(m) = mean(diff(starts));
        impulszahl(m) = numel(pulse);

        ursprung = starts(1);
        starts = starts-ursprung;
        pulse = pulse-ursprung;

        % Nur beobachtete Zeitspanne verwenden.
        % Keine zusätzliche letzte Pause erfinden.
        T = pulse(end);

        %% Zwei FFTs: Einzelimpulse und Blockanfänge
        for art = 1:2

            if art == 1
                ereignisse = pulse;
                fZiel = fStim;
            else
                ereignisse = starts;
                fZiel = fBlock;
            end

            n = ceil(T*Fs)+1;
            position = round(ereignisse*Fs)+1;

            x = accumarray(position, ...
                ones(size(position)),[n 1],@sum,0);

            % Hann-Fenster ohne Toolbox
            fenster = 0.5-0.5*cos(2*pi*(0:n-1)'/(n-1));

            gleichanteil = sum(x.*fenster)/sum(fenster);
            x = (x-gleichanteil).*fenster;

            % Feinere Darstellung, keine höhere echte Auflösung.
            nFFT = 2^nextpow2(8*n);
            Y = fft(x,nFFT);

            k = (0:floor(nFFT/2))';
            f = k*Fs/nFFT;
            leistung = abs(Y(1:numel(k))).^2;

            P = interp1(f,leistung,fZiel,'linear',0);

            if max(P) <= 0 || any(~isfinite(P))
                error('Kein gültiges Spektrum.');
            end

            P = P/max(P);

            if art == 1
                spektrumStim(:,m) = P;
            else
                spektrumBlock(:,m) = P;
            end
        end

        gueltig(m) = true;
        status(m) = "OK";

        fprintf('Stimulationsfrequenz: %.6f Hz\n',frequenzZeit(m));
        fprintf('Mittlerer Zyklus: %.6f s\n',zyklusZeit(m));

    catch ME
        if fid >= 0
            fclose(fid);
        end

        status(m) = string(ME.message);
        warning('%s: %s',dateien{m},ME.message);
    end
end

%% Ergebnistabelle
Ergebnisse = table(string(dateien),gueltig,status, ...
    impulszahl,frequenzZeit,zyklusZeit, ...
    'VariableNames',{'Datei','Gueltig','Status', ...
    'Impulse','Frequenz_aus_Abstaenden_Hz','Zyklus_Mittel_s'});

disp(Ergebnisse);

if ~any(gueltig)
    error('Keine Aufnahme erfolgreich ausgewertet. Siehe Meldungen oben.');
end

%% Leistungsspektren mitteln
P1 = mean(spektrumStim(:,gueltig),2);
P2 = mean(spektrumBlock(:,gueltig),2);

P1 = P1/max(P1);
P2 = P2/max(P2);

[~,i1] = max(P1);
[~,i2] = max(P2);

%% Schlichte Abbildung
fig = figure('Color','w','Position',[100 150 1100 420]);

tiledlayout(1,2,'TileSpacing','compact','Padding','compact');

farbe = [0.10 0.35 0.65];

nexttile
plot(fStim,P1,'Color',farbe,'LineWidth',1.8);
hold on
xline(4.7,'--','Soll: 4,7 Hz','Color',[0.5 0.5 0.5]);
plot(fStim(i1),P1(i1),'o','Color',farbe, ...
     'MarkerFaceColor',farbe);
text(fStim(i1),1.07,sprintf('%.4f Hz',fStim(i1)), ...
     'HorizontalAlignment','center','FontWeight','bold');
xlabel('Frequenz [Hz]');
ylabel('Normierte spektrale Leistung');
title('Stimulationsimpulse');
xlim([3.8 5.4]);
ylim([0 1.18]);
grid on
box off

nexttile
plot(fBlock,P2,'Color',farbe,'LineWidth',1.8);
hold on
xline(1/60,'--','Soll: 1/60 Hz','Color',[0.5 0.5 0.5]);
plot(fBlock(i2),P2(i2),'o','Color',farbe, ...
     'MarkerFaceColor',farbe);
text(fBlock(i2),1.07,sprintf('%.5f Hz',fBlock(i2)), ...
     'HorizontalAlignment','center','FontWeight','bold');
xlabel('Frequenz [Hz]');
ylabel('Normierte spektrale Leistung');
title('Wiederholung der Blöcke');
xlim([0.008 0.026]);
ylim([0 1.18]);
grid on
box off

set(findall(fig,'Type','axes'), ...
    'FontSize',11,'FontName','Arial','GridAlpha',0.12);

sgtitle(sprintf('Ereignisspektren aus %d Aufnahme(n)',sum(gueltig)), ...
    'FontWeight','normal');

%% Export
stempel = char(datetime('now','Format','yyyyMMdd_HHmmss_SSS'));
ziel = fullfile(ordner,['SEP_FFT_' stempel]);
mkdir(ziel);

exportgraphics(fig,fullfile(ziel,'SEP_FFT.png'),'Resolution',300);
savefig(fig,fullfile(ziel,'SEP_FFT.fig'));

writetable(Ergebnisse,fullfile(ziel,'FFT_Ergebnisse.csv'));

save(fullfile(ziel,'FFT_Daten.mat'), ...
    'Ergebnisse','fStim','fBlock','P1','P2', ...
    'spektrumStim','spektrumBlock', ...
    'schwelle','polaritaet','minAbstand','blockLuecke');

fprintf('\nGespeichert unter:\n%s\n',ziel);
