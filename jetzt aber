    {'Frequenz_Hz','Mittlere_relative_Leistung','Mediane_relative_Leistung'});
writetable(FFT,fullfile(ziel,'06_FFT.csv'));
save(fullfile(ziel,'SEP_Ergebnisse.mat'),'Qualitaet','ProAufnahme', ...
    'Blockdaten','Statistik','Impulsvergleich','FFT','Spektren', ...
    'Impulse','Frequenz','Stim','Pause','Zyklus','Startfehler', ...
    'Datei','schwelle','polaritaet','minAbstand','blockLuecke', ...
    'minImpulse','nBloecke','FsFFT','fSoll','zyklusSoll');

fid = fopen(fullfile(ziel,'BITTE_LESEN.txt'),'w');
if fid>=0
    fprintf(fid,[ ...
        'Nur Referenzaufnahmen mit gleichen Einstellungen gemeinsam auswerten.\n' ...
        'FFT: ein gemeinsames Spektrum der erkannten Impulsanfaenge.\n' ...
        'Das langsame Ein-/Ausschalten des Impulszugs erzeugt den Blockrhythmus.\n' ...
        'Hann-Fenster, 100-Hz-Ereignisraster, Zero-Padding fuer feinere Darstellung.\n' ...
        'Die FFT ist kein Spannungsspektrum. Keine absolute Amplitudenaussage.\n' ...
        'Jede Aufnahme wird ueber denselben gesamten Frequenzbereich normiert.\n' ...
        'Danach werden Leistungen gemittelt; Median ist punktweise berechnet.\n' ...
        'Logarithmische x-Achse: gleiche Strecken bedeuten gleiche Frequenzverhaeltnisse.\n' ...
        'Nebenpeaks/Oberwellen werden nicht entfernt. FFT-Peaks sind keine Praezisionszeitmessung.\n' ...
        'Durch Blockunterbrechungen und Phasenlagen kann das FFT-Maximum von 1/Median(Impulsabstand) abweichen.\n' ...
        'Zeitfenster: erster bis letzter erkannter Impuls, keine erfundene letzte Pause.\n' ...
        'Stimulation: letzter minus erster Impulsbeginn plus medianer Impulsabstand.\n' ...
        'Pause: Start-zu-Start-Zyklus minus diese periodenbasierte Stimulation.\n' ...
        'Diese beiden Groessen sind abgeleitet; keine gemessenen Programmendmarker.\n' ...
        'Frequenz pro Block: Kehrwert des medianen Impulsabstands.\n' ...
        'Startfehler: relative Blockstarts minus 60-s-Raster. Block 9 umfasst acht Zyklen.\n' ...
        'Gesamtdauer: neunmal Zyklusmedian, HOCHRECHNUNG ohne letzten Endmarker.\n' ...
        'Grafik 2: SD zwischen Aufnahmen, kein Konfidenzintervall.\n' ...
        'Grafik 3: Bloecke sind innerhalb von Aufnahmen verschachtelt, nicht unabhaengige Versuche.\n' ...
