fprintf(['Erwartete Verlängerung durch eine zusätzliche ' ...
    'Mittelung: %.4f s\n'], ...
    theoretischeZeitProMittelung);

fprintf(['Gemessene Verlängerung der Stimulation: ' ...
    '%.4f s\n'], ...
    sekundenStimProMittelung);

fprintf(['Gemessene Verlängerung des Zyklus: ' ...
    '%.4f s\n'], ...
    sekundenZyklusProMittelung);

