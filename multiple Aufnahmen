%% =========================================================
% BOXPLOTS UND GESAMTES 9-MINUTEN-VERHALTEN
% ==========================================================

% Die letzte Pause ist nicht direkt messbar.
% Deshalb werden bei den Pausen nur Übergang 1 bis 8 gezeigt.

anzahlMessungen = size(stimMatrix,1);
anzahlBloecke = size(stimMatrix,2);

farben = lines(anzahlMessungen);
namen = messungsNamen;

%% =========================================================
% 1. STIMULATIONSDAUER ALS BOXPLOT
% ==========================================================

figure('Color','white', ...
    'Name','Verteilung der Stimulationsdauer');

tiledlayout(2,1);

nexttile;

xStim = repmat(1:anzahlBloecke,anzahlMessungen,1);

boxchart( ...
    xStim(:), ...
    stimMatrix(:), ...
    'BoxFaceColor',[0.30 0.60 0.85]);

hold on;

stimMittelBlock = mean(stimMatrix,1,'omitnan');
stimMedianBlock = median(stimMatrix,1,'omitnan');

plot( ...
    1:anzahlBloecke, ...
    stimMittelBlock, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'DisplayName','Mittelwert');

yline(30,'--k','Soll: 30 s');

xlabel('Stimulationsblock');
ylabel('Stimulationsdauer [s]');
title('Verteilung der Stimulationsdauer über alle Messungen');
legend('Boxplot','Mittelwert','Sollwert');
grid on;

% Median und Mittelwert separat
nexttile;

plot( ...
    1:anzahlBloecke, ...
    stimMedianBlock, ...
    '-o', ...
    'LineWidth',1.5, ...
    'DisplayName','Median');

hold on;

plot( ...
    1:anzahlBloecke, ...
    stimMittelBlock, ...
    '-d', ...
    'LineWidth',1.5, ...
    'DisplayName','Mittelwert');

yline(30,'--k','Soll: 30 s');

xlabel('Stimulationsblock');
ylabel('Stimulationsdauer [s]');
title('Median und Mittelwert der Stimulationsdauer');
legend('Location','best');
grid on;

%% =========================================================
% 2. PAUSENDAUER ALS BOXPLOT
% ==========================================================

% Nur die tatsächlich messbaren ersten 8 Pausen
pauseAuswertung = pauseMatrix(:,1:end-1);

anzahlPausen = size(pauseAuswertung,2);

figure('Color','white', ...
    'Name','Verteilung der Pausendauer');

tiledlayout(2,1);

nexttile;

xPause = repmat(1:anzahlPausen,anzahlMessungen,1);

boxchart( ...
    xPause(:), ...
    pauseAuswertung(:), ...
    'BoxFaceColor',[0.95 0.60 0.25]);

hold on;

pauseMittelBlock = ...
    mean(pauseAuswertung,1,'omitnan');

pauseMedianBlock = ...
    median(pauseAuswertung,1,'omitnan');

plot( ...
    1:anzahlPausen, ...
    pauseMittelBlock, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'DisplayName','Mittelwert');

yline(30,'--k','Soll: 30 s');

xlabel('Pause nach Stimulationsblock');
ylabel('Pausendauer [s]');
title('Verteilung der Pausendauer über alle Messungen');
legend('Boxplot','Mittelwert','Sollwert');
grid on;

nexttile;

plot( ...
    1:anzahlPausen, ...
    pauseMedianBlock, ...
    '-o', ...
    'LineWidth',1.5, ...
    'DisplayName','Median');

hold on;

plot( ...
    1:anzahlPausen, ...
    pauseMittelBlock, ...
    '-d', ...
    'LineWidth',1.5, ...
    'DisplayName','Mittelwert');

yline(30,'--k','Soll: 30 s');

xlabel('Pause nach Stimulationsblock');
ylabel('Pausendauer [s]');
title('Median und Mittelwert der Pausendauer');
legend('Location','best');
grid on;

%% =========================================================
% 3. EINZELNE STIMULATIONEN UND PAUSEN VERGLEICHEN
% ==========================================================

figure('Color','white', ...
    'Name','Einzelne Messungen im Vergleich');

tiledlayout(2,1);

% Einzelne Stimulationsblöcke
nexttile;
hold on;

for m = 1:anzahlMessungen

    plot( ...
        1:anzahlBloecke, ...
        stimMatrix(m,:), ...
        '-o', ...
        'Color',farben(m,:), ...
        'LineWidth',1.3, ...
        'DisplayName',namen(m));
end

yline(30,'--k','Soll: 30 s');

xlabel('Stimulationsblock');
ylabel('Stimulationsdauer [s]');
title('Stimulationsdauer jeder einzelnen Messung');
legend('Location','best');
grid on;

% Einzelne Pausen
nexttile;
hold on;

for m = 1:anzahlMessungen

    plot( ...
        1:anzahlPausen, ...
        pauseAuswertung(m,:), ...
        '-o', ...
        'Color',farben(m,:), ...
        'LineWidth',1.3, ...
        'DisplayName',namen(m));
end

yline(30,'--k','Soll: 30 s');

xlabel('Pause nach Stimulationsblock');
ylabel('Pausendauer [s]');
title('Pausendauer jeder einzelnen Messung');
legend('Location','best');
grid on;

%% =========================================================
% 4. FEHLERWACHSTUM ÜBER NEUN WIEDERHOLUNGEN
% ==========================================================

figure('Color','white', ...
    'Name','Fehlerwachstum über neun Blöcke');

hold on;

for m = 1:anzahlMessungen

    plot( ...
        1:anzahlBloecke, ...
        driftMatrix(m,:), ...
        '-o', ...
        'Color',farben(m,:), ...
        'LineWidth',1.5, ...
        'DisplayName',namen(m));
end

driftMedian = median(driftMatrix,1,'omitnan');
driftMittel = mean(driftMatrix,1,'omitnan');

plot( ...
    1:anzahlBloecke, ...
    driftMedian, ...
    '-ks', ...
    'LineWidth',2.5, ...
    'MarkerFaceColor','k', ...
    'DisplayName','Median aller Messungen');

plot( ...
    1:anzahlBloecke, ...
    driftMittel, ...
    '--rd', ...
    'LineWidth',2.5, ...
    'MarkerFaceColor','r', ...
    'DisplayName','Mittelwert aller Messungen');

yline(0,'--k','Idealer Beginn');

xlabel('Stimulationsblock');
ylabel('Kumulativer Zeitfehler [s]');
title('Entwicklung des Zeitfehlers über neun Blöcke');
legend('Location','best');
grid on;

%% =========================================================
% 5. GESAMTES 9-MINUTEN-VERHALTEN
% ==========================================================

% Idealer Ablauf:
% 9 x 60 Sekunden = 540 Sekunden

idealGesamtdauer = 540;

% endFehler stammt aus dem vorherigen Hauptcode.
% Die letzte Pause wurde dort mit 30 Sekunden angenommen.

gesamtDauer = idealGesamtdauer + endFehler;

figure('Color','white', ...
    'Name','Gesamtdauer der fünf Messungen');

tiledlayout(2,1);

nexttile;

balken = bar(gesamtDauer, ...
    'FaceColor',[0.35 0.70 0.45]);

hold on;
yline(540,'--k','Soll: 540 s');

xlabel('Messung');
ylabel('Geschätzte Gesamtdauer [s]');
title('Gesamtdauer der neun 30S/30R-Zyklen');

xticks(1:anzahlMessungen);
xticklabels(namen);
xtickangle(20);

grid on;

% Abweichung von 540 Sekunden
nexttile;

bar(endFehler, ...
    'FaceColor',[0.85 0.35 0.35]);

hold on;
yline(0,'--k','Ideal');

xlabel('Messung');
ylabel('Abweichung von 540 s [s]');
title('Gesamter Zeitfehler nach neun Wiederholungen');

xticks(1:anzahlMessungen);
xticklabels(namen);
xtickangle(20);

grid on;

