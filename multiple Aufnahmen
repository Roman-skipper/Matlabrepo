%% =========================================================
% EINFLUSS DER MITTELUNGEN AUF
% STIMULATION, PAUSE UND 60-S-ZYKLUS
% ==========================================================

%% Stimulationsdaten

mittelungenStim = impulsMatrix(:);
stimWerte = stimMatrix(:);

gueltig = isfinite(mittelungenStim) & isfinite(stimWerte);

mittelungenStim = mittelungenStim(gueltig);
stimWerte = stimWerte(gueltig);

%% Pausendaten
% Die Pause nach einem Block wird der Impulszahl
% dieses vorherigen Blocks zugeordnet.

mittelungenPauseMatrix = impulsMatrix(:,1:end-1);
pauseWerteMatrix = pauseMatrix(:,1:end-1);

mittelungenPause = mittelungenPauseMatrix(:);
pauseWerte = pauseWerteMatrix(:);

gueltig = isfinite(mittelungenPause) & isfinite(pauseWerte);

mittelungenPause = mittelungenPause(gueltig);
pauseWerte = pauseWerte(gueltig);

%% Zyklusdaten
% Zyklus = Beginn eines Blocks bis Beginn des nächsten Blocks.
% Deshalb gibt es bei 9 Blöcken nur 8 messbare Zyklen.

mittelungenZyklusMatrix = impulsMatrix(:,1:end-1);
zyklusWerteMatrix = zyklusMatrix(:,1:end-1);

mittelungenZyklus = mittelungenZyklusMatrix(:);
zyklusWerte = zyklusWerteMatrix(:);

gueltig = ...
    isfinite(mittelungenZyklus) & ...
    isfinite(zyklusWerte);

mittelungenZyklus = mittelungenZyklus(gueltig);
zyklusWerte = zyklusWerte(gueltig);

%% =========================================================
% GRUPPEN NACH ANZAHL DER MITTELUNGEN
% ==========================================================

alleAnzahlen = unique([
    mittelungenStim;
    mittelungenPause;
    mittelungenZyklus
]);

nGruppen = numel(alleAnzahlen);

stimMittel = nan(nGruppen,1);
stimMedian = nan(nGruppen,1);
stimStd = nan(nGruppen,1);
stimAnzahl = nan(nGruppen,1);

pauseMittel = nan(nGruppen,1);
pauseMedian = nan(nGruppen,1);
pauseStd = nan(nGruppen,1);
pauseAnzahl = nan(nGruppen,1);

zyklusMittel = nan(nGruppen,1);
zyklusMedian = nan(nGruppen,1);
zyklusStd = nan(nGruppen,1);
zyklusAnzahl = nan(nGruppen,1);

for k = 1:nGruppen

    aktuelleMittelungen = alleAnzahlen(k);

    %% Stimulation

    werte = stimWerte( ...
        mittelungenStim == aktuelleMittelungen);

    if ~isempty(werte)

        stimMittel(k) = mean(werte);
        stimMedian(k) = median(werte);
        stimStd(k) = std(werte);
        stimAnzahl(k) = numel(werte);

    end

    %% Pause

    werte = pauseWerte( ...
        mittelungenPause == aktuelleMittelungen);

    if ~isempty(werte)

        pauseMittel(k) = mean(werte);
        pauseMedian(k) = median(werte);
        pauseStd(k) = std(werte);
        pauseAnzahl(k) = numel(werte);

    end

    %% 60-Sekunden-Zyklus

    werte = zyklusWerte( ...
        mittelungenZyklus == aktuelleMittelungen);

    if ~isempty(werte)

        zyklusMittel(k) = mean(werte);
        zyklusMedian(k) = median(werte);
        zyklusStd(k) = std(werte);
        zyklusAnzahl(k) = numel(werte);

    end
end

%% =========================================================
% GEMEINSAME TABELLE
% ==========================================================

mittelungsTabelle = table( ...
    alleAnzahlen, ...
    stimAnzahl, ...
    stimMittel, ...
    stimMedian, ...
    stimStd, ...
    pauseAnzahl, ...
    pauseMittel, ...
    pauseMedian, ...
    pauseStd, ...
    zyklusAnzahl, ...
    zyklusMittel, ...
    zyklusMedian, ...
    zyklusStd, ...
    'VariableNames',{ ...
    'Mittelungen', ...
    'N_Stimulation', ...
    'Stim_Mittelwert_s', ...
    'Stim_Median_s', ...
    'Stim_Standardabweichung_s', ...
    'N_Pause', ...
    'Pause_Mittelwert_s', ...
    'Pause_Median_s', ...
    'Pause_Standardabweichung_s', ...
    'N_Zyklus', ...
    'Zyklus_Mittelwert_s', ...
    'Zyklus_Median_s', ...
    'Zyklus_Standardabweichung_s'});

fprintf('\n========================================\n');
fprintf('EINFLUSS DER MITTELUNGEN\n');
fprintf('========================================\n');

disp(mittelungsTabelle);

%% =========================================================
% GRAFIK MIT DREI BOXPLOTS
% ==========================================================

figure( ...
    'Color','white', ...
    'Name','Einfluss der Mittelungen');

tiledlayout(1,3);

%% 1. Stimulationsdauer

nexttile;

boxchart( ...
    mittelungenStim, ...
    stimWerte, ...
    'BoxFaceColor',[0.25 0.60 0.85]);

hold on;

plot( ...
    alleAnzahlen, ...
    stimMittel, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',7);

yline(30,'--k','Soll: 30 s');

xlabel('Anzahl der Mittelungen');
ylabel('Stimulationsdauer [s]');
title('Stimulation');
grid on;

%% 2. Pausendauer

nexttile;

boxchart( ...
    mittelungenPause, ...
    pauseWerte, ...
    'BoxFaceColor',[0.95 0.55 0.25]);

hold on;

plot( ...
    alleAnzahlen, ...
    pauseMittel, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',7);

yline(30,'--k','Soll: 30 s');

xlabel('Mittelungen im vorherigen Block');
ylabel('Pausendauer [s]');
title('Pause');
grid on;

%% 3. Gesamter 60-Sekunden-Zyklus

nexttile;

boxchart( ...
    mittelungenZyklus, ...
    zyklusWerte, ...
    'BoxFaceColor',[0.35 0.70 0.40]);

hold on;

plot( ...
    alleAnzahlen, ...
    zyklusMittel, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',7);

yline(60,'--k','Soll: 60 s');

xlabel('Mittelungen im vorherigen Block');
ylabel('Zyklusdauer [s]');
title('Gesamter 60-s-Zyklus');
grid on;

%% =========================================================
% VERÄNDERUNG PRO ZUSÄTZLICHER MITTELUNG
% ==========================================================

if numel(unique(mittelungenStim)) >= 2

    stimGerade = polyfit( ...
        mittelungenStim,stimWerte,1);

    sekundenStimProMittelung = stimGerade(1);

else

    sekundenStimProMittelung = NaN;

end

if numel(unique(mittelungenPause)) >= 2

    pauseGerade = polyfit( ...
        mittelungenPause,pauseWerte,1);

    sekundenPauseProMittelung = pauseGerade(1);

else

    sekundenPauseProMittelung = NaN;

end

if numel(unique(mittelungenZyklus)) >= 2

    zyklusGerade = polyfit( ...
        mittelungenZyklus,zyklusWerte,1);

    sekundenZyklusProMittelung = zyklusGerade(1);

else

    sekundenZyklusProMittelung = NaN;

end

fprintf('\nVERÄNDERUNG PRO ZUSÄTZLICHER MITTELUNG:\n');

fprintf('Stimulationsdauer: %.4f s\n', ...
    sekundenStimProMittelung);

fprintf('Pausendauer:       %.4f s\n', ...
    sekundenPauseProMittelung);

fprintf('60-s-Zyklus:       %.4f s\n', ...
    sekundenZyklusProMittelung);

%% =========================================================
% THEORETISCHER VERGLEICH
% ==========================================================

frequenzGemessen = mean(frequenzMessung,'omitnan');

theoretischeZeitProMittelung = ...
