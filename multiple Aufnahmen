clear;
clc;
close all;

%% ================= EINSTELLUNGEN =================

anzahlSollBloecke = 9;

stimSoll = 30;       % gewünschte Stimulation in Sekunden
pauseSoll = 30;      % gewünschte Pause in Sekunden
zyklusSoll = stimSoll + pauseSoll;

schwelle = -10;      % Schwelle zwischen -21 V und +1 V
positiveImpulse = true;

minImpulsabstand = 0.10;  % verhindert doppelte Zählungen
blockPauseGrenze = 2;     % große Lücke = neuer Block

%% ================= DATEIEN AUSWÄHLEN =================

[dateien, ordner] = uigetfile( ...
    '*.csv', ...
    'Rigol-CSV-Dateien auswählen', ...
    'MultiSelect', 'on');

if isequal(dateien, 0)
    error('Es wurde keine Datei ausgewählt.');
end

if ischar(dateien)
    dateien = {dateien};
end

%% ================= ALLE DATEIEN AUSWERTEN =================

for dateiNummer = 1:numel(dateien)

    dateiname = fullfile(ordner, dateien{dateiNummer});

    fprintf('\n========================================\n');
    fprintf('Datei: %s\n', dateien{dateiNummer});
    fprintf('========================================\n');

    %% CSV einlesen

    [t, u, tInc] = rigolEinlesen(dateiname);

    fprintf('Messwerte: %d\n', numel(u));
    fprintf('Zeitabstand der Messpunkte: %.9f s\n', tInc);
    fprintf('Aufnahmedauer: %.3f s\n', t(end) - t(1));

    %% Impulse erkennen

    if positiveImpulse
        impulsMaske = u > schwelle;

        impulsStartIndex = find( ...
            ~impulsMaske(1:end-1) & impulsMaske(2:end)) + 1;

        impulsEndIndex = find( ...
            impulsMaske(1:end-1) & ~impulsMaske(2:end)) + 1;
    else
        impulsMaske = u < schwelle;

        impulsStartIndex = find( ...
            ~impulsMaske(1:end-1) & impulsMaske(2:end)) + 1;

        impulsEndIndex = find( ...
            impulsMaske(1:end-1) & ~impulsMaske(2:end)) + 1;
    end

    impulsStart = t(impulsStartIndex);

    %% Doppelte Erkennungen entfernen

    if isempty(impulsStart)
        warning('Keine Impulse erkannt.');
        continue;
    end

    behalten = [true; diff(impulsStart) >= minImpulsabstand];

    impulsStart = impulsStart(behalten);
    impulsStartIndex = impulsStartIndex(behalten);

    %% Impulsbreiten berechnen

    impulsbreiten = [];

    for k = 1:numel(impulsStartIndex)

        naechstesEnde = impulsEndIndex( ...
            impulsEndIndex > impulsStartIndex(k));

        if ~isempty(naechstesEnde)

            ende = naechstesEnde(1);

            if k == numel(impulsStartIndex) || ...
                    ende < impulsStartIndex(k+1)

                breite = t(ende) - t(impulsStartIndex(k));

                if breite > 0 && breite < minImpulsabstand
                    impulsbreiten(end+1,1) = breite;
                end
            end
        end
    end

    %% Blöcke anhand der langen Pausen finden

    impulsAbstaende = diff(impulsStart);

    neuerBlock = [true; impulsAbstaende > blockPauseGrenze];

    blockNummer = cumsum(neuerBlock);

    anzahlBloeckeGesamt = max(blockNummer);

    blockStart = [];
    blockEnde = [];
    impulseProBlock = [];
    stimDauer = [];
    periodenProBlock = [];

    for b = 1:anzahlBloeckeGesamt

        pulse = impulsStart(blockNummer == b);

        % Sehr kleine Störgruppen ignorieren
        if numel(pulse) < 10
            continue;
        end

        lokalePerioden = diff(pulse);
        lokalePerioden = lokalePerioden( ...
            lokalePerioden < blockPauseGrenze);

        if isempty(lokalePerioden)
            continue;
        end

        medianPeriode = median(lokalePerioden);

        blockStart(end+1,1) = pulse(1);

        % Ende wird aus letztem Impuls plus typischer Periode geschätzt
        blockEnde(end+1,1) = pulse(end) + medianPeriode;

        impulseProBlock(end+1,1) = numel(pulse);

        stimDauer(end+1,1) = ...
            blockEnde(end) - blockStart(end);

        periodenProBlock(end+1,1) = medianPeriode;
    end

    %% Nur die ersten 9 vollständigen Blöcke verwenden

    anzahlVerwendet = min(anzahlSollBloecke, numel(blockStart));

    if anzahlVerwendet < anzahlSollBloecke
        warning('Es wurden nur %d vollständige Blöcke gefunden.', ...
            anzahlVerwendet);
    end

    blockStart = blockStart(1:anzahlVerwendet);
    blockEnde = blockEnde(1:anzahlVerwendet);
    impulseProBlock = impulseProBlock(1:anzahlVerwendet);
    stimDauer = stimDauer(1:anzahlVerwendet);
    periodenProBlock = periodenProBlock(1:anzahlVerwendet);

    %% Pausen und Zyklusdauer

    zyklusDauer = diff(blockStart);

    pauseDauer = blockStart(2:end) - blockEnde(1:end-1);

    %% Fehler berechnen

    stimFehler = stimDauer - stimSoll;
    pauseFehler = pauseDauer - pauseSoll;
    zyklusFehler = zyklusDauer - zyklusSoll;

    % Erwarteter Beginn jedes Blocks
    erwarteterStart = blockStart(1) + ...
        (0:anzahlVerwendet-1)' * zyklusSoll;

    % Positiv = Messung ist verspätet
    % Negativ = Messung ist zu früh
    kumulativerFehler = blockStart - erwarteterStart;

    %% Geschätztes Protokollende nach 9 Wiederholungen

    gemessenesEndeGeschaetzt = blockEnde(end) + pauseSoll;

    idealesEnde = blockStart(1) + ...
        anzahlVerwendet * zyklusSoll;

    endFehler = gemessenesEndeGeschaetzt - idealesEnde;

    %% Gesamtfrequenz berechnen

    gueltigeAbstaende = impulsAbstaende( ...
        impulsAbstaende < blockPauseGrenze & ...
        impulsAbstaende >= minImpulsabstand);

    frequenzAusMedian = 1 / median(gueltigeAbstaende);
    frequenzAusMittelwert = 1 / mean(gueltigeAbstaende);

    %% Ergebnistabelle pro Block

    block = (1:anzahlVerwendet)';

    pauseTabelle = nan(anzahlVerwendet,1);
    pauseTabelle(1:numel(pauseDauer)) = pauseDauer;

    zyklusTabelle = nan(anzahlVerwendet,1);
    zyklusTabelle(1:numel(zyklusDauer)) = zyklusDauer;

    pauseFehlerTabelle = nan(anzahlVerwendet,1);
    pauseFehlerTabelle(1:numel(pauseFehler)) = pauseFehler;

    zyklusFehlerTabelle = nan(anzahlVerwendet,1);
    zyklusFehlerTabelle(1:numel(zyklusFehler)) = zyklusFehler;

    ergebnisTabelle = table( ...
        block, ...
        impulseProBlock, ...
        stimDauer, ...
        stimFehler, ...
        pauseTabelle, ...
        pauseFehlerTabelle, ...
        zyklusTabelle, ...
        zyklusFehlerTabelle, ...
        kumulativerFehler, ...
        'VariableNames', { ...
        'Block', ...
        'Impulse', ...
        'Stimulationsdauer_s', ...
        'Stimulationsfehler_s', ...
        'Pausendauer_s', ...
        'Pausenfehler_s', ...
        'Zyklusdauer_s', ...
        'Zyklusfehler_s', ...
        'Kumulativer_Startfehler_s'});

    disp(ergebnisTabelle);

    %% Statistische Kennwerte

    fprintf('\n--- IMPULSABSTÄNDE ---\n');
    kennwerteAusgeben(gueltigeAbstaende, 'Impulsabstand', 's');

    fprintf('\nFrequenz aus Median: %.4f Hz\n', ...
        frequenzAusMedian);

    fprintf('Frequenz aus Mittelwert: %.4f Hz\n', ...
        frequenzAusMittelwert);

    if ~isempty(impulsbreiten)

        fprintf('\n--- IMPULSBREITEN ---\n');
        kennwerteAusgeben(impulsbreiten * 1000, ...
            'Impulsbreite', 'ms');

        fprintf('Vollständig messbare Impulse: %d von %d\n', ...
            numel(impulsbreiten), numel(impulsStart));

        fprintf('Fehlende oder unvollständige Impulse: %d\n', ...
            numel(impulsStart) - numel(impulsbreiten));
    end

    fprintf('\n--- STIMULATIONSDAUER ---\n');
    kennwerteAusgeben(stimDauer, 'Stimulationsdauer', 's');

    fprintf('\n--- PAUSENDAUER ---\n');
    kennwerteAusgeben(pauseDauer, 'Pausendauer', 's');

    fprintf('\n--- ZYKLUSDAUER ---\n');
    kennwerteAusgeben(zyklusDauer, 'Zyklusdauer', 's');

    fprintf('\n--- ERGEBNIS NACH %d BLÖCKEN ---\n', ...
        anzahlVerwendet);

    fprintf('Zeitfehler am Beginn des letzten Blocks: %.3f s\n', ...
        kumulativerFehler(end));

    fprintf('Geschätzter Fehler nach dem letzten 30S/30R-Zyklus: %.3f s\n', ...
        endFehler);

    %% ================= GRAFIKEN =================

    figure( ...
        'Name', ['SEP-Auswertung: ', dateien{dateiNummer}], ...
        'Color', 'white');

    tiledlayout(2,2);

    %% Grafik 1: Übersicht des Signals

    nexttile;

    maximalePlotPunkte = 200000;
    schritt = max(1, floor(numel(t) / maximalePlotPunkte));

    plot(t(1:schritt:end), u(1:schritt:end), 'b');
    hold on;

    yline(schwelle, '--r', 'Schwelle');

    xlabel('Zeit [s]');
    ylabel('Spannung [V]');
    title('Gesamte Messaufnahme');
    grid on;

    %% Grafik 2: Stimulations- und Pausendauer

    nexttile;

    dauerMatrix = nan(anzahlVerwendet,2);
    dauerMatrix(:,1) = stimDauer;
    dauerMatrix(1:numel(pauseDauer),2) = pauseDauer;

    bar(block, dauerMatrix);

    hold on;
    yline(30, '--k', 'Soll: 30 s');

    xlabel('Block');
    ylabel('Dauer [s]');
    title('Stimulation und Pause');
    legend('Stimulation', 'Pause', 'Sollwert');
    grid on;

    %% Grafik 3: Fehlerwachstum

    nexttile;

    plot(block, kumulativerFehler, ...
        '-o', ...
        'LineWidth', 1.5, ...
        'MarkerFaceColor', 'b');

    hold on;
    yline(0, '--k', 'Idealer Zeitpunkt');

    xlabel('Block');
    ylabel('Zeitabweichung [s]');
    title('Kumulativer Zeitfehler');
    grid on;

    %% Grafik 4: Impulsabstände

    nexttile;

    histogram(gueltigeAbstaende, 40);

    hold on;
    xline(1/frequenzAusMedian, '--r', 'Median');

    xlabel('Impulsabstand [s]');
    ylabel('Anzahl');
    title('Verteilung der Impulsabstände');
    grid on;

    %% Zusätzliche Grafik für Impulsbreiten

    if ~isempty(impulsbreiten)

        figure( ...
            'Name', ['Impulsbreiten: ', dateien{dateiNummer}], ...
            'Color', 'white');

        tiledlayout(2,1);

        nexttile;

        plot(impulsbreiten * 1000, '.');
        hold on;

        yline(median(impulsbreiten * 1000), ...
            '--r', 'Median');

        xlabel('Erkannter Impuls');
        ylabel('Impulsbreite [ms]');
        title('Impulsbreite jedes einzelnen Impulses');
        grid on;

        nexttile;

        histogram(impulsbreiten * 1000, 40);

        hold on;

        xline(median(impulsbreiten * 1000), ...
            '--r', 'Median');

        xlabel('Impulsbreite [ms]');
        ylabel('Anzahl');
        title('Verteilung der Impulsbreiten');
        grid on;
    end

    %% Ergebnistabelle speichern

    [~, kurzerName, ~] = fileparts(dateien{dateiNummer});

    ausgabeDatei = fullfile( ...
        ordner, ...
        [kurzerName, '_Auswertung.csv']);

    writetable(ergebnisTabelle, ausgabeDatei);

    fprintf('\nTabelle gespeichert unter:\n%s\n', ausgabeDatei);

end

%% ================= LOKALE FUNKTIONEN =================

function [t, u, tInc] = rigolEinlesen(dateiname)

    fid = fopen(dateiname, 'r');

    if fid == -1
        error('Datei konnte nicht geöffnet werden: %s', dateiname);
    end

    kopfzeile = fgetl(fid);

    tIncTreffer = regexp( ...
        kopfzeile, ...
        'tInc\s*=\s*([-+0-9.eE]+)\s*s', ...
        'tokens', ...
        'once');

    t0Treffer = regexp( ...
        kopfzeile, ...
        't0\s*=\s*([-+0-9.eE]+)\s*s', ...
        'tokens', ...
        'once');

    if isempty(tIncTreffer)
        fclose(fid);
        error('tInc wurde in der Kopfzeile nicht gefunden.');
    end

    tInc = str2double(tIncTreffer{1});

    if isempty(t0Treffer)
        t0 = 0;
    else
        t0 = str2double(t0Treffer{1});
    end

    daten = textscan( ...
        fid, ...
        '%f%*[^\n]', ...
        'Delimiter', ',', ...
        'ReturnOnError', false);

    fclose(fid);

    u = daten{1};
    u = u(isfinite(u));

    t = t0 + (0:numel(u)-1)' * tInc;

end

function kennwerteAusgeben(x, bezeichnung, einheit)

    x = x(isfinite(x));

    if isempty(x)
        fprintf('%s: keine gültigen Werte\n', bezeichnung);
        return;
    end

    fprintf('Anzahl:              %d\n', numel(x));
    fprintf('Mittelwert:          %.6f %s\n', mean(x), einheit);
    fprintf('Median:              %.6f %s\n', median(x), einheit);
    fprintf('Standardabweichung:  %.6f %s\n', std(x), einheit);
    fprintf('Minimum:             %.6f %s\n', min(x), einheit);
    fprintf('Maximum:             %.6f %s\n', max(x), einheit);

end
