clear;
clc;
close all;

%% =========================================================
% SOLLWERTE UND GRENZWERTE
% ==========================================================

anzahlMessungenSoll = 5;
anzahlBloeckeSoll = 9;

frequenzSoll = 4.7;
impulseSoll = 137;

stimSoll = 30;
pauseSoll = 30;
zyklusSoll = 60;

minImpulsabstand = 0.10;
blockGrenze = 2;

% Vorläufige Bewertungskriterien
grenzeFrequenzProzent = 2;
grenzeStimProzent = 2;
grenzePauseProzent = 2;
grenzeEndfehlerSekunden = 2;

%% =========================================================
% FÜNF CSV-DATEIEN AUSWÄHLEN
% ==========================================================

[dateien, ordner] = uigetfile( ...
    '*.csv', ...
    'Die fünf Wiederholungsmessungen auswählen', ...
    'MultiSelect', 'on');

if isequal(dateien,0)
    error('Es wurden keine Dateien ausgewählt.');
end

if ischar(dateien)
    dateien = {dateien};
end

anzahlDateien = numel(dateien);

if anzahlDateien ~= anzahlMessungenSoll
    warning(['Du hast %d Dateien ausgewählt. Vorgesehen sind ' ...
        'fünf Wiederholungsmessungen.'], anzahlDateien);
end

messungsNamen = erase(string(dateien(:)), ".csv");

%% =========================================================
% SPEICHER FÜR GEMEINSAME AUSWERTUNG
% ==========================================================

stimMatrix = nan(anzahlDateien, anzahlBloeckeSoll);
pauseMatrix = nan(anzahlDateien, anzahlBloeckeSoll);
zyklusMatrix = nan(anzahlDateien, anzahlBloeckeSoll);
driftMatrix = nan(anzahlDateien, anzahlBloeckeSoll);
impulsMatrix = nan(anzahlDateien, anzahlBloeckeSoll);

frequenzMessung = nan(anzahlDateien,1);
medianImpulsabstand = nan(anzahlDateien,1);
medianImpulsbreite_ms = nan(anzahlDateien,1);

vollstaendigeImpulse = nan(anzahlDateien,1);
erkannteImpulseGesamt = nan(anzahlDateien,1);
anteilVollstaendigeImpulse = nan(anzahlDateien,1);

endFehler = nan(anzahlDateien,1);
anzahlGefundeneBloecke = nan(anzahlDateien,1);

%% =========================================================
% JEDE DATEI EINLESEN UND AUSWERTEN
% ==========================================================

for m = 1:anzahlDateien

    dateiname = fullfile(ordner, dateien{m});

    fprintf('\n============================================\n');
    fprintf('MESSUNG %d: %s\n', m, dateien{m});
    fprintf('============================================\n');

    %% Datei öffnen

    fid = fopen(dateiname,'r');

    if fid == -1
        warning('Datei konnte nicht geöffnet werden.');
        continue;
    end

    kopfzeile = fgetl(fid);

    tIncTreffer = regexp( ...
        kopfzeile, ...
        'tInc\s*=\s*([-+0-9.eE]+)\s*s', ...
        'tokens', ...
        'once');

    t0Treffer = regexp( ...
        kopfzeile, ...
        't0\s*=\s*([-+0-9.eE]+)\s*s', ...
        'tokens', ...
        'once');

    if isempty(tIncTreffer)
        fclose(fid);
        warning('tInc wurde nicht gefunden.');
        continue;
    end

    tInc = str2double(tIncTreffer{1});

    if isempty(t0Treffer)
        t0 = 0;
    else
        t0 = str2double(t0Treffer{1});
    end

    daten = textscan( ...
        fid, ...
        '%f%*[^\n]', ...
        'Delimiter', ',', ...
        'ReturnOnError', false);

    fclose(fid);

    u = daten{1};
    u = u(isfinite(u));

    if isempty(u)
        warning('Keine Messwerte gefunden.');
        continue;
    end

    t = t0 + (0:numel(u)-1)' .* tInc;

    fprintf('Messwerte: %d\n', numel(u));
    fprintf('Aufnahmedauer: %.3f s\n', t(end)-t(1));

    %% Automatische Schwelle

    grundniveau = median(u);
    minimum = min(u);
    maximum = max(u);

    if maximum-grundniveau >= grundniveau-minimum

        schwelle = (grundniveau+maximum)/2;
        impulsMaske = u > schwelle;

    else

        schwelle = (grundniveau+minimum)/2;
        impulsMaske = u < schwelle;

    end

    fprintf('Automatische Schwelle: %.3f V\n', schwelle);

    %% Impulsanfänge und Impulsenden

    startIndex = find( ...
        ~impulsMaske(1:end-1) & impulsMaske(2:end)) + 1;

    endeIndex = find( ...
        impulsMaske(1:end-1) & ~impulsMaske(2:end)) + 1;

    startZeit = t(startIndex);

    if isempty(startZeit)
        warning('Keine Impulse erkannt.');
        continue;
    end

    %% Doppelte Flanken entfernen

    behalten = [true; diff(startZeit) >= minImpulsabstand];

    startZeit = startZeit(behalten);
    startIndex = startIndex(behalten);

    erkannteImpulseGesamt(m) = numel(startZeit);

    %% Impulsbreiten bestimmen

    impulsbreiten = [];
    endeZeiger = 1;

    for k = 1:numel(startIndex)

        while endeZeiger <= numel(endeIndex) && ...
                endeIndex(endeZeiger) <= startIndex(k)

            endeZeiger = endeZeiger + 1;
        end

        if endeZeiger > numel(endeIndex)
            break;
        end

        aktuellesEnde = endeIndex(endeZeiger);

        if k < numel(startIndex)
            endeIstGueltig = ...
                aktuellesEnde < startIndex(k+1);
        else
            endeIstGueltig = true;
        end

        if endeIstGueltig

            breite = t(aktuellesEnde)-t(startIndex(k));

            if breite > 0 && breite < minImpulsabstand
                impulsbreiten(end+1,1) = breite;
            end
        end
    end

    vollstaendigeImpulse(m) = numel(impulsbreiten);

    anteilVollstaendigeImpulse(m) = ...
        100*vollstaendigeImpulse(m)/erkannteImpulseGesamt(m);

    if ~isempty(impulsbreiten)
        medianImpulsbreite_ms(m) = ...
            median(impulsbreiten)*1000;
    end

    %% Frequenz bestimmen

    abstaende = diff(startZeit);

    gueltigeAbstaende = abstaende( ...
        abstaende >= minImpulsabstand & ...
        abstaende < blockGrenze);

    if isempty(gueltigeAbstaende)
        warning('Keine gültigen Impulsabstände gefunden.');
        continue;
    end

    medianImpulsabstand(m) = median(gueltigeAbstaende);
    frequenzMessung(m) = 1/medianImpulsabstand(m);

    %% Blöcke finden

    neuerBlock = [true; diff(startZeit) > blockGrenze];
    blockNummer = cumsum(neuerBlock);

    gruppenAnzahl = max(blockNummer);

    alleStarts = [];
    alleEnden = [];
    alleStimDauern = [];
    alleImpulseProBlock = [];

    for b = 1:gruppenAnzahl

        pulse = startZeit(blockNummer == b);

        % Kleine Störgruppen ignorieren
        if numel(pulse) < 10
            continue;
        end

        lokaleAbstaende = diff(pulse);

        lokaleAbstaende = lokaleAbstaende( ...
            lokaleAbstaende >= minImpulsabstand & ...
            lokaleAbstaende < blockGrenze);

        if isempty(lokaleAbstaende)
            continue;
        end

        lokalePeriode = median(lokaleAbstaende);

        blockStart = pulse(1);

        % Ende aus letztem Impuls plus einer Periode schätzen
        blockEnde = pulse(end)+lokalePeriode;

        alleStarts(end+1,1) = blockStart;
        alleEnden(end+1,1) = blockEnde;

        alleStimDauern(end+1,1) = ...
            blockEnde-blockStart;

        alleImpulseProBlock(end+1,1) = numel(pulse);
    end

    anzahlGefundeneBloecke(m) = numel(alleStarts);

    if isempty(alleStarts)
        warning('Keine vollständigen Blöcke gefunden.');
        continue;
    end

    %% Beste zusammenhängende Folge aus 9 Blöcken wählen

    if numel(alleStarts) > anzahlBloeckeSoll

        anzahlFenster = ...
            numel(alleStarts)-anzahlBloeckeSoll+1;

        fensterBewertung = nan(anzahlFenster,1);

        for f = 1:anzahlFenster

            indizes = f:f+anzahlBloeckeSoll-1;

            testStim = alleStimDauern(indizes);
            testZyklus = diff(alleStarts(indizes));

            fensterBewertung(f) = ...
                mean(abs(testStim-stimSoll)) + ...
                mean(abs(testZyklus-zyklusSoll));
        end

        [~, besterStart] = min(fensterBewertung);

        auswahl = ...
            besterStart:besterStart+anzahlBloeckeSoll-1;

    else

        auswahl = 1:numel(alleStarts);

    end

    blockStart = alleStarts(auswahl);
    blockEnde = alleEnden(auswahl);
    stimDauer = alleStimDauern(auswahl);

    impulseProBlock = ...
        alleImpulseProBlock(auswahl);

    anzahlVerwendet = numel(blockStart);

    %% Pausen, Zyklen und Drift

    if anzahlVerwendet >= 2

        zyklusDauer = diff(blockStart);

        pauseDauer = ...
            blockStart(2:end)-blockEnde(1:end-1);

    else

        zyklusDauer = [];
        pauseDauer = [];

    end

    erwarteterStart = blockStart(1) + ...
        (0:anzahlVerwendet-1)'*zyklusSoll;

    drift = blockStart-erwarteterStart;

    % Letzte Pause ist nicht sichtbar und wird mit 30 s geschätzt
    geschaetztesEnde = blockEnde(end)+pauseSoll;

    idealesEnde = ...
        blockStart(1)+anzahlVerwendet*zyklusSoll;

    endFehler(m) = geschaetztesEnde-idealesEnde;

    %% Daten in gemeinsame Matrizen schreiben

    stimMatrix(m,1:anzahlVerwendet) = stimDauer;
    driftMatrix(m,1:anzahlVerwendet) = drift;

    impulsMatrix(m,1:anzahlVerwendet) = ...
        impulseProBlock;

    if ~isempty(pauseDauer)
        pauseMatrix(m,1:numel(pauseDauer)) = pauseDauer;
    end

    if ~isempty(zyklusDauer)
        zyklusMatrix(m,1:numel(zyklusDauer)) = zyklusDauer;
    end

    fprintf('Verwendete Blöcke: %d\n', anzahlVerwendet);
    fprintf('Frequenz: %.4f Hz\n', frequenzMessung(m));
    fprintf('Endfehler: %.3f s\n', endFehler(m));
    fprintf('Vollständige Impulse: %.2f %%\n', ...
        anteilVollstaendigeImpulse(m));

    clear t u impulsMaske startZeit;
end

%% =========================================================
% KENNWERTE PRO MESSUNG
% ==========================================================

stimMittel = mean(stimMatrix,2,'omitnan');
stimMedian = median(stimMatrix,2,'omitnan');
stimStd = std(stimMatrix,0,2,'omitnan');

pauseMittel = mean(pauseMatrix,2,'omitnan');
pauseMedian = median(pauseMatrix,2,'omitnan');
pauseStd = std(pauseMatrix,0,2,'omitnan');

zyklusMittel = mean(zyklusMatrix,2,'omitnan');
zyklusMedian = median(zyklusMatrix,2,'omitnan');
zyklusStd = std(zyklusMatrix,0,2,'omitnan');

impulseMittel = mean(impulsMatrix,2,'omitnan');
impulseMedian = median(impulsMatrix,2,'omitnan');

frequenzAbweichungProzent = ...
    100*(frequenzMessung-frequenzSoll)/frequenzSoll;

stimAbweichungProzent = ...
    100*(stimMittel-stimSoll)/stimSoll;

pauseAbweichungProzent = ...
    100*(pauseMittel-pauseSoll)/pauseSoll;

zyklusAbweichungProzent = ...
    100*(zyklusMittel-zyklusSoll)/zyklusSoll;

%% =========================================================
% GEMEINSAME ERGEBNISTABELLE
% ==========================================================

vergleichsTabelle = table( ...
    messungsNamen, ...
    anzahlGefundeneBloecke, ...
    frequenzMessung, ...
    frequenzAbweichungProzent, ...
    impulseMittel, ...
    impulseMedian, ...
    stimMittel, ...
    stimMedian, ...
    stimStd, ...
    pauseMittel, ...
    pauseMedian, ...
    pauseStd, ...
    zyklusMittel, ...
    zyklusMedian, ...
    zyklusStd, ...
    medianImpulsbreite_ms, ...
    anteilVollstaendigeImpulse, ...
    endFehler, ...
    'VariableNames', { ...
    'Messung', ...
    'Gefundene_Bloecke', ...
    'Frequenz_Hz', ...
    'Frequenzabweichung_Prozent', ...
    'Impulse_Mittelwert', ...
    'Impulse_Median', ...
    'Stim_Mittelwert_s', ...
    'Stim_Median_s', ...
    'Stim_Standardabweichung_s', ...
    'Pause_Mittelwert_s', ...
    'Pause_Median_s', ...
    'Pause_Standardabweichung_s', ...
    'Zyklus_Mittelwert_s', ...
    'Zyklus_Median_s', ...
    'Zyklus_Standardabweichung_s', ...
    'Median_Impulsbreite_ms', ...
    'Vollstaendige_Impulse_Prozent', ...
    'Geschaetzter_Endfehler_s'});

fprintf('\n\n============================================\n');
fprintf('VERGLEICH ALLER MESSUNGEN\n');
fprintf('============================================\n');

disp(vergleichsTabelle);

%% =========================================================
% REPRODUZIERBARKEIT ÜBER ALLE MESSUNGEN
% ==========================================================

frequenzGesamtMittel = mean(frequenzMessung,'omitnan');
frequenzGesamtStd = std(frequenzMessung,'omitnan');

frequenzCV = ...
    100*frequenzGesamtStd/frequenzGesamtMittel;

stimGesamtMittel = mean(stimMittel,'omitnan');
stimGesamtStd = std(stimMittel,'omitnan');

pauseGesamtMittel = mean(pauseMittel,'omitnan');
pauseGesamtStd = std(pauseMittel,'omitnan');

zyklusGesamtMittel = mean(zyklusMittel,'omitnan');
zyklusGesamtStd = std(zyklusMittel,'omitnan');

maximalerEndfehler = ...
    max(abs(endFehler),[],'omitnan');

mittlererEndfehler = ...
    mean(abs(endFehler),'omitnan');

fprintf('\n--- REPRODUZIERBARKEIT ---\n');

fprintf('Frequenz über alle Messungen: %.4f ± %.4f Hz\n', ...
    frequenzGesamtMittel, frequenzGesamtStd);

fprintf('Variationskoeffizient der Frequenz: %.3f %%\n', ...
    frequenzCV);

fprintf('Stimulationsdauer: %.4f ± %.4f s\n', ...
    stimGesamtMittel, stimGesamtStd);

fprintf('Pausendauer: %.4f ± %.4f s\n', ...
    pauseGesamtMittel, pauseGesamtStd);

fprintf('Zyklusdauer: %.4f ± %.4f s\n', ...
    zyklusGesamtMittel, zyklusGesamtStd);

fprintf('Mittlerer absoluter Endfehler: %.3f s\n', ...
    mittlererEndfehler);

fprintf('Größter absoluter Endfehler: %.3f s\n', ...
    maximalerEndfehler);

%% =========================================================
% VORLÄUFIGE SYSTEMBEWERTUNG
% ==========================================================

kriteriumFrequenz = ...
    mean(abs(frequenzAbweichungProzent),'omitnan') ...
    <= grenzeFrequenzProzent;

kriteriumStim = ...
    mean(abs(stimAbweichungProzent),'omitnan') ...
    <= grenzeStimProzent;

kriteriumPause = ...
    mean(abs(pauseAbweichungProzent),'omitnan') ...
    <= grenzePauseProzent;

kriteriumEndfehler = ...
    maximalerEndfehler <= grenzeEndfehlerSekunden;

anzahlErfuellteKriterien = sum([ ...
    kriteriumFrequenz, ...
    kriteriumStim, ...
    kriteriumPause, ...
    kriteriumEndfehler]);

fprintf('\n--- VORLÄUFIGE BEWERTUNG ---\n');

fprintf('Frequenzkriterium erfüllt: %s\n', ...
    string(kriteriumFrequenz));

fprintf('Stimulationskriterium erfüllt: %s\n', ...
    string(kriteriumStim));

fprintf('Pausenkriterium erfüllt: %s\n', ...
    string(kriteriumPause));

fprintf('Endfehlerkriterium erfüllt: %s\n', ...
    string(kriteriumEndfehler));

if anzahlErfuellteKriterien == 4

    fprintf(['ERGEBNIS: Das System arbeitet unter den festgelegten ' ...
        'Grenzwerten zeitlich stabil und reproduzierbar.\n']);

elseif anzahlErfuellteKriterien >= 2

    fprintf(['ERGEBNIS: Das System ist teilweise reproduzierbar. ' ...
        'Einzelne zeitliche Parameter weichen jedoch ab.\n']);

else

    fprintf(['ERGEBNIS: Das System erfüllt die vorläufigen ' ...
        'Stabilitätskriterien nicht ausreichend.\n']);

end

