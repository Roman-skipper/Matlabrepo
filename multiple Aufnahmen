%% =========================================================
% ZUSAMMENGEFASSTE AUSWERTUNG
% Keine einzelnen Messungen oder Blöcke
% ==========================================================

% Alle Werte untereinander schreiben
alleMittelungen = impulsMatrix(:);
alleStimDauern = stimMatrix(:);
allePausen = pauseMatrix(:);

%% Nur gültige Stimulationswerte

gueltigStim = ...
    isfinite(alleMittelungen) & ...
    isfinite(alleStimDauern);

mittelungenStim = alleMittelungen(gueltigStim);
stimDauerGesamt = alleStimDauern(gueltigStim);

%% Nur gültige Pausenwerte

gueltigPause = ...
    isfinite(alleMittelungen) & ...
    isfinite(allePausen);

mittelungenPause = alleMittelungen(gueltigPause);
pauseDauerGesamt = allePausen(gueltigPause);

%% =========================================================
% GESAMTSTATISTIK
% ==========================================================

fprintf('\n========================================\n');
fprintf('ZUSAMMENGEFASSTE AUSWERTUNG\n');
fprintf('========================================\n');

fprintf('\nSTIMULATIONSDAUER ALLER BLÖCKE:\n');
fprintf('Anzahl:              %d\n',numel(stimDauerGesamt));
fprintf('Mittelwert:          %.4f s\n',mean(stimDauerGesamt));
fprintf('Median:              %.4f s\n',median(stimDauerGesamt));
fprintf('Standardabweichung:  %.4f s\n',std(stimDauerGesamt));
fprintf('Minimum:             %.4f s\n',min(stimDauerGesamt));
fprintf('Maximum:             %.4f s\n',max(stimDauerGesamt));

fprintf('\nPAUSENDAUER ALLER BLÖCKE:\n');
fprintf('Anzahl:              %d\n',numel(pauseDauerGesamt));
fprintf('Mittelwert:          %.4f s\n',mean(pauseDauerGesamt));
fprintf('Median:              %.4f s\n',median(pauseDauerGesamt));
fprintf('Standardabweichung:  %.4f s\n',std(pauseDauerGesamt));
fprintf('Minimum:             %.4f s\n',min(pauseDauerGesamt));
fprintf('Maximum:             %.4f s\n',max(pauseDauerGesamt));

%% =========================================================
% AUSWERTUNG NACH ANZAHL DER MITTELUNGEN
% ==========================================================

verschiedeneMittelungen = unique(mittelungenStim);

anzahlGruppe = nan(size(verschiedeneMittelungen));
stimMittelGruppe = nan(size(verschiedeneMittelungen));
stimMedianGruppe = nan(size(verschiedeneMittelungen));
stimStdGruppe = nan(size(verschiedeneMittelungen));

pauseMittelGruppe = nan(size(verschiedeneMittelungen));
pauseMedianGruppe = nan(size(verschiedeneMittelungen));
pauseStdGruppe = nan(size(verschiedeneMittelungen));

for k = 1:numel(verschiedeneMittelungen)

    aktuelleAnzahl = verschiedeneMittelungen(k);

    stimWerte = stimDauerGesamt( ...
        mittelungenStim == aktuelleAnzahl);

    pauseWerte = pauseDauerGesamt( ...
        mittelungenPause == aktuelleAnzahl);

    anzahlGruppe(k) = numel(stimWerte);

    stimMittelGruppe(k) = mean(stimWerte);
    stimMedianGruppe(k) = median(stimWerte);
    stimStdGruppe(k) = std(stimWerte);

    if ~isempty(pauseWerte)

        pauseMittelGruppe(k) = mean(pauseWerte);
        pauseMedianGruppe(k) = median(pauseWerte);
        pauseStdGruppe(k) = std(pauseWerte);

    end
end

gruppenTabelle = table( ...
    verschiedeneMittelungen, ...
    anzahlGruppe, ...
    stimMittelGruppe, ...
    stimMedianGruppe, ...
    stimStdGruppe, ...
    pauseMittelGruppe, ...
    pauseMedianGruppe, ...
    pauseStdGruppe, ...
    'VariableNames',{ ...
    'Anzahl_Mittelungen', ...
    'Anzahl_Bloecke', ...
    'Stim_Mittelwert_s', ...
    'Stim_Median_s', ...
    'Stim_Standardabweichung_s', ...
    'Pause_Mittelwert_s', ...
    'Pause_Median_s', ...
    'Pause_Standardabweichung_s'});

fprintf('\nAUSWERTUNG NACH ANZAHL DER MITTELUNGEN:\n');
disp(gruppenTabelle);

%% =========================================================
% ZUSAMMENHANG MITTELUNGEN UND STIMULATIONSDAUER
% ==========================================================

if numel(unique(mittelungenStim)) >= 2

    korrelationStim = corrcoef( ...
        mittelungenStim, ...
        stimDauerGesamt);

    rStim = korrelationStim(1,2);

    stimGerade = polyfit( ...
        mittelungenStim, ...
        stimDauerGesamt,1);

    sekundenProMittelung = stimGerade(1);

else

    rStim = NaN;
    sekundenProMittelung = NaN;

end

%% Zusammenhang Mittelungen und Pause

if numel(unique(mittelungenPause)) >= 2

    korrelationPause = corrcoef( ...
        mittelungenPause, ...
        pauseDauerGesamt);

    rPause = korrelationPause(1,2);

    pauseGerade = polyfit( ...
        mittelungenPause, ...
        pauseDauerGesamt,1);

    sekundenPauseProMittelung = pauseGerade(1);

else

    rPause = NaN;
    sekundenPauseProMittelung = NaN;

end

fprintf('\nZUSAMMENHÄNGE:\n');

fprintf(['Veränderung der Stimulationsdauer pro zusätzlicher ' ...
    'Mittelung: %.4f s\n'],sekundenProMittelung);

fprintf('Korrelation Mittelungen/Stimulationsdauer: %.4f\n', ...
    rStim);

fprintf(['Veränderung der Pause pro zusätzlicher ' ...
    'Mittelung: %.4f s\n'],sekundenPauseProMittelung);

fprintf('Korrelation Mittelungen/Pausendauer: %.4f\n', ...
    rPause);

%% =========================================================
% GRAFIK 1: BOXPLOTS NACH ANZAHL DER MITTELUNGEN
% ==========================================================

figure( ...
    'Color','white', ...
    'Name','Einfluss der Mittelungen');

tiledlayout(1,2);

% Stimulationsdauer
nexttile;

boxchart( ...
    mittelungenStim, ...
    stimDauerGesamt, ...
    'BoxFaceColor',[0.25 0.60 0.85]);

hold on;

plot( ...
    verschiedeneMittelungen, ...
    stimMittelGruppe, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',7);

yline(30,'--k','Soll: 30 s');

xlabel('Anzahl der Mittelungen/Impulse');
ylabel('Stimulationsdauer [s]');
title('Stimulationsdauer abhängig von Mittelungen');
grid on;

% Pausendauer
nexttile;

boxchart( ...
    mittelungenPause, ...
    pauseDauerGesamt, ...
    'BoxFaceColor',[0.95 0.55 0.25]);

hold on;

plot( ...
    verschiedeneMittelungen, ...
    pauseMittelGruppe, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',7);

yline(30,'--k','Soll: 30 s');

xlabel('Mittelungen im vorherigen Block');
ylabel('Pausendauer [s]');
title('Pausendauer abhängig von Mittelungen');
grid on;

%% =========================================================
% GRAFIK 2: GESAMTVERTEILUNG STIMULATION UND PAUSE
% ==========================================================

figure( ...
    'Color','white', ...
    'Name','Gesamtverteilung');

werteGesamt = [
    stimDauerGesamt;
    pauseDauerGesamt
];

gruppenGesamt = [
    repmat("Stimulation",numel(stimDauerGesamt),1);
    repmat("Pause",numel(pauseDauerGesamt),1)
];

boxchart( ...
    categorical(gruppenGesamt), ...
    werteGesamt);

hold on;

gesamtMittelwerte = [
    mean(stimDauerGesamt), ...
    mean(pauseDauerGesamt)
];

plot( ...
    categorical(["Stimulation","Pause"]), ...
    gesamtMittelwerte, ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',8);

yline(30,'--k','Soll: 30 s');

ylabel('Dauer [s]');
title('Gesamtvergleich von Stimulation und Pause');
grid on;

%% =========================================================
% GRAFIK 3: GESAMTER 9-MINUTEN-ABLAUF
% ==========================================================

idealGesamtdauer = 540;

% endFehler wurde im Hauptprogramm berechnet
gesamtDauer = idealGesamtdauer + endFehler;

gesamtDauer = gesamtDauer(isfinite(gesamtDauer));

figure( ...
    'Color','white', ...
    'Name','Gesamter 9-Minuten-Ablauf');

boxchart( ...
    ones(size(gesamtDauer)), ...
    gesamtDauer, ...
    'BoxFaceColor',[0.40 0.70 0.45]);

hold on;

plot( ...
    1, ...
    mean(gesamtDauer), ...
    'rd', ...
    'MarkerFaceColor','r', ...
    'MarkerSize',8);

yline(540,'--k','Soll: 540 s');

xlim([0.5 1.5]);
xticks(1);
xticklabels({'Alle Messungen'});

ylabel('Geschätzte Gesamtdauer [s]');
title('Gesamtdauer von neun 30S/30R-Zyklen');
grid on;

%% =========================================================
% GESAMTDAUER AUSGEBEN
% ==========================================================

fprintf('\nGESAMTER 9-MINUTEN-ABLAUF:\n');
fprintf('Sollwert:             540.0000 s\n');
fprintf('Mittelwert:           %.4f s\n',mean(gesamtDauer));
fprintf('Median:               %.4f s\n',median(gesamtDauer));
fprintf('Standardabweichung:   %.4f s\n',std(gesamtDauer));

fprintf('Mittlere Abweichung:  %.4f s\n', ...
    mean(gesamtDauer)-540);

fprintf('Größte Abweichung:    %.4f s\n', ...
    max(abs(gesamtDauer-540)));

%% Tabelle speichern

ausgabeDatei = fullfile( ...
    ordner, ...
    'Gesamtauswertung_nach_Mittelungen.csv');

writetable(gruppenTabelle,ausgabeDatei);

fprintf('\nTabelle gespeichert unter:\n%s\n',ausgabeDatei);
