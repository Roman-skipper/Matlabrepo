clear; close all; clc

M = readmatrix('auf1.csv','NumHeaderLines',1);
y = M(:,1);
y = y(isfinite(y));

fs = 100000;
N = length(y);
Y = fft(y-mean(y));

k = 2:floor(N/2);
f = (k-1)*fs/N;
A = 2*abs(Y(k))/N;
phi = rad2deg(angle(Y(k)));

% Peak bei 4,6 Hz und den drei Oberwellen suchen
fZiel = 4.6*(1:4);
peak = zeros(size(fZiel));

for n = 1:4
    bereich = abs(f-fZiel(n)) < 0.5;
    stellen = find(bereich);
    [~,p] = max(A(bereich));
    peak(n) = stellen(p);
end

figure;

subplot(2,1,1)
plot(f,A)
xlim([0 20])
ylabel('Amplitude')
grid on

subplot(2,1,2)
stem(f(peak),phi(peak),'filled')
xlim([0 20])
ylim([-180 180])
xlabel('Frequenz [Hz]')
ylabel('Phase [°]')
grid on
