M = readmatrix('auf1.csv','NumHeaderLines',1);
y = M(:,1);
y = y(isfinite(y));

fs = 100000;
N = length(y);
Y = fft(y-mean(y));

k = 2:floor(N/2);
f = (k-1)*fs/N;
A = 2*abs(Y(k))/N;
phi = rad2deg(angle(Y(k)));

% Nur Bereich bis 20 Hz
b = f <= 20;
f = f(b);
A = A(b);
phi = phi(b);

% Nur deutliche FFT-Peaks finden
df = f(2)-f(1);
[~,peaks] = findpeaks(A, ...
    'MinPeakProminence',0.1*max(A), ...
    'MinPeakDistance',round(3/df));

figure;

subplot(2,1,1)
plot(f,A)
ylabel('Amplitude')
grid on

subplot(2,1,2)
stem(f(peaks),phi(peaks),'filled')
ylim([-180 180])
xlabel('Frequenz [Hz]')
ylabel('Phase [°]')
grid on
